rc=124

### systemd-run Environment root marker
$ systemd-run --system --unit=active-systemd-transient-run-env --collect --wait --property=Type=oneshot --property=Environment=ACTIVE_SYSTEMD_TRANSIENT=/root/active_systemd_transient_root /bin/sh -c 'id > "$ACTIVE_SYSTEMD_TRANSIENT"'
