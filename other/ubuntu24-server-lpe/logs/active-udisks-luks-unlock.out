## root udev/systemd consumers for LUKS/dm metadata
### /usr/lib/udev/rules.d/60-persistent-storage.rules
   132	# probe filesystem metadata of disks
   133	KERNEL!="sr*|mmcblk[0-9]boot[0-9]", IMPORT{builtin}="blkid"
   134	
   135	LABEL="persistent_storage_blkid_probe_end"
   136	
