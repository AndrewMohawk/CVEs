## vulnerable-looking root udev/config lines
    44	# Loop device:
    45	LABEL="next"
    46	KERNEL!="loop[0-9]*", GOTO="next"
    47	ACTION=="add", ENV{LVM_LOOP_PV_ACTIVATED}=="1", GOTO="lvm_scan"
    48	ACTION=="change", ENV{LVM_LOOP_PV_ACTIVATED}!="1", TEST=="loop/backing_file", ENV{LVM_LOOP_PV_ACTIVATED}="1", GOTO="lvm_scan"
    49	ENV{LVM_LOOP_PV_ACTIVATED}!="1", ENV{SYSTEMD_READY}="0"
    50	GOTO="lvm_end"
    51	
    52	LABEL="next"
    53	ACTION!="add", GOTO="lvm_end"
    54	
    55	LABEL="lvm_scan"
    56	
    57	ENV{SYSTEMD_READY}="1"
    58	
    59	# pvscan will check if this device completes a VG,
    60	# i.e. all PVs in the VG are now present with the
    61	# arrival of this PV.  If so, it prints to stdout:
    62	# LVM_VG_NAME_COMPLETE='foo'
    63	#
    64	# When the VG is complete it can be activated, so
    65	# vgchange -aay <vgname> is run.  It is run via
    66	# systemd since it can take longer to run than
    67	# udev wants to block when processing rules.
    68	# (if there are hundreds of LVs to activate,
    69	# the vgchange can take many seconds.)
    70	#
    71	# pvscan only reads the single device specified,
    72	# and uses temp files under /run/lvm to check if
    73	# other PVs in the VG are present.
    74	#
    75	# If event_activation=0 in lvm.conf, this pvscan
    76	# (using checkcomplete) will do nothing, so that
    77	# no event-based autoactivation will be happen.
    78	#
    79	# TODO: adjust the output of vgchange -aay so that
    80	# it's better suited to appearing in the journal.
    81	
    82	IMPORT{program}="/usr/sbin/lvm pvscan --cache --listvg --checkcomplete --vgonline --autoactivation event --udevoutput --journal=output $env{DEVNAME}"
    83	TEST!="/run/systemd/system", GOTO="lvm_direct_vgchange"
    84	
    85	ENV{LVM_VG_NAME_COMPLETE}=="?*", RUN+="/usr/bin/systemd-run --no-block --property DefaultDependencies=no --unit lvm-activate-$env{LVM_VG_NAME_COMPLETE} /usr/sbin/lvm vgchange -aay --autoactivation event $env{LVM_VG_NAME_COMPLETE}"
    86	GOTO="lvm_end"
    87	
    88	LABEL="lvm_direct_vgchange"
    89	ENV{LVM_VG_NAME_COMPLETE}=="?*", RUN+="/usr/sbin/lvm vgchange -aay --autoactivation event $env{LVM_VG_NAME_COMPLETE}"
    90	GOTO="lvm_end"

