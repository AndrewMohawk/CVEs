## exact unit ExecStart/config paths
### xfs_scrub_all.timer
ActiveState=inactive
FragmentPath=/usr/lib/systemd/system/xfs_scrub_all.timer
UnitFileState=disabled
# /usr/lib/systemd/system/xfs_scrub_all.timer
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Copyright (C) 2018-2024 Oracle.  All Rights Reserved.
# Author: Darrick J. Wong <djwong@kernel.org>

[Unit]
Description=Periodic XFS Online Metadata Check for All Filesystems

[Timer]
# Run on Sunday at 3:10am, to avoid running afoul of DST changes
OnCalendar=Sun *-*-* 03:10:00
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
### xfs_scrub_all.service
ExecStart={ path=/usr/sbin/xfs_scrub_all ; argv[]=/usr/sbin/xfs_scrub_all ; ignore_errors=no ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
User=
Group=
ActiveState=inactive
FragmentPath=/usr/lib/systemd/system/xfs_scrub_all.service
UnitFileState=static
# /usr/lib/systemd/system/xfs_scrub_all.service
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Copyright (C) 2018-2024 Oracle.  All Rights Reserved.
# Author: Darrick J. Wong <djwong@kernel.org>

[Unit]
Description=Online XFS Metadata Check for All Filesystems
ConditionACPower=true
Documentation=man:xfs_scrub_all(8)
After=paths.target multi-user.target network.target network-online.target systemd-networkd.service NetworkManager.service connman.service

[Service]
Type=oneshot
Environment=SERVICE_MODE=1
ExecStart=/usr/sbin/xfs_scrub_all
SyslogIdentifier=xfs_scrub_all
### xfs_scrub@.service
Failed to get properties: Unit name xfs_scrub@.service is neither a valid invocation ID nor unit name.
# /usr/lib/systemd/system/xfs_scrub@.service
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Copyright (C) 2018-2024 Oracle.  All Rights Reserved.
# Author: Darrick J. Wong <djwong@kernel.org>

[Unit]
Description=Online XFS Metadata Check for %f
OnFailure=xfs_scrub_fail@%i.service
Documentation=man:xfs_scrub(8)

[Service]
Type=oneshot
PrivateNetwork=true
ProtectSystem=full
ProtectHome=read-only
# Disable private /tmp just in case %f is a path under /tmp.
PrivateTmp=no
AmbientCapabilities=CAP_SYS_ADMIN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_RAWIO
NoNewPrivileges=yes
User=nobody
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
Environment=SERVICE_MODE=1
ExecStart=/usr/sbin/xfs_scrub -b -n %f
SyslogIdentifier=%N
### xfs_scrub_fail@.service
Failed to get properties: Unit name xfs_scrub_fail@.service is neither a valid invocation ID nor unit name.
# /usr/lib/systemd/system/xfs_scrub_fail@.service
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Copyright (C) 2018-2024 Oracle.  All Rights Reserved.
# Author: Darrick J. Wong <djwong@kernel.org>

[Unit]
Description=Online XFS Metadata Check Failure Reporting for %f
Documentation=man:xfs_scrub(8)

[Service]
Type=oneshot
Environment=EMAIL_ADDR=root
ExecStart=/usr/libexec/xfsprogs/xfs_scrub_fail "${EMAIL_ADDR}" %f
User=mail
Group=mail
SupplementaryGroups=systemd-journal
### udisks2.service
ExecStart={ path=/usr/libexec/udisks2/udisksd ; argv[]=/usr/libexec/udisks2/udisksd ; ignore_errors=no ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
User=
Group=
ActiveState=active
FragmentPath=/usr/lib/systemd/system/udisks2.service
UnitFileState=enabled
# /usr/lib/systemd/system/udisks2.service
[Unit]
Description=Disk Manager
Documentation=man:udisks(8)

[Service]
Type=dbus
BusName=org.freedesktop.UDisks2
ExecStart=/usr/libexec/udisks2/udisksd
KillSignal=SIGINT

[Install]
WantedBy=graphical.target

