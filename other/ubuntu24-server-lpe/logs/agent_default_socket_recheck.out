     1	[Unit]
     2	Description=iSCSI initiator daemon (iscsid)
     3	Documentation=man:iscsid(8)
     4	Wants=network-online.target remote-fs-pre.target
     5	Before=remote-fs-pre.target
     6	After=network.target network-online.target
     7	DefaultDependencies=no
     8	Conflicts=shutdown.target
     9	Before=shutdown.target
    10	ConditionVirtualization=!private-users
    11	
    12	[Service]
    13	Type=forking
    14	PIDFile=/run/iscsid.pid
    15	ExecStartPre=/usr/lib/open-iscsi/startup-checks.sh
    16	ExecStart=/usr/sbin/iscsid
    17	
    18	[Install]
    19	WantedBy=sysinit.target
--- /usr/lib/systemd/system/open-iscsi.service
     1	[Unit]
     2	Description=Login to default iSCSI targets
     3	Documentation=man:iscsiadm(8) man:iscsid(8)
     4	Wants=network-online.target remote-fs-pre.target
     5	After=network-online.target iscsid.service
     6	Before=remote-fs-pre.target
     7	DefaultDependencies=no
     8	Conflicts=shutdown.target
     9	Before=shutdown.target
    10	# Must have some pre-defined targets to login to
    11	ConditionDirectoryNotEmpty=|/etc/iscsi/nodes
    12	# or have a session to use via iscsid
    13	ConditionDirectoryNotEmpty=|/sys/class/iscsi_session
    14	
    15	[Service]
    16	Type=oneshot
    17	RemainAfterExit=true
    18	# iscsiadm --login will return 21 if no nodes are configured,
    19	# and 15 if a session is alread logged in (which we do not
    20	# consider an error)
    21	SuccessExitStatus=15 21
    22	# Note: iscsid will be socket activated by iscsiadm
    23	ExecStart=/usr/sbin/iscsiadm -m node --loginall=automatic
    24	ExecStart=/usr/lib/open-iscsi/activate-storage.sh
    25	ExecStop=/usr/lib/open-iscsi/umountiscsi.sh
    26	ExecStop=/bin/sync
    27	ExecStop=/usr/lib/open-iscsi/logout-all.sh
    28	
    29	[Install]
    30	WantedBy=sysinit.target
    31	Alias=iscsi.service
--- /usr/lib/systemd/system/dm-event.socket
