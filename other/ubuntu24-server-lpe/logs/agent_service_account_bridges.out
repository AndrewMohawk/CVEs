     7	
     8	
     9	#################
    10	#### MODULES ####
    11	#################
    12	
    13	module(load="imuxsock") # provides support for local system logging
    14	#module(load="immark")  # provides --MARK-- message capability
    15	
    16	# provides UDP syslog reception
    17	#module(load="imudp")
