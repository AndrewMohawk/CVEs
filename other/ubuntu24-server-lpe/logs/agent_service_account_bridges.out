    24	# provides kernel logging support and enable non-kernel klog messages
    25	module(load="imklog" permitnonkernelfacility="on")
    26	
    27	###########################
    28	#### GLOBAL DIRECTIVES ####
    29	###########################
    30	
    31	# Filter duplicated messages
    32	$RepeatedMsgReduction on
