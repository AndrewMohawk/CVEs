    35	def process_report(report):
    36	    # TODO: Split into smaller functions/methods
    37	    # pylint: disable=too-many-branches,too-many-return-statements
    38	    # pylint: disable=too-many-statements
    39	    """Collect information for a report and mark for whoopsie upload
    40	
    41	    errors.ubuntu.com does not collect any hook data anyway, so we do not need
    42	    to bother collecting it.
    43	
    44	    Return path of upload stamp if report was successfully processed, or None
    45	    otherwise.
    46	    """
    47	    upload_stamp = f"{report.rsplit('.', 1)[0]}.upload"
    48	
    49	    # whoopsie-upload-all is only called if autoreporting of crashes is set,
    50	    # so its unlikely that systems with that set are interested in having the
    51	    # .crash file around. Additionally, having .crash files left over causes
    52	    # systemd's PathExistsGlob to be constantly triggered. See systemd issue
    53	    # #16669 and LP: #1891657 for some details.
    54	    uploaded_stamp = f"{upload_stamp}ed"
    55	    if os.path.exists(uploaded_stamp) and os.path.exists(report):
    56	        report_st = os.stat(report)
    57	        uploaded_st = os.stat(uploaded_stamp)
    58	        # if the crash file is new delete the uploaded file
    59	        if uploaded_st.st_mtime < report_st.st_mtime:
    60	            os.unlink(uploaded_stamp)
    61	            if os.path.exists(upload_stamp):
    62	                upload_st = os.stat(upload_stamp)
    63	                # also delete the upload file
    64	                if upload_st.st_mtime < report_st.st_mtime:
    65	                    os.unlink(upload_stamp)
    66	
    67	    if os.path.exists(upload_stamp):
    68	        logging.info("%s already marked for upload, skipping", report)
    69	        return upload_stamp
    70	
    71	    report_stat = None
    72	
    73	    r = apport.Report()
    74	    # make sure we're actually on the hook to write this updated report
    75	    # before we start doing expensive collection operations
    76	    try:
    77	        with open(report, "rb") as f:
    78	            try:
    79	                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    80	            except OSError:
    81	                logging.info("%s already being processed, skipping", report)
    82	                return None
    83	            r.load(f, binary="compressed")
    84	            report_stat = os.stat(report)
    85	    except (MalformedProblemReport, OSError, zlib.error) as error:
    86	        sys.stderr.write(f"ERROR: cannot load {report}: {str(error)}\n")
    87	        return None
    88	    if r.get("ProblemType", "") != "Crash" and "ExecutablePath" not in r:
    89	        logging.info("  skipping, not a crash")
    90	        return None
    91	    if "Dependencies" in r and r.get("_HooksRun") != "no":
    92	        logging.info("%s already has info collected", report)
    93	    else:
    94	        logging.info("Collecting info for %s...", report)
    95	        r.add_os_info()
    96	        try:
    97	            r.add_package_info()
    98	        except (SystemError, ValueError) as error:
    99	            sys.stderr.write(
   100	                f"ERROR: cannot add package info on {report}: {str(error)}\n"
   101	            )
   102	            return None
