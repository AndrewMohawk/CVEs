   329	def get_all_system_reports():
   330	    """Get all system reports.
   331	
   332	    Return a list with all report files which belong to a system user.
   333	    The maximum system user group ID is taken from SYS_UID_MAX from
   334	    /etc/login.defs (defaults to 999 on Debian based systems and LSB
   335	    specifies 499 in "User ID Ranges").
   336	    """
   337	    reports = []
   338	    sys_uid_max = get_sys_uid_max()
   339	    for r in glob.glob(os.path.join(report_dir, "*.crash")):
   340	        try:
   341	            st = os.stat(r)
   342	            if st.st_size > 0 and st.st_uid <= sys_uid_max:
   343	                # filter out guest session crashes;
   344	                # they might have a system UID
   345	                try:
   346	                    pw = pwd.getpwuid(st.st_uid)
   347	                    if pw.pw_name.startswith("guest"):
   348	                        continue
   349	                except KeyError:
   350	                    pass
   351	
   352	                reports.append(r)
   353	        except OSError:
   354	            # race condition, can happen if report disappears between glob and
   355	            # stat
   356	            pass
   357	    return reports
   358	
   359	
   360	def get_new_system_reports():
   361	    """Get new system reports.
   362	
   363	    Return a list with all report files which have not yet been processed
   364	    and belong to a system user. The maximum system user group ID is taken
   365	    from SYS_UID_MAX from /etc/login.defs (defaults to 999 on Debian based
   366	    systems and LSB specifies 499 in "User ID Ranges").
   367	    """
   368	    return [r for r in get_all_system_reports() if not seen_report(r)]
   404	def increment_crash_counter(report: ProblemReport, filename: str) -> None:
   405	    """Increment the crash counter if report was seen."""
   406	    if not seen_report(filename):
   407	        return
   408	    # Make sure the file isn't a FIFO or symlink
   409	    fd = os.open(filename, os.O_NOFOLLOW | os.O_RDONLY | os.O_NONBLOCK)
   410	    st = os.fstat(fd)
   411	    if stat.S_ISREG(st.st_mode):
   412	        with os.fdopen(fd, "rb") as f:
   413	            crash_counter = get_recent_crashes(f) + 1
   414	        report["CrashCounter"] = str(crash_counter)
