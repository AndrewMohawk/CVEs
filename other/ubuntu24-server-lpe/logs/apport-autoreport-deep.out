   227	def mark_report_seen(report):
   228	    """Mark given report file as seen."""
   229	    st = os.stat(report)
   230	    try:
   231	        os.utime(report, (st.st_mtime, st.st_mtime - 1))
   232	    except OSError:
   233	        # file is probably not our's, so do it the slow and boring way
   234	        # change the file's access time until it stat's different than the
   235	        # mtime. This might take a while if we only have 1-second resolution.
   297	def get_all_reports():
   298	    """Return a list with all report files accessible to the calling user."""
   299	    reports = []
   300	    for r in glob.glob(os.path.join(report_dir, "*.crash")):
   301	        try:
   302	            if os.path.getsize(r) > 0 and os.access(r, os.R_OK | os.W_OK):
   303	                reports.append(r)
   304	        except OSError:
   305	            # race condition, can happen if report disappears between glob and
   306	            # stat
   307	            pass
   308	    return reports
   309	
   310	
   311	def get_new_reports():
   312	    """Get new reports for calling user.
   313	
   314	    Return a list with all report files which have not yet been processed
   315	    and are accessible to the calling user.
   316	    """
   317	    reports = []
   318	    for r in get_all_reports():
   319	        try:
   320	            if not seen_report(r):
   321	                reports.append(r)
   322	        except OSError:
   323	            # race condition, can happen if report disappears between glob and
   324	            # stat
   325	            pass
   326	    return reports
