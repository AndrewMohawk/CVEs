   196	def main() -> None:
   197	    parser = argparse.ArgumentParser(
   198	        description="Noninteractively upload all "
   199	        "Apport crash reports to errors.ubuntu.com"
   200	    )
   201	    parser.add_argument(
   202	        "-t",
   203	        "--timeout",
   204	        default=0,
   205	        type=int,
   206	        help="seconds to wait for whoopsie to upload the reports"
   207	        " (default: do not wait)",
   208	    )
   209	    parser.add_argument("--loglevel", default="info", help="log level (default: info)")
   210	    opts = parser.parse_args()
   211	
   212	    numeric_level = getattr(logging, opts.loglevel.upper(), None)
   213	    if not isinstance(numeric_level, int):
   214	        raise ValueError(f"Invalid log level: {opts.loglevel}")
   215	    logging.basicConfig(level=numeric_level)
   216	
   217	    # verify that whoopsie.path is enabled
   218	    if (
   219	        subprocess.call(
   220	            ["/bin/systemctl", "--quiet", "is-enabled", "whoopsie.path"],
   221	            stdout=subprocess.PIPE,
   222	        )
   223	        != 0
   224	    ):
   225	        logging.info("whoopsie.path is not enabled, doing nothing")
   226	        return
   227	
   228	    stamps = collect_info()
   229	    # print('stamps:', stamps)
   230	    if stamps:
   231	        # Touch the directory that is monitored by whoopsie.path so that
   232	        # whoopsie.service can activate. Ideally, this directory and the one
   233	        # that apport-autoreport.path monitors would be different but they are
   234	        # the same currently.
   235	        os.utime(apport.fileutils.report_dir)
   236	
   237	        if opts.timeout > 0:
   238	            if not wait_uploaded(stamps, opts.timeout):
   239	                sys.exit(2)
   240	            logging.info("All reports uploaded successfully")
   241	        else:
   242	            logging.info("All reports processed")
   243	
