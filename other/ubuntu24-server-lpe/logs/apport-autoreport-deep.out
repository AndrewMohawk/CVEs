   201	def mark_report_upload(report):
   202	    upload = f"{report.rsplit('.', 1)[0]}.upload"
   203	    uploaded = f"{report.rsplit('.', 1)[0]}.uploaded"
   204	    # if uploaded exists and is older than the report remove it and upload
   205	    if os.path.exists(uploaded) and os.path.exists(upload):
   206	        report_st = os.stat(report)
   207	        upload_st = os.stat(upload)
   208	        if upload_st.st_mtime < report_st.st_mtime:
   209	            os.unlink(upload)
   210	    with open(upload, "a", encoding="utf-8"):
   211	        pass
