   174	
   175	def get_pid_info(proc_pid: ProcPid) -> tuple[UserGroupID, os.stat_result]:
   176	    """Read /proc information about pid"""
   177	    # unhandled exceptions on missing or invalidly formatted files are okay
   178	    # here -- we want to know in the log file
   179	    pidstat = os.stat("stat", dir_fd=proc_pid.fd)
   180	
   181	    # determine UID and GID of the target process; do *not* use the owner of
   182	    # /proc/pid/stat, as that will be root for setuid or unreadable programs!
   183	    # (this matters when suid_dumpable is enabled)
   184	    with proc_pid.open("status") as status_file:
   185	        contents = status_file.read()
   186	    (real_uid, real_gid) = apport.fileutils.get_uid_and_gid(contents)
   187	
   188	    assert real_uid is not None, "failed to parse Uid"
   189	    assert real_gid is not None, "failed to parse Gid"
   190	    return UserGroupID(real_uid, real_gid), pidstat
   191	
