   169	def wait_uploaded(stamps, timeout):
   170	    """Wait until all reports were uploaded.
   171	
   172	    Times out after a given number of seconds.
   173	
   174	    Return True if all reports were uploaded, False if there are some missing.
   175	    """
   176	    logging.info("Waiting for whoopsie to upload reports (timeout: %d s)", timeout)
   177	
   178	    while timeout >= 0:
   179	        # determine missing stamps
   180	        missing = ""
   181	        for stamp in stamps:
   182	            uploaded = f"{stamp}ed"
   183	            if os.path.exists(stamp) and not os.path.exists(uploaded):
   184	                missing += f"{uploaded} "
   185	        if not missing:
   186	            return True
   187	
   188	        logging.info("  missing (remaining: %d s): %s", timeout, missing)
   189	        time.sleep(10)
   190	        timeout -= 10
   191	
   192	    return False
   193	
