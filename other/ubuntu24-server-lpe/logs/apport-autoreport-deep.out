   417	def make_report_file(report, uid=None):
   418	    """Construct a canonical pathname for a report and open it for writing.
   419	
   420	    If uid is not given, it defaults to the effective uid of the current
   421	    process. The report file must not exist already, to prevent losing
   422	    previous reports or symlink attacks.
   423	
   424	    Return an open file object for binary writing.
   425	    """
   426	    if "ExecutablePath" in report:
   427	        subject = report["ExecutablePath"].replace("/", "_")
   428	    elif "Package" in report:
   429	        subject = report["Package"].split(None, 1)[0]
   430	    else:
   431	        raise ValueError("report has neither ExecutablePath nor Package attribute")
   432	
   433	    if not uid:
   434	        uid = os.geteuid()
   435	
   436	    path = os.path.join(report_dir, f"{subject}.{str(uid)}.crash")
   437	    return open(path, "xb")
--- apport crash privilege transitions ---
   130	def check_lock():
   131	    """Abort if another instance of apport is already running.
   132	
   133	    This avoids bringing down the system to its knees if there is a series of
   134	    crashes."""
   135	    logger = logging.getLogger()
   136	
   137	    # create a lock file
   138	    try:
   139	        fd = os.open(
   140	            os.environ.get("APPORT_LOCK_FILE", "/var/run/apport.lock"),
   141	            os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW,
   142	            mode=0o600,
   143	        )
   144	    except OSError as error:
   145	        logger.error("cannot create lock file (uid %i): %s", os.getuid(), str(error))
   146	        sys.exit(1)
   147	
   148	    def error_running(*_unused_args):
   149	        logger.error("another apport instance is already running, aborting")
   150	        sys.exit(1)
   151	
   152	    original_handler = signal.signal(signal.SIGALRM, error_running)
   153	    signal.alarm(30)  # Timeout after that many seconds
   154	    try:
   155	        fcntl.lockf(fd, fcntl.LOCK_EX)
   156	    except OSError:
   157	        error_running()
   158	    finally:
   159	        signal.alarm(0)
   160	        signal.signal(signal.SIGALRM, original_handler)
