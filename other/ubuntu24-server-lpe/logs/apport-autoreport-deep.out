   163	def get_core_path(
   164	    options: argparse.Namespace,
   165	    real_user: UserGroupID,
   166	    proc_pid: ProcPid,
   167	    timestamp: int | None = None,
   168	) -> str:
   169	    """Get the path to the core file."""
   170	    return apport.fileutils.get_core_path(
   171	        proc_pid.pid, options.executable_path, real_user.uid, timestamp, proc_pid.fd
   172	    )[1]
