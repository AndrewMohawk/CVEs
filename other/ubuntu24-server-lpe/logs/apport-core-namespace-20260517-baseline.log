   666	                arg[0].startswith("--file")
   667	                or arg[0].startswith("--python")
   668	                or arg[0].startswith("--source")
   669	            ):
   670	                if len(arg) == 2:
   671	                    return arg[1]
   672	                return args[1]
   673	            if len(arg[0]) > 1 and arg[0][0] == "-" and arg[0][1] != "-":
   674	                opts = arg[0][1:]
   675	                if "f" in opts or "y" in opts or "s" in opts:
   676	                    return args[1]
   677	
   678	            args.pop(0)
   679	
   680	        return None
