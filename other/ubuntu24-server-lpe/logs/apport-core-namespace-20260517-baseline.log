   417	def make_report_file(report, uid=None):
   418	    """Construct a canonical pathname for a report and open it for writing.
   419	
   420	    If uid is not given, it defaults to the effective uid of the current
   421	    process. The report file must not exist already, to prevent losing
   422	    previous reports or symlink attacks.
   423	
   424	    Return an open file object for binary writing.
   425	    """
   426	    if "ExecutablePath" in report:
   427	        subject = report["ExecutablePath"].replace("/", "_")
   428	    elif "Package" in report:
   429	        subject = report["Package"].split(None, 1)[0]
   430	    else:
   431	        raise ValueError("report has neither ExecutablePath nor Package attribute")
   432	
   433	    if not uid:
   434	        uid = os.geteuid()
   435	
   436	    path = os.path.join(report_dir, f"{subject}.{str(uid)}.crash")
   437	    return open(path, "xb")
