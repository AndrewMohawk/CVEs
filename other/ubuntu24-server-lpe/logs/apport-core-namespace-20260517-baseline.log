   658	    def _twistd_executable(self) -> str | None:
   659	        """Determine the twistd client program from ProcCmdline."""
   660	        args = self["ProcCmdline"].split("\0")[2:]
   661	
   662	        # search for a -f/--file, -y/--python or -s/--source argument
