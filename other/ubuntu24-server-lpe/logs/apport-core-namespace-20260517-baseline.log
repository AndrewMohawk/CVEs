   404	def increment_crash_counter(report: ProblemReport, filename: str) -> None:
   405	    """Increment the crash counter if report was seen."""
   406	    if not seen_report(filename):
   407	        return
   408	    # Make sure the file isn't a FIFO or symlink
   409	    fd = os.open(filename, os.O_NOFOLLOW | os.O_RDONLY | os.O_NONBLOCK)
   410	    st = os.fstat(fd)
   411	    if stat.S_ISREG(st.st_mode):
   412	        with os.fdopen(fd, "rb") as f:
   413	            crash_counter = get_recent_crashes(f) + 1
   414	        report["CrashCounter"] = str(crash_counter)
