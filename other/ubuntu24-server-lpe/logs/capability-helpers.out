#!/bin/sh
{
  echo PAYLOAD_RAN
  id
  grep -E '^(Uid|Gid|Cap(Inh|Prm|Eff|Bnd|Amb))' /proc/self/status
  /bin/sh -p -c 'id' 2>&1
} > '/tmp/capability-helpers-probe/payload.out'
EOF
chmod +x '/tmp/capability-helpers-probe/payload.sh'
cat > '/tmp/capability-helpers-probe/bin/snap-update-ns' <<'EOF'
#!/bin/sh
echo FAKE_UPDATE_NS_RAN > '/tmp/capability-helpers-probe/fake-update-ns.out'
exit 0
EOF
chmod +x '/tmp/capability-helpers-probe/bin/snap-update-ns'
ln -s '/tmp/capability-helpers-probe/private-target' /tmp/snap-private-tmp 2>/dev/null || true
