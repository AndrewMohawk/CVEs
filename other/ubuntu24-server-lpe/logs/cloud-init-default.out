    64		return 0
    65	}
    66	
    67	cleanup() {
    68		if [ -n "${RESTORE_FUNC}" ]; then
    69			error "***** WARNING: Resize failed, attempting to revert ******"
    70			if ${RESTORE_FUNC} ; then
    71				error "***** Restore appears to have gone OK ****"
    72			else
    73				error "***** Restore FAILED! ******"
    74				if [ -n "${RESTORE_HUMAN}" -a -f "${RESTORE_HUMAN}" ]; then
    75					error "**** original table looked like: ****"
    76					cat "${RESTORE_HUMAN}" 1>&2
    77				else
    78					error "We seem to have not saved the partition table!"
    79				fi
    80			fi
    81			unlock_disk_and_settle $DISK
    82		fi
    83		[ -z "${TEMP_D}" -o ! -d "${TEMP_D}" ] || rm -Rf "${TEMP_D}"
    84	}
    85	
    86	debug() {
    87		local level=${1}
    88		shift
    89		[ "${level}" -gt "${VERBOSITY}" ] && return
    90		if [ "${DEBUG_LOG}" ]; then
    91			echo "$@" >>"${DEBUG_LOG}"
    92		else
    93			error "$@"
    94		fi
    95	}
    96	
    97	debugcat() {
    98		local level="$1"
    99		shift;
   100		[ "${level}" -gt "$VERBOSITY" ] && return
   101		if [ "${DEBUG_LOG}" ]; then
   102			cat "$@" >>"${DEBUG_LOG}"
   103		else
   104			cat "$@" 1>&2
   105		fi
   106	}
   107	
   108	mktemp_d() {
   109		# just a mktemp -d that doens't need mktemp if its not there.
   110		_RET=$(mktemp -d "${TMPDIR:-/tmp}/${0##*/}.XXXXXX" 2>/dev/null) &&
   111			return
   112		_RET=$(umask 077 && t="${TMPDIR:-/tmp}/${0##*/}.$$" &&
   113			mkdir "${t}" &&	echo "${t}")
   114		return
   115	}
   116	
   117	Usage() {
   118		cat <<EOF
   119	${0##*/} disk partition
   120	   rewrite partition table so that partition takes up all the space it can
   121	   options:
   122	    -h | --help            print Usage and exit
   123	         --free-percent F  resize so that specified percentage F of the disk is
   124	                           not used in total (not just by this partition). This
   125	                           is useful for consumer SSD or SD cards where a small
   126	                           percentage unallocated can improve device lifetime.
   127	         --fudge F         if part could be resized, but change would be less
   128	                           than 'F' bytes, do not resize (default: ${FUDGE})
   129	    -N | --dry-run         only report what would be done, show new 'sfdisk -d'
   130	    -v | --verbose         increase verbosity / debug
   131	    -u | --update  R       update the the kernel partition table info after
   132	                           growing this requires kernel support and
   133	                           'partx --update'
   134	                           R is one of:
   135	                            - 'auto'  : [default] update partition if possible
   136	                            - 'force' : try despite sanity checks (fail on
   137	                                        failure)
   138	                            - 'off'   : do not attempt
   139	                            - 'on'    : fail if sanity checks indicate no
   140	                                        support
   141	
   142	   Example:
   143	    - ${0##*/} /dev/sda 1
   144	      Resize partition 1 on /dev/sda
   145	
   146	    - ${0##*/} --free-percent=10 /dev/sda 1
   147	      Resize partition 1 on /dev/sda so that 10% of the disk is unallocated
   148	EOF
   149	}
   150	
   151	bad_Usage() {
   152		Usage 1>&2
   153		error "$@"
   154		exit 2
   155	}
   156	
   157	lock_disk() {
   158		local disk="$1"
   159		# flock the target disk to protect against udev actions while modifying.
   160		# https://systemd.io/BLOCK_DEVICE_LOCKING/
   161		[ "${DRY_RUN}" = 0 ] || return
   162	
   163		# only lock block devices, files do not need a lock
   164		[ -b "${disk}" ] || return
   165	
   166		# The FD values are hard-coded per /bin/sh requirement for using exec
   167		# to open paths with specific fd values; man (1) sh on "Redirections"
   168		FLOCK_DISK_FD=9
   169		debug 1 "FLOCK: try exec open fd 9, on failure exec exits this program"
   170		exec 9<>$disk
   171	
   172		# Do not use --nonblock or --timeout as udev may be already processing
   173		# the disk and we must wait until it has released the disk to
   174		# proceed.  Failure to obtain exclusive lock is fatal to growpart.
   175		rq flock flock -x $FLOCK_DISK_FD ||
   176			fail "Error while obtaining exclusive lock on $DISK"
   177		debug 1 "FLOCK: $disk: obtained exclusive lock"
   178	}
   179	
   180	unlock_disk_and_settle() {
   181		# unlock_disk(disk, settle)
   182		local disk="$1"
   183		local settle=${2-"1"}
   184		# release the lock on a disk if locked.  When a disk is locked,
   185		# FLOCK_DISK_FD is set to the hard-coded value of 9.
   186		# After unlocking run udevadm settle (if installed) as the disk has
   187		# likely been changed.
   188		[ "${DRY_RUN}" = 0 ] || return
   189		[ -n "${FLOCK_DISK_FD}" ] || return
   190	
   191		debug 1 "FLOCK: ${disk}: releasing exclusive lock"
   192		exec 9>&-
   193		[ "${settle}" = 1 ] && has_cmd udevadm && udevadm settle
   194		FLOCK_DISK_FD=""
   195	}
   196	
   197	sfdisk_restore_legacy() {
   198		sfdisk --no-reread "${DISK}" -I "${MBR_BACKUP}"
   199	}
   200	
   201	sfdisk_restore() {
   202		# files are named: sfdisk-<device>-<offset>.bak
   203		local f="" offset="" fails=0
   204		for f in "${MBR_BACKUP}"*.bak; do
   205			[ -f "$f" ] || continue
   206			offset=${f##*-}
   207			offset=${offset%.bak}
   208			[ "$offset" = "$f" ] && {
   209				error "WARN: confused by file $f";
   210				continue;
   211			}
   212			dd "if=$f" "of=${DISK}" seek=$(($offset)) bs=1 conv=notrunc ||
   213				{ error "WARN: failed restore from $f"; fails=$(($fails+1)); }
   214		done
   215		return $fails
   216	}
   217	
   218	sfdisk_worked_but_blkrrpart_failed() {
   219		local ret="$1" output="$2"
   220		# exit code found was just 1, but dont insist on that
   221		#[ $ret -eq 1 ] || return 1
   222		# Successfully wrote the new partition table
   223		if grep -qi "Success.* wrote.* new.* partition" "$output"; then
   224			grep -qi "BLKRRPART: Device or resource busy" "$output"
   225			return
   226		# The partition table has been altered.
   227		elif grep -qi "The.* part.* table.* has.* been.* altered" "$output"; then
   228			# Re-reading the partition table failed
   229			grep -qi "Re-reading.* partition.* table.* failed" "$output"
   230			return
   231		fi
   232		return $ret
   233	}
   234	
   235	get_sfdisk_version() {
   236		# set SFDISK_VERSION to MAJOR*10000+MINOR*100+MICRO
   237		local out oifs="$IFS" ver=""
   238		[ -n "$SFDISK_VERSION" ] && return 0
   239		[ -n "$SFDISK" ] || {
   240			SFDISK_VERSION=0

