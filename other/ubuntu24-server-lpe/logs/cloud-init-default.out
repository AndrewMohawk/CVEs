    11	[ "$1" = "prereqs" ] && { prereqs; exit; }
    12	
    13	. /usr/share/initramfs-tools/hook-functions
    14	
    15	# vi: ts=4 noexpandtab

### /usr/share/initramfs-tools/scripts/init-premount/cloud-initramfs-dyn-netconf
     1	#!/bin/sh
     2	set -e
     3	set -f
     4	
     5	PREREQS="udev"
     6	case $1 in
     7		prereqs) echo "${PREREQS}"; exit 0;;
     8	esac
     9	
    10	. /scripts/functions
    11	
    12	PATH=/usr/sbin:/usr/bin:/sbin:/bin
    13	
    14	error() { echo "${0##*/}:" "$@" 1>&2; }
    15	fail() { [ $# -eq 0 ] || error "$@"; exit 0; }
    16	## this function ins taken and cleaned from configure_networking
    17	find_nic_by_mac() {
    18			# look for devices with matching mac address, and set RET if found.
    19			local mac="$1" curmac="" device="" found=""
    20			case "$mac" in
    21				*[A-Z]*) mac=$(echo "$mac" | awk '{print(tolower($0))}')
    22			esac
    23			set +f
    24			for device in /sys/class/net/* ; do
    25				[ -f "$device/address" ] || continue
    26				read curmac < "$device/address" || continue
    27				[ "$curmac" = "$mac" ] && found="${device##*/}" && break
    28			done
    29			set -f
    30			[ -n "$found" ] && _RET=$found && return 0
    31			return 1
    32	}
    33	
    34	bootif2macaddr() {
    35		# bootif is specified as BOOTIF=01-${mac_address} with '-' rather than ':'
    36		local input="$1" tok oifs="$IFS"
    37		input=${input#??-}
    38		IFS="-"
    39		_RET=""
    40		for tok in $input; do
    41			_RET="${_RET}:${tok}"
    42		done
    43		IFS="$oifs"
    44		_RET=${_RET#:}
    45	}
    46	
    47	nic2bootif() {
    48		local nic="$1" macaddr="" tok="" oifs="$IFS"
    49		[ -f "/sys/class/net/$nic/address" ] || return 1
    50		read macaddr < "/sys/class/net/$nic/address"
    51		IFS=":"
    52		_RET="01"
    53		for tok in $macaddr; do
    54			_RET="${_RET}-${tok}"
    55		done
    56		IFS="$oifs"
    57	}
    58	
    59	read CMDLINE < /proc/cmdline
    60	
    61	# if BOOTIF_DEFAULT was present on the kernel cmdline, but no BOOTIF was
    62	# provided then we set BOOTIF based on the network device *name* in
    63	# BOOTIF_DEFAULT (BOOTIF_DEFAULT=eth0).  This allows a pxe boot implementation
    64	# without the ability or knowledge to specify IPAPPEND to function.
    65	bootif_new=""
    66	if [ -z "$BOOTIF" ]; then
    67		for tok in $CMDLINE; do
    68			case "$tok" in
    69				BOOTIF_DEFAULT=*)
    70					wait_for_udev 10
    71					nic2bootif "${tok#BOOTIF_DEFAULT=}" || {
    72						echo "WARNING: ${0##*/}: no device $tok"
    73						continue
    74					}
    75					BOOTIF=${_RET}
    76					bootif_new=${BOOTIF}
    77					;;
    78			esac
    79		done
    80	fi
    81	
    82	# if hostname= is on the cmdline and IP=="dhcp", then change IP to
    83	#    ::::$hostname:BOOTIF:dhcp
    84	# This allows old code that specified 'ip=dhcp' to still convince ipconfig to
    85	# use a given hostname in dhcp request without requiring '::::$hostname:'.
    86	# The '::::$hostname:' without a device name means "wait for all network
    87	# devices".  If some are not plugged in, then it will hang for quite some time.
    88	#
    89	# This is really a specific kludge to deal with newer maas needing to operating
    90	# with existing original images from 12.04.  Those images were not able to
    91	# accept 'ip::::$hostname:BOOTIF' as they did not have this package installed.
    92	if [ -n "$BOOTIF" -a "$IP" = "dhcp" ]; then
    93		for tok in $CMDLINE; do
    94			case "$tok" in
    95				hostname=*) IP="::::${tok#hostname=}:BOOTIF:dhcp"
    96			esac
    97		done
    98	fi
    99	
   100	# no IP or IP not containing BOOTIF means nothing to do
   101	case $IP in
   102		*BOOTIF*) :;;
   103		*) exit 0
   104	esac
   105	
   106	[ -n "$BOOTIF" ] || fail "WARNING: IP='$IP' but no BOOTIF set!"
   107	
   108	## we need to "fix" an IP= string that contains 'BOOTIF'
   109	## to instead reference the actual interface.
   110	wait_for_udev 10
   111	
   112	bootif2macaddr "$BOOTIF" && [ -n "$_RET" ] ||
   113		fail "failed to convert BOOTIF='$BOOTIF'";
   114	macaddr=${_RET}
   115	
   116	find_nic_by_mac "$macaddr" && [ -n "$_RET" ] ||
   117		fail "did no find a nic with $macaddr"
   118	devname=${_RET}
   119	
   120	# now replace occurences of BOOTIF in $IP with $devname
   121	cur="$IP"
   122	while [ "${cur#*BOOTIF}" != "$cur" ]; do
   123	   cur="${cur%%BOOTIF*}$devname${cur#*BOOTIF}"
   124	done
   125	new=$cur
   126	
   127	# get the global variables IP and BOOTIF reset with updated values
   128	{
   129		echo "IP='$new'"
   130		[ -z "$bootif_new" ] || echo "BOOTIF='${bootif_new}'"
   131	} > /conf/param.conf
   132	
   133	# vi: ts=4 noexpandtab

### /usr/share/initramfs-tools/scripts/init-bottom/cloud-initramfs-dyn-netconf
     1	#!/bin/sh
     2	set -e
     3	
     4	PREREQS=""
     5	case $1 in
     6		prereqs) echo "${PREREQS}"; exit 0;;
     7	esac
     8	
     9	. /scripts/functions
    10	
    11	PATH=/usr/sbin:/usr/bin:/sbin:/bin
    12	
    13	# doc in klibc-utils /usr/share/doc/libklibc/README.ipconfig.gz
    14	# example below:
    15	#DEVICE='eth0'
    16	#PROTO='dhcp'                    ## none, off, static. not present in precise
    17	#IPV4ADDR='192.168.122.89'
    18	#IPV4BROADCAST='192.168.122.255'
    19	#IPV4NETMASK='255.255.255.0'
    20	#IPV4GATEWAY='192.168.122.1'
    21	#IPV4DNS0='192.168.122.1'        ## only come from dhcp
    22	#IPV4DNS1='0.0.0.0'
    23	#HOSTNAME=''
    24	#DNSDOMAIN=''
    25	#NISDOMAIN=''
    26	#ROOTSERVER='192.168.122.1'
    27	#ROOTPATH=''
    28	#filename=''
    29	#UPTIME='21'
    30	#DHCPLEASETIME='3600'
    31	#DOMAINSEARCH=''
    32	
    33	# superseded by isc-dhcp and such writing the file and supporting IPv6:
    34	#DEVICE=eno1
    35	#HOSTNAME=
    36	#DNSDOMAIN=
    37	#reason='PREINIT'
    38	#interface='eno1'
    39	#DEVICE=eno1
    40	#HOSTNAME=
    41	#DNSDOMAIN=
    42	#reason='FAIL'
    43	#interface='eno1'
    44	#DEVICE=eno1
    45	#HOSTNAME=
    46	#DNSDOMAIN=
    47	#reason='PREINIT6'
    48	#interface='eno1'
    49	#DEVICE=eno1
    50	#IPV6PROTO=dhcp6
    51	#IPV6ADDR=2001:67c:1562:8010:1::4324
    52	#IPV6NETMASK=64
    53	#IPV6DNS0=2001:67c:1562:8010::2:1
    54	#IPV6DOMAINSEARCH=
    55	#HOSTNAME=
    56	#DNSDOMAIN=
    57	#reason='BOUND6'
    58	#interface='eno1'
    59	#new_ip6_address='2001:67c:1562:8010:1::4324'
    60	#new_ip6_prefixlen='64'
    61	#new_dhcp6_name_servers='2001:67c:1562:8010::2:1'
    62	
    63	
    64	error() { echo "${0##*/}:" "$@" 1>&2; }
    65	configure_net_if_needed() {
    66		# we want to call configure_networking if and only if ip= was seen
    67		# on the command line (LP: #1463846)
    68		local ip="$1"
    69		# empty 'ip' or ip=none or ip=off specifically mean do not bring up
    70		if [ -z "$ip" ]; then
    71			return 0
    72		fi
    73		case "$ip" in
    74			none|off) return 0;;
    75		esac
    76		# configure_networking does not set any flags indicating it tried
    77		# to run and failed, so we can only look for indication
    78		# that ipconfig ran, which creates files in /run/net-<device>.conf
    79		#
    80		# configure_networking does a check like this.  however, its check is
    81		# broken in the event that BOOTIF is not found on the command line.
    82		for f in /run/net-*.conf /tmp/net-*.conf; do
    83			if [ -f "$f" ]; then
    84				return 0
    85			fi
    86		done
    87	
    88		configure_networking
    89	}
    90	
    91	ni_header() {
    92		echo "## This file is generated by cloud-initramfs-dyn-netconf"
    93		echo "auto lo"
    94		echo "iface lo inet loopback"
    95	}
    96	
    97	
    98	configure_net_if_needed "$IP" ||
    99	   echo "WARN: ${0##*/}: configure_networking failed" 1>&2
   100	
   101	tmpf="/tmp/${0##*/}.ni"
   102	
   103	ni_header > "$tmpf"
   104	seen=","
   105	for f in /run/net-*.conf /tmp/net-*.conf /run/net6-*.conf; do
   106		[ -f "$f" ] || continue
   107		dev=${f#*/net-}; dev=${dev%.conf};
   108		# perhaps we saw this device from /run and now we're in /tmp
   109		[ "${seen#*,${dev},}" = "${seen}" ] || continue
   110	
   111		seen="${seen}${dev},"
   112	
   113		DEVICE=""; PROTO=""; IPV4ADDR=""; IPV4NETMASK=""; IPV4GATEWAY="";
   114		IPV4DNS0=""; IPV4DNS1=""; DNSDOMAIN=""; DOMAINSEARCH=""; filename="";
   115		DEVICE6=""; IPV4PROTO=""; IPV6PROTO=""; IPV6ADDR=""; IPV6NETMASK="";
   116		IPV6GATEWAY=""; IPV6DNS0=""; IPV6DNS1=""; IPV6DOMAINSEARCH="";
   117		. "$f"
   118	
   119		if [ -z "$DEVICE" ]; then
   120			if [ -z "$DEVICE6" ]; then
   121			    error "WARNING: $f had no 'DEVICE' or 'DEVICE6' set"
   122			    continue
   123			else
   124			    DEVICE="$DEVICE6"
   125			fi
   126		fi
   127		# If IPv6 is supported, we get both of these, and at least one of them
   128		# is set.  If we get both, use IPv4.
   129		# Prior to that, PROTO was used, so we know it's IPv4 we want.
   130		if [ -z "$IPV4PROTO" -a -z "$IPV6PROTO" ]; then
   131			IPV4PROTO="$PROTO"
   132		fi
   133		# ipconfig on precise does not write PROTO.
   134		if [ -z "$IPV4PROTO" -a -z "$IPV6PROTO" ]; then
   135			if [ -n "$filename" ]; then
   136				IPV4PROTO="dhcp"
   137			else
   138				IPV4PROTO="static"
   139			fi
   140		fi
   141	
   142		# We need to use care, since the script is running set -e.
   143		echo "manual $DEVICE"
   144		if [ "$IPV4PROTO" = "dhcp" ]; then
   145			echo "iface $DEVICE inet dhcp"
   146		elif [ "$IPV4PROTO" = "static" ]; then
   147			echo "iface $DEVICE inet static"
   148			if [ -n "$IPV4ADDR" ]; then
   149				printf "\t%s\n" "address $IPV4ADDR"
   150			else
   151				error "WARNING: $f static with no address"
   152			fi
   153			if [ -n "$IPV4NETMASK" ]; then
   154				printf "\t%s\n" "netmask $IPV4NETMASK"
   155			else
   156				error "WARNING: $f static with no netmask"
   157			fi
   158			if [ -n "$IPV4GATEWAY" ]; then
   159				printf "\t%s\n" "gateway $IPV4GATEWAY"
   160			fi
   161		elif [ "$IPV6PROTO" = "dhcp6" ]; then
   162			echo "iface $DEVICE inet6 dhcp"
   163		elif [ "$IPV6PROTO" = "static" ]; then
   164			echo "iface $DEVICE inet6 static"
   165			if [ -n "$IPV6ADDR" ]; then
   166				printf "\t%s\n" "address $IPV6ADDR"
   167			else
   168				error "WARNING: $f static with no address"
   169			fi
   170			if [ -n "$IPV6NETMASK" ]; then
   171				printf "\t%s\n" "netmask $IPV6NETMASK"
   172			else
   173				error "WARNING: $f static with no netmask"
   174			fi
   175			if [ -n "$IPV6GATEWAY" ]; then
   176				printf "\t%s\n" "gateway $IPV6GATEWAY"
   177			fi
   178		fi
   179	
   180		nsline=""
   181		if [ -n "$IPV4DNS0" -a "$IPV4DNS0" != "0.0.0.0" ]; then
   182			nsline="${IPV4DNS0}"
   183			if [ -n "$IPV4DNS1" -a "$IPV4DNS1" = "0.0.0.0" ]; then
   184				nsline="${nsline} ${IPV4DNS1}"
   185			fi
   186		elif [ -n "$IPV6DNS0" ]; then
   187			nsline="${nsline} ${IPV6DNS0}"
   188			[ -z "$IPV6DNS1" ] || nsline="${nsline} ${IPV6DNS1}"
   189		fi
   190		[ -z "$nsline" ] || printf "\tdns-nameservers %s\n" "$nsline"
   191		if [ -n "${DNSDOMAIN}${DOMAINSEARCH}${IPV6DOMAINSEARCH}" ]; then
   192			SEARCH=" ${DNSDOMAIN} ${DOMAINSEARCH} ${IPV6DOMAINSEARCH}"
   193			printf "\tdns-search %s\n" "${SEARCH}"
   194		fi
   195	done >> "$tmpf"
   196	
   197	[ -d /run/network ] || mkdir /run/network
   198	mv "$tmpf" /run/network/dynamic-interfaces
   199	
   200	# vi: ts=4 noexpandtab

### /usr/share/initramfs-tools/scripts/init-bottom/copymods
     1	#!/bin/sh
     2	#  Copyright, 2014 Scott Moser <smoser@ubuntu.com>
     3	#
     4	#  This program is free software: you can redistribute it and/or modify
     5	#  it under the terms of the GNU General Public License as published by
     6	#  the Free Software Foundation, either version 3 of the License, or
     7	#  (at your option) any later version.
     8	#
     9	#  This program is distributed in the hope that it will be useful,
    10	#  but WITHOUT ANY WARRANTY; without even the implied warranty of
    11	#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    12	#  GNU General Public License for more details.
    13	#
    14	#    You should have received a copy of the GNU General Public License
    15	#    along with this program.  If not, see
    16	#    <http://www.gnu.org/licenses/>.
    17	
    18	prereqs() {
    19		local o="/scripts/init-bottom/overlayroot"  p=""
    20		# basically we run after overlayroot but do not depend on it
    21		for p in "$DESTDIR/" ""; do
    22			[ -e "$p$o" ] && echo "overlayroot" && return 0
    23		done
    24	}
    25	
    26	[ "$1" != "prereqs" ] || { prereqs; exit; }
    27	
    28	. /scripts/functions
    29	
    30	set -f
    31	PATH=/usr/sbin:/usr/bin:/sbin:/bin
    32	
    33	cmdline=""
    34	myopts=""
    35	if [ -f /proc/cmdline ]; then
    36		read cmdline < /proc/cmdline
    37		for tok in $cmdline; do
    38			[ "${tok#copymods=}" != "$tok" ] || continue
    39			myopts="${tok#copymods=}"
    40		done
    41	fi
    42	myver=$(uname -r)
    43	
    44	if [ ! -d "/lib/modules/$myver" ]; then
    45		log_warning_msg "Something odd, no /lib/modules/$myver in initramfs."
    46		exit 0
    47	fi
    48	
    49	[ -d "$rootmnt/lib/modules" ] || mkdir -p "$rootmnt/lib/modules" ||
    50		{ log_warning_msg "No /lib/modules in target. cannot help."; exit 0; }
    51	
    52	if [ -d "$rootmnt/lib/modules/$myver" ]; then
    53		if [ "${myopts#*force}" = "$myopts" ]; then
    54			exit 0
    55		else
    56			log_warning_msg "copying over existing modules! due to copymods=force"
    57		fi
    58	fi
    59	
    60	mount -t tmpfs copymods "$rootmnt/lib/modules" ||
    61		{ log_failure_msg "failed mount of tmpfs"; exit 0; }
    62	
    63	mv "/lib/modules/$myver" "$rootmnt/lib/modules" ||
    64		{ log_failure_msg "failed to copy modules to target root"; exit 0; }
    65	
    66	ln -s "$rootmnt/lib/modules/$myver" "/lib/modules/$myver" ||
    67		{ log_failure_msg "failed to link to modules"; exit 0; }
    68	
    69	# vi: ts=4 noexpandtab

### growpart command/path-sensitive lines
	if [ "${DEBUG_LOG}" ]; then
		echo "$@" >>"${DEBUG_LOG}"
	if [ "${DEBUG_LOG}" ]; then
		cat "$@" >>"${DEBUG_LOG}"
mktemp_d() {
	# just a mktemp -d that doens't need mktemp if its not there.
	_RET=$(mktemp -d "${TMPDIR:-/tmp}/${0##*/}.XXXXXX" 2>/dev/null) &&
	_RET=$(umask 077 && t="${TMPDIR:-/tmp}/${0##*/}.$$" &&
    -N | --dry-run         only report what would be done, show new 'sfdisk -d'
                           'partx --update'
	# flock the target disk to protect against udev actions while modifying.
	# The FD values are hard-coded per /bin/sh requirement for using exec
	debug 1 "FLOCK: try exec open fd 9, on failure exec exits this program"
	exec 9<>$disk
	rq flock flock -x $FLOCK_DISK_FD ||
	# After unlocking run udevadm settle (if installed) as the disk has
	exec 9>&-
	[ "${settle}" = 1 ] && has_cmd udevadm && udevadm settle
sfdisk_restore_legacy() {
	sfdisk --no-reread "${DISK}" -I "${MBR_BACKUP}"
sfdisk_restore() {
	# files are named: sfdisk-<device>-<offset>.bak
		dd "if=$f" "of=${DISK}" seek=$(($offset)) bs=1 conv=notrunc ||
			{ error "WARN: failed restore from $f"; fails=$(($fails+1)); }
sfdisk_worked_but_blkrrpart_failed() {
get_sfdisk_version() {
	# expected output: sfdisk from util-linux 2.25.2
	out=$(LANG=C sfdisk --version) ||
		{ error "failed to get sfdisk version"; return 1; }
		*) error "unexpected output in sfdisk --version [$out]"
			# for /dev/loop devices, sfdisk output will be <name>p<number>
			# sfdisk for files ending in digit to <disk>p<num>.
resize_sfdisk() {
	local restore_func=""
	LANG=C rqe sfd_list sfdisk --list --unit=S "$DISK" >"$tmp" ||
		fail "failed: sfdisk --list $DISK"
		# exected output contains: Units: sectors of 512 bytes, ...
			fail "failed to read sfdisk output"
			error "WARN: sector size not found in sfdisk output, assuming 512"
		t=$(sfdisk --show-size "${DISK}") ||
			fail "failed: sfdisk --show-size $DISK"
		restore_func=sfdisk_restore_legacy
		restore_func=sfdisk_restore
	rqe sfd_dump sfdisk --unit=S --dump "${DISK}" >"${dump_out}" ||
		fail "failed to dump sfdisk info for ${DISK}"
		echo "## sfdisk --unit=S --dump ${DISK}"
	[ $? -eq 0 ] || fail "failed to save sfdisk -d output"
		# sfdisk respects 'last-lba' in input, and complains about
			echo "# === old sfdisk -d ==="
			echo "# === new sfdisk -d ==="
	LANG=C sfdisk --no-reread "${DISK}" --force \
	[ $ret -eq 0 ] || RESTORE_FUNC="${restore_func}"
		sfdisk_worked_but_blkrrpart_failed "$ret" "${change_out}"; then
		debug 1 "sfdisk failed, but likely only because of blkrrpart"
		error "attempt to resize ${DISK} failed. sfdisk output below:"
gpt_restore() {
		RESTORE_FUNC=gpt_restore
	if command -v partx >/dev/null 2>&1; then
		out=$(partx --help 2>&1)
				reason="partx has no '--update' flag in usage."
			reason="'partx --help' returned $ret. assuming it is old."
		reason="no 'partx' command"
	# partx only works on block devices (do not run on file)
	partx --update --nr "$part" "$dev"
resize_sfdisk_gpt() {
	resize_sfdisk gpt
resize_sfdisk_dos() {
	resize_sfdisk dos
		out=$(sfdisk --id --force "$disk" 1 2>/dev/null); then
	elif out=$(LANG=C sfdisk --list "$disk"); then
		sfdisk) _RET="resize_sfdisk_$format"; return;;
			error "sfdisk is required for resizing dos/MBR partition table."
		_RET="resize_sfdisk_dos"
		# sfdisk 2.26.2 works for resize but loses type (LP: #1474090)
		_RET="resize_sfdisk_gpt"
	debug 2 "executing: $*"
		*) error "failed to execute [$ret] '$*'"
has_cmd sfdisk && SFDISK=sfdisk || SFDISK=""
	fail "Did not have sfdisk or sgdisk in PATH."
get_sfdisk_version || fail
mktemp_d && TEMP_D="${_RET}" || fail "failed to make temp dir"
trap cleanup 0 # EXIT - some shells may not like 'EXIT' but are ok with 0

## uid1001 read/write checks for cloud trust boundaries

### attacker: read cloud instance data
read /run/cloud-init/instance-data.json -> not readable or missing
read /run/cloud-init/instance-data-sensitive.json -> not readable or missing
read /run/cloud-init/status.json -> not readable or missing
read /run/cloud-init/result.json -> not readable or missing
read /var/lib/cloud/instance/user-data.txt -> not readable or missing
read /var/lib/cloud/instance/vendor-data.txt -> not readable or missing
rc=0

### attacker: write cloud config, datasource, seed, state, script, and run paths
touch /etc/cloud/cloud.cfg -> touch: cannot touch '/etc/cloud/cloud.cfg': Permission denied 
touch /etc/cloud/cloud.cfg.d/99-cloud-init-default.cfg -> touch: cannot touch '/etc/cloud/cloud.cfg.d/99-cloud-init-default.cfg': No such file or directory 
touch /etc/cloud/templates/cloud-init-default.tmpl -> touch: cannot touch '/etc/cloud/templates/cloud-init-default.tmpl': No such file or directory 
touch /etc/cloud/ds-identify.cfg -> touch: cannot touch '/etc/cloud/ds-identify.cfg': Permission denied 
touch /var/lib/cloud/seed/nocloud/user-data -> touch: cannot touch '/var/lib/cloud/seed/nocloud/user-data': No such file or directory 
touch /var/lib/cloud/seed/nocloud/meta-data -> touch: cannot touch '/var/lib/cloud/seed/nocloud/meta-data': No such file or directory 
touch /var/lib/cloud/seed/nocloud-net/user-data -> touch: cannot touch '/var/lib/cloud/seed/nocloud-net/user-data': No such file or directory 
touch /var/lib/cloud/seed/nocloud-net/meta-data -> touch: cannot touch '/var/lib/cloud/seed/nocloud-net/meta-data': No such file or directory 
touch /var/lib/cloud/instances/iid-local01/user-data.txt -> touch: cannot touch '/var/lib/cloud/instances/iid-local01/user-data.txt': No such file or directory 
touch /var/lib/cloud/instances/iid-local01/scripts/per-boot/00-cloud-init-default -> touch: cannot touch '/var/lib/cloud/instances/iid-local01/scripts/per-boot/00-cloud-init-default': No such file or directory 
