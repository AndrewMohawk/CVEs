    42	}
    43	
    44	fail() {
    45		[ $# -eq 0 ] || echo "FAILED:" "$@"
    46		exit 2
    47	}
    48	
    49	nochange() {
    50		RESIZE_RESULT="NOCHANGE"
    51		echo "NOCHANGE:" "$@"
    52		return 1
    53	}
    54	
    55	changed() {
    56		RESIZE_RESULT="CHANGED"
