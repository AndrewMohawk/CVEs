-rw-r--r-- 644 root:root /usr/share/dbus-1/system-services/org.freedesktop.ModemManager1.service
     1	# This D-Bus service activation file is only for systemd support since
     2	# an auto-activated ModemManager would be quite surprising for those people
     3	# who have MM installed but turned off.  Thus the Exec path available to
     4	# D-Bus is /bin/false, but systemd knows the real Exec path due to the MM
     5	# systemd .service file.
     6	
