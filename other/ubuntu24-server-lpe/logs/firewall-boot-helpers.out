## selected helper code trust points
### /usr/lib/ufw/ufw-init
     1	#!/bin/sh
     2	#
     3	# ufw-init: helper script to be used by ufw itself
     4	#
     5	# Copyright 2008-2015 Canonical Ltd.
     6	#
     7	#    This program is free software: you can redistribute it and/or modify
     8	#    it under the terms of the GNU General Public License version 3,
     9	#    as published by the Free Software Foundation.
    10	#
    11	#    This program is distributed in the hope that it will be useful,
    12	#    but WITHOUT ANY WARRANTY; without even the implied warranty of
    13	#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    14	#    GNU General Public License for more details.
    15	#
    16	#    You should have received a copy of the GNU General Public License
    17	#    along with this program.  If not, see <http://www.gnu.org/licenses/>.
    18	#
    19	set -e
    20	
    21	# FIXME: this shouldn't be ordered
    22	rootdir=
    23	if [ "$1" = "--rootdir" ] && [ -n "$2" ]; then
    24	    rootdir="$2/" # ensure trailing slash
    25	    shift 2
    26	fi
    27	datadir=
    28	if [ "$1" = "--datadir" ] && [ -n "$2" ]; then
    29	    datadir="$2/" # ensure trailing slash
    30	    shift 2
    31	fi
    32	export DATA_DIR="$datadir"
    33	
    34	# Debian/Ubuntu: small boot speed improvement
    35	. "${rootdir}/etc/ufw/ufw.conf"
    36	if [ "$1" = "start" ] && [ "$2" = "quiet" ] && [ "$ENABLED" = "no" ]; then
    37	    exit 0
    38	fi
    39	
    40	if [ -s "${rootdir}/lib/ufw/ufw-init-functions" ]; then
    41	    . "${rootdir}/lib/ufw/ufw-init-functions"
    42	else
    43	    echo "Could not find ${rootdir}/lib/ufw/ufw-init-functions (aborting)"
    44	    exit 1
    45	fi
    46	
    47	case "$1" in
    48	start)
    49	    # process multiple error strings
    50	    ret=0
    51	    output=`ufw_start` || ret="$?"
    52	    test -n "$output" && echo "$output" | while read line ; do
    53	        if [ "$2" = "quiet" ] || [ "$QUIET" = "yes" ]; then
    54	            echo "$line" | grep -q "Skip starting" && continue
    55	        fi
    56	        echo "$line"
    57	    done
    58	    exit "$ret"
    59	    ;;
    60	stop)
    61	    ufw_stop || exit "$?"
    62	    ;;
    63	force-stop)
    64	    ufw_stop --force || exit "$?"
    65	    ;;
    66	restart|force-reload)
    67	    ufw_reload || exit "$?"
    68	    ;;
    69	status)
    70	    ufw_status || exit "$?"
    71	    # If before.init and after.init support 'status', just display them after
    72	    # ufw_status() so it is prettier
    73	    if [ -x "$RULES_PATH/before.init" ]; then
    74	        "$RULES_PATH/before.init" status || exit "$?"
    75	    fi
    76	    if [ -x "$RULES_PATH/after.init" ]; then
    77	        "$RULES_PATH/after.init" status || exit "$?"
    78	    fi
    79	    ;;
    80	flush-all)
    81	    # Use sparingly. It flushes the built-in chains, deletes all non-builtin
    82	    # chains and resets the policy to ACCEPT
    83	    if [ -x "$RULES_PATH/before.init" ]; then
    84	        "$RULES_PATH/before.init" flush-all || exit "$?"
    85	    fi
    86	    flush_builtins || exit "$?"
    87	    if [ -x "$RULES_PATH/after.init" ]; then
    88	        "$RULES_PATH/after.init" flush-all || exit "$?"
    89	    fi
    90	    ;;
    91	*)
    92	    echo "Usage: /lib/ufw/ufw-init {start|stop|restart|force-reload|force-stop|flush-all|status}"
    93	    exit 1
    94	    ;;
    95	esac
    96	
### /usr/lib/ufw/ufw-init-functions
     1	#!/bin/sh
     2	#
     3	# ufw-init-functions: functions used by ufw-init and distribution initscripts
     4	#
     5	# Copyright 2008-2015 Canonical Ltd.
     6	#
     7	#    This program is free software: you can redistribute it and/or modify
     8	#    it under the terms of the GNU General Public License version 3,
     9	#    as published by the Free Software Foundation.
    10	#
    11	#    This program is distributed in the hope that it will be useful,
    12	#    but WITHOUT ANY WARRANTY; without even the implied warranty of
    13	#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    14	#    GNU General Public License for more details.
    15	#
    16	#    You should have received a copy of the GNU General Public License
    17	#    along with this program.  If not, see <http://www.gnu.org/licenses/>.
    18	#
    19	set -e
    20	
    21	PATH="/sbin:/bin:/usr/sbin:/usr/bin"
    22	
    23	for s in "${DATA_DIR}/etc/default/ufw" "${DATA_DIR}/etc/ufw/ufw.conf" ; do
    24	    if [ -s "$s" ]; then
    25	        . "$s"
    26	    else
    27	        echo "Could not find $s (aborting)"
    28	        exit 1
    29	    fi
    30	done
    31	
    32	RULES_PATH="${DATA_DIR}/etc/ufw"
    33	USER_PATH="${DATA_DIR}/etc/ufw"
    34	
    35	flush_builtins() {
    36	    error=""
    37	    execs="iptables"
    38	    if ip6tables -L INPUT -n >/dev/null 2>&1; then
    39	        execs="$execs ip6tables"
    40	    fi
    41	
    42	    for exe in $execs
    43	    do
    44	        $exe -F || error="yes"
    45	        $exe -X || error="yes"
    46	        $exe -P INPUT ACCEPT || error="yes"
    47	        $exe -P OUTPUT ACCEPT || error="yes"
    48	        $exe -P FORWARD ACCEPT || error="yes"
    49	
    50	        # now handle the mangle table
    51	        if $exe -t mangle -L -n >/dev/null 2>&1; then
    52	            for i in INPUT OUTPUT FORWARD PREROUTING POSTROUTING ; do
    53	                $exe -t mangle -F $i || error="yes"
    54	                $exe -t mangle -P $i ACCEPT || error="yes"
    55	            done
    56	        fi
    57	    done
    58	
    59	    # now handle the nat table
    60	    if iptables -t nat -L -n >/dev/null 2>&1; then
    61	        for i in OUTPUT PREROUTING POSTROUTING ; do
    62	            iptables -t nat -F $i || error="yes"
    63	            iptables -t nat -P $i ACCEPT || error="yes"
    64	        done
    65	    fi
    66	
    67	    if [ "$error" = "yes" ]; then
    68	        return 1
    69	    fi
    70	}
    71	
    72	chains_command() {
    73	    flag="$1"
    74	    type=""
    75	    exe="iptables"
    76	    if [ "$2" = "6" ]; then
    77	        type="$2"
    78	        exe="ip6tables"
    79	    fi
    80	
    81	    for c in ufw$type-logging-deny ufw$type-logging-allow ufw$type-not-local ufw$type-user-logging-input ufw$type-user-limit-accept ufw$type-user-limit ufw$type-skip-to-policy-input ufw$type-reject-input ufw$type-after-logging-input ufw$type-after-input ufw$type-user-input ufw$type-before-input ufw$type-before-logging-input ufw$type-skip-to-policy-forward ufw$type-reject-forward ufw$type-after-logging-forward ufw$type-after-forward ufw$type-user-logging-forward ufw$type-user-forward ufw$type-before-forward ufw$type-before-logging-forward ufw$type-track-forward ufw$type-track-output ufw$type-track-input ufw$type-skip-to-policy-output ufw$type-reject-output ufw$type-after-logging-output ufw$type-after-output ufw$type-user-logging-output ufw$type-user-output ufw$type-before-output ufw$type-before-logging-output; do
    82	        if [ "$UFW_INIT_DEBUG" = "yes" ]; then
    83	            echo "$exe $flag $c" >&2
    84	            $exe $flag $c || true
    85	        else
    86	            $exe $flag $c 2>/dev/null || true
    87	        fi
    88	    done
    89	}
    90	
    91	delete_chains() {
    92	    chains_command -F $1
    93	    chains_command -Z $1
    94	
    95	    # Delete the secondary chains to reduce clutter, but keep the primary ones
    96	    # so that the primary chains don't leave the built-in chains just to come
    97	    # back later in a different place. This means that some (empty) chains will
