/sbin/e2scrub:e2fsck_opts=""
/sbin/e2scrub:	echo "Usage: $0 [OPTIONS] mountpoint | device"
/sbin/e2scrub:	echo "mountpoint must be on an LVM-managed block device"
/sbin/e2scrub:# Find the device for a given mountpoint
/sbin/e2scrub:dev_from_mount() {
/sbin/e2scrub:	local mountpt="$(realpath "$1")"
/sbin/e2scrub:		if [ "${mountpt}" != "${MOUNTPOINT}" ]; then
/sbin/e2scrub:# Construct block device path and mountpoint from argument
/sbin/e2scrub:	dev="$(dev_from_mount "${arg}")"
/sbin/e2scrub:	# First we recover the journal, then we see if e2fsck tries any
/sbin/e2scrub:	${DBG} "/sbin/e2fsck" -E journal_only -p ${e2fsck_opts} "${snap_dev}" || return $?
/sbin/e2scrub:	${DBG} "/sbin/e2fsck" -f -y ${e2fsck_opts} "${snap_dev}"
/sbin/e2scrub:	${DBG} "/sbin/tune2fs" -E force_fsck "${dev}"
/sbin/e2scrub:	echo "${arg}: e2fsck operational error."
/sbin/e2scrub:	# fsck failed.  Check if the snapshot is invalid; if so, make a
/sbin/e2scrub:	# failure because the mounted fs could have overflowed the
/sbin/e2scrub:	# If it's really corrupt we ought to fsck at next boot.
/sbin/e2scrub:		echo "${arg}: Scrub FAILED due to corruption!  Unmount and run e2fsck -y."
/sbin/e2scrub_all:	echo " -A: Scrub all ext[234] filesystems even if not mounted."
/sbin/e2scrub_all:# Scrub any mounted fs on lvm by creating a snapshot and fscking that.
/sbin/blkdeactivate:# Script for deactivating block devices
/sbin/blkdeactivate:#       umount
/sbin/blkdeactivate:SYS_BLK_DIR="/sys/block"
/sbin/blkdeactivate:MOUNTPOINT="/bin/mountpoint"
/sbin/blkdeactivate:UMOUNT="/bin/umount"
/sbin/blkdeactivate:# Do not unmount mounted devices by default.
/sbin/blkdeactivate:# List of mountpoints to be skipped. Any device that is mounted on the mountpoint
/sbin/blkdeactivate:	echo "${TOOL}: Utility to deactivate block devices"
/sbin/blkdeactivate:	echo "    - Deactivate block device tree."
/sbin/blkdeactivate:	echo "    -u | --umount                       Unmount the device if mounted"
/sbin/blkdeactivate:device_umount_one() {
/sbin/blkdeactivate:		echo -n "  [UMOUNT]: unmounting $name ($kname) mounted on $mnt... "
/sbin/blkdeactivate:			echo "already unmounted"
/sbin/blkdeactivate:		echo "  [SKIP]: unmount of $name ($kname) mounted on $mnt"
/sbin/blkdeactivate:device_umount() {
/sbin/blkdeactivate:	# FINDMNT is defined only if umount --all-targets is not available.
/sbin/blkdeactivate:	# In that case, read the list of multiple mount points of one device
/sbin/blkdeactivate:	# using FINDMNT and unmount it one by one manually.
/sbin/blkdeactivate:		device_umount_one
/sbin/blkdeactivate:			device_umount_one || return 1
/sbin/blkdeactivate:	# Get holders for the device - either a mount or another device.
/sbin/blkdeactivate:	echo "Deactivating block devices:"
/sbin/blkdeactivate:		# Unmount all relevant mountpoints first
/sbin/blkdeactivate:			device_umount
/sbin/blkdeactivate:			# Unmount all relevant mountpoints first
/sbin/blkdeactivate:				device_umount
/sbin/blkdeactivate:		"-u"|"--umount") DO_UMOUNT=1 ;;
/usr/share/mdadm/mdcheck:	readlink -f /sys/dev/block/$maj:$min

