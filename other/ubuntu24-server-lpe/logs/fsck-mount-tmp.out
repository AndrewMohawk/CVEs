    21	IOSchedulingClass=idle
    22	CPUSchedulingPolicy=idle
    23	Environment=SERVICE_MODE=1
    24	ExecStart=/usr/sbin/xfs_scrub -b -n %f
    25	SyslogIdentifier=%N
### /usr/lib/systemd/system/blk-availability.service
