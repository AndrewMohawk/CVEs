     3	Before=shutdown.target
     4	After=iscsi-shutdown.service iscsi.service iscsid.service fcoe.service rbdmap.service
     5	DefaultDependencies=no
     6	Conflicts=shutdown.target
     7	
     8	[Service]
     9	Type=oneshot
    10	ExecStop=/usr/sbin/blkdeactivate -u -l wholevg -m disablequeueing -r wait
    11	RemainAfterExit=yes
    12	
    13	[Install]
    14	WantedBy=sysinit.target

