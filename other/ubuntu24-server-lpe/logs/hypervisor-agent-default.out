### /usr/lib/systemd/system/lxd-agent.service
     1	# Systemd unit for lxd-agent. It ensures the lxd-agent is copied from the shared filesystem before
     2	# it is started. The service is triggered dynamically via udev rules when certain virtio-ports are
     3	# detected, rather than being enabled at boot.
     4	[Unit]
     5	Description=LXD - agent
     6	Documentation=https://documentation.ubuntu.com/lxd/en/latest/
     7	Before=multi-user.target cloud-init.target cloud-init.service cloud-init-local.service
     8	DefaultDependencies=no
     9	
    10	[Service]
    11	Type=notify
    12	WorkingDirectory=-/run/lxd_agent
    13	ExecStartPre=/lib/systemd/lxd-agent-setup
    14	ExecStart=/run/lxd_agent/lxd-agent
    15	Restart=on-failure
    16	RestartSec=5s
    17	StartLimitInterval=60
    18	StartLimitBurst=10

### /usr/lib/systemd/system/lxd-installer.socket
     1	[Unit]
     2	Description=Helper to install lxd snap on demand
     3	
     4	[Socket]
     5	ListenStream=/run/lxd-installer.socket
     6	SocketUser=root
     7	SocketGroup=lxd
     8	SocketMode=0660
     9	Accept=true
    10	
    11	[Install]
    12	WantedBy=multi-user.target

### /usr/lib/systemd/system/lxd-installer@.service
     1	[Unit]
     2	Description=Helper to install lxd snap on demand
     3	
     4	[Service]
     5	ExecStart=/bin/sh -eux /usr/share/lxd-installer/lxd-installer-service
     6	StandardInput=socket
     7	StandardOutput=socket
     8	StandardError=journal
     9	Restart=no

### /usr/lib/systemd/system/pollinate.service
     1	[Unit]
     2	Description=Pollinate to seed the pseudo random number generator
     3	Before=ssh.service
     4	After=network-online.target
     5	ConditionVirtualization=!container
     6	ConditionPathExists=!/var/cache/pollinate/seeded
     7	Documentation=https://launchpad.net/pollinate
     8	
     9	[Service]
    10	User=pollinate
    11	ExecStart=/usr/bin/pollinate
    12	CacheDirectory=pollinate
    13	CacheDirectoryMode=0750
    14	Type=oneshot
    15	
    16	[Install]
    17	WantedBy=multi-user.target

### /lib/udev/rules.d/60-open-vm-tools.rules
     1	# VMWare Virtual Sockets permissions
     2	#
     3	# after loading the vsock module, a block device /dev/vsock will be created with permission 0600
     4	# This rule changes permission to 0666 to allow users access to the virtual sockets
     5	
     6	KERNEL=="vsock", MODE="0666"

### /lib/udev/rules.d/99-lxd-agent.rules
     1	# Start the lxd-agent.service when QEMU serial devices (symlinks in virtio-ports) appear.
     2	SYMLINK=="virtio-ports/com.canonical.lxd", TAG+="systemd", ENV{SYSTEMD_WANTS}+="lxd-agent.service"
     3	
     4	# Legacy serial device name for backward compatibility.
     5	SYMLINK=="virtio-ports/org.linuxcontainers.lxd", TAG+="systemd", ENV{SYSTEMD_WANTS}+="lxd-agent.service"

### /lib/systemd/lxd-agent-setup
     1	#!/bin/sh
     2	#
     3	# Setup script for lxd-agent that is executed by the lxd-agent systemd unit before lxd-agent is started.
     4	# The script sets up a temporary mount point, copies data from the mount (including lxd-agent binary),
     5	# and then unmounts it. It also ensures appropriate permissions for the LXD agent's runtime directory.
     6	#
     7	
     8	set -eu
     9	PREFIX="/run/lxd_agent"
    10	
    11	# Functions.
    12	mount_virtiofs() {
    13	    mount -t virtiofs config "${PREFIX}/.mnt" -o ro >/dev/null 2>&1
    14	}
    15	
    16	mount_9p() {
    17	    modprobe 9pnet_virtio >/dev/null 2>&1 || true
    18	    mount -t 9p config "${PREFIX}/.mnt" -o ro,access=0,trans=virtio >/dev/null 2>&1
    19	}
    20	
    21	fail() {
    22	    umount -l "${PREFIX}" >/dev/null 2>&1 || true
    23	    rmdir "${PREFIX}" >/dev/null 2>&1 || true
    24	    echo "${1}"
    25	    exit 1
    26	}
    27	
    28	# Setup the mount target.
    29	umount -l "${PREFIX}" >/dev/null 2>&1 || true
    30	mkdir -p "${PREFIX}"
    31	mount -t tmpfs tmpfs "${PREFIX}" -o mode=0700,nodev,nosuid,noatime,size=50M
    32	mkdir -p "${PREFIX}/.mnt"
    33	
    34	# Try virtiofs first.
    35	mount_virtiofs || mount_9p || fail "Couldn't mount virtiofs or 9p, failing."
    36	
    37	# Copy the data.
    38	cp -Ra --no-preserve=ownership "${PREFIX}/.mnt/"* "${PREFIX}"
    39	
    40	# Unmount the temporary mount.
    41	umount "${PREFIX}/.mnt"
    42	rmdir "${PREFIX}/.mnt"
    43	
    44	# Attempt to restore SELinux labels.
    45	restorecon -R "${PREFIX}" >/dev/null 2>&1 || true

### /usr/share/lxd-installer/lxd-installer-service
     1	#!/bin/sh
     2	lxd_channel() {
     3	    track="latest"
     4	
     5	    # lxd follows a pattern of $VERSION/stable/ubuntu-$VERSION
     6	    # default in development is "latest"
     7	    # with major version assigned and opened prior to Ubuntu release
     8	    # shellcheck disable=SC1091
     9	    [ -r /etc/os-release ] && . /etc/os-release
    10	    case "${VERSION_ID:-""}" in
    11	      "24.04")
    12	        track="5.21";;
    13	      "22.04")
    14	        track="5.0";;
    15	      "20.04")
    16	        track="4.0";;
    17	      *)
    18	        ;;
    19	    esac
    20	    if [ -n "${VERSION_ID:-""}" ]; then
    21	      echo "${track}/stable/ubuntu-${VERSION_ID}"
    22	    else
    23	      echo "${track}/stable"
    24	    fi
    25	}
    26	
    27	snap install lxd --channel="$(lxd_channel)" 1>&2
    28	echo 1

### /usr/bin/pollinate
     1	#!/bin/sh
     2	#
     3	# pollinate: an Entropy-as-a-Service client
     4	#
     5	#  Copyright (C) 2012-2016 Dustin Kirkland <dustin.kirkland@gmail.com>
     6	#
     7	#  This program is free software: you can redistribute it and/or modify
     8	#  it under the terms of the GNU General Public License as published by
     9	#  the Free Software Foundation, version 3 of the License.
    10	#
    11	#  This program is distributed in the hope that it will be useful,
    12	#  but WITHOUT ANY WARRANTY; without even the implied warranty of
    13	#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    14	#  GNU General Public License for more details.
    15	#
    16	#  You should have received a copy of the GNU General Public License
    17	#  along with this program.  If not, see <http://www.gnu.org/licenses/>.
    18	
    19	set -e
    20	set -f
    21	
    22	PKG="pollinate"
    23	TMPDIR=$(mktemp -d -t "${PKG}.XXXXXXXXXXXX")
    24	trap "rm -rf ${TMPDIR} 2>/dev/null || true" EXIT HUP INT QUIT TERM
    25	CACHEDIR="/var/cache/${PKG}"
    26	FLAG="${CACHEDIR}/seeded"
    27	LOG="${CACHEDIR}/log"
    28	HOSTNAME=$(hostname)
    29	STRICT=0
    30	
    31	# Only recent logger version supports --id=[ID]
    32	logger_ver=$(logger -V 2>&1 | awk '{print $4}')
    33	dpkg --compare-versions $logger_ver ge 2.26.2 && LOGGER="logger --id=$$" || LOGGER="logger"
    34	# Log to both syslog, and stderr, if we're on an interactive terminal
    35	[ -t 0 ] && LOGGER="$LOGGER -s"
    36	
    37	error() {
    38		$LOGGER -t ${PKG} "ERROR: $@"
    39		exit 1
    40	}
    41	
    42	warning() {
    43		if [ "$STRICT" = "1" ]; then
    44			$LOGGER -t ${PKG} "ERROR: $@"
    45			exit 1
    46		else
    47			$LOGGER -t ${PKG} "WARNING: $@"
    48			exit 0
    49		fi
    50	}
    51	
    52	log() {
    53		if [ "${QUIET}" = "1" ]; then
    54			# quiet mode, don't log to stderr
    55			if [ -w "$CACHEDIR" ]; then
    56				# log to file, if we can
    57				$LOGGER -t ${PKG} "$@" >>"${LOG}" 2>&1
    58			else
    59				# log to syslog, if its up
    60				$LOGGER -t ${PKG} "$@"
    61			fi
    62		else
    63			# log to both stderr and syslog
    64			$LOGGER -t ${PKG} "$@"
    65		fi
    66	}
    67	
    68	random_hash() {
    69		# Read and print urandom bytes
    70		head -c "${BYTES}" /dev/urandom | sha512sum | awk '{print $1}'
    71	}
    72	
    73	hash_and_write() {
    74		# Whiten input with a hash, and write to device
    75		local hex=$(cat "${TMPDIR}/out" "${TMPDIR}/err" | sha512sum | awk '{print $1}')
    76		if [ "${BINARY}" = "1" ]; then
    77			if [ "${DEVICE}" = "-" ]; then
    78				printf "${hex}" | xxd -r -p
    79			else
    80				printf "${hex}" | xxd -r -p > "${DEVICE}"
    81			fi
    82		else
    83			if [ "${DEVICE}" = "-" ]; then
    84				printf "%s" "${hex}"
    85			else
    86				printf "%s" "${hex}" > "${DEVICE}"
    87			fi
    88		fi
    89		log "client hashed response from [${1}]"
    90	}
    91	
    92	read_build_info() {
    93		# ubuntu images place build information in /etc/cloud/build.info
    94		# format of file is '<key>: <value>' put these under img/<key>/<value>
    95		local bifile="${1:-/etc/cloud/build.info}" ret=""
    96		_RET=""
    97		[ -s "$bifile" ] || return 0
    98		ret=$(awk '{
    99			gsub(/#.*/, ""); gsub(/\s+$/, "");
   100			if ($0 == "" || $0 !~ /:/) next;
   101			gsub(/:\s*/, "/");
   102			printf("img/%s ", $0) }' "$bifile") || return
   103		_RET="${ret% }"
   104	}
   105	
   106	read_addl_info() {
   107		# allow additinal info file to contain entries one per line.  lines must
   108		# have a '/' in them. remove trailing space and '#' as comment. example:
   109		#   key/value
   110		#   fookey/foovalue # written by foo
   111		local aifile="${1:-/etc/pollinate/add-user-agent}" ret=""
   112		_RET=""
   113		[ -s "$aifile" ] || return 0
   114		ret=$(awk '{
   115			gsub(/#.*/, ""); gsub(/\s+$/, "");
   116			if ($0 == "" || $0 !~ /\//) next;
   117			printf("%s ", $0); }' "$aifile") || return
   118		_RET=${ret% }
   119	}
   120	
   121	read_virt() {
   122		# return virt/<value> where value is the virtualization platform the
   123		# system is running on.
   124		local ret=""
   125		_RET=""
   126		if command -v systemd-detect-virt >/dev/null; then
   127			ret=$(systemd-detect-virt)
   128			# systemd-detect-virt returns 1 for 'none'
   129			[ $? -eq 0 -o "$ret" = "none" ] || ret=""
   130		else
   131			# trusty would take this path.
   132			if [ -d /dev/xen ]; then
   133				ret="xen"
   134			elif [ -d /dev/lxd ]; then
   135				# call this 'lxc' for consistency with systemd-detect-virt.
   136				ret="lxc"
   137			elif dmesg | grep --quiet " kvm-clock:"; then
   138				ret="kvm"
   139			fi
   140		fi
   141		[ -n "$ret" ] || return
   142		_RET="virt/$ret"
   143	}
   144	
   145	read_package_versions() {
   146		local pkgs="pollinate curl cloud-init" data="" p=""
   147		data=$(dpkg-query \
   148			-W --showformat='${Package}/${Version} ' $pkgs 2>/dev/null) || :
   149		# fill in 'package/' for any package not installed.
   150		for p in ${pkgs}; do
   151			[ "${data#*$p/}" = "$data" ] && data="${data} $p/"
   152		done
   153		if [ -n "$TESTING" ]; then
   154			p="pollinate"
   155			data="${data%%$p/*}$p${TESTING}/${data#*$p/}"
   156		fi
   157		set -- $data
   158		_RET="$*"
   159	}
   160	
   161	read_uname_info() {
   162		# taken from cloud-init ds-identify.
   163		# run uname, and parse output.
   164		# uname is tricky to parse as it outputs always in a given order
   165		# independent of option order. kernel-version is known to have spaces.
   166		# 1   -s kernel-name
   167		# 2   -n nodename
   168		# 3   -r kernel-release
   169		# 4.. -v kernel-version(whitespace)
   170		# N-2 -m machine
   171		# N-1 -o operating-system
   172		local out="" krel="" machine="" os=""
   173		out=$(uname -snrvmo) || { _RET=""; return; }
   174		set -- $out
   175		krel="$3"
   176		shift 3
   177		while [ $# -gt 2 ]; do
   178			shift
   179		done
   180		machine=$1
   181		os=$2
   182		_RET="$os/$krel/$machine"
   183		return 0
   184	}
   185	
   186	user_agent() {
   187		# Construct a user agent, with useful debug information
   188		# Very similar to Firefox and Chrome
   189		
   190		. /etc/lsb-release
   191	
   192		local pkg_info="" lsb="" platform="" cpu="" up="NA" idle="NA" uptime
   193		read_package_versions && pkg_info="$_RET"
   194		read_uname_info && platform="$_RET"
   195	
   196		lsb=$(echo "${DISTRIB_DESCRIPTION}" | sed -e "s/ /\//g")
   197		cpu="$(grep -m1 "^model name" /proc/cpuinfo | sed -e "s/.*: //" -e "s:\s\+:/:g")"
   198		{ read up idle < /proc/uptime ; } >/dev/null 2>&1 || :
   199		uptime="uptime/$up/$idle"
   200	
   201		local addl_data="" build_info="" virt=""
   202		read_build_info && build_info="${_RET}"
   203		read_addl_info && addl_data="${_RET}"
   204		read_virt && virt="${_RET}"
   205	
   206		USER_AGENT="${pkg_info} ${lsb} ${platform} ${cpu} ${uptime}${virt:+ ${virt}}${build_info:+ ${build_info}}${addl_data:+ ${addl_data}}"
   207	}
   208	
   209	exchange() {
   210		local server="${1}"
   211		local f1="${TMPDIR}/challenge"
   212		case "${server}" in
   213			"http://"*|"https://"*)
   214				# looks good
   215				true
   216			;;
   217			*)
   218				# otherwise, default to https://
   219				server="https://${server}"
   220			;;

### /usr/share/initramfs-tools/hooks/copymods
     1	#!/bin/sh
