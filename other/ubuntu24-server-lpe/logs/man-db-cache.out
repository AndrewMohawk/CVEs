     1	#!/bin/sh
     2	#
     3	# man-db cron daily
     4	
     5	set -e
     6	
     7	if [ -d /run/systemd/system ]; then
     8	    # Skip in favour of systemd timer.
     9	    exit 0
    10	fi
    11	
    12	# This should be set by cron, but apparently isn't always; see
    13	# https://bugs.debian.org/209185.  Add fallbacks so that start-stop-daemon
    14	# can be found.
    15	export PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"
    16	
    17	iosched_idle=
    18	# Don't try to change I/O priority in a vserver or OpenVZ.
    19	if ! grep -Eq '(envID|VxID):.*[1-9]' /proc/self/status && \
    20	   { [ ! -d /proc/vz ] || [ -d /proc/bc ]; }; then
    21	    iosched_idle='--iosched idle'
    22	fi
    23	
    24	if ! [ -d /var/cache/man ]; then
    25	    # Recover from deletion, per FHS.
    26	    install -d -o man -g man -m 0755 /var/cache/man
    27	fi
    28	
    29	# expunge old catman pages which have not been read in a week
    30	if [ -d /var/cache/man ]; then
    31	  cd /
    32	  # shellcheck disable=SC2086
    33	  start-stop-daemon --start --pidfile /dev/null --startas /bin/sh \
    34		--oknodo --chuid man $iosched_idle -- -c \
    35		"find /var/cache/man -type f -name '*.gz' -atime +6 -print0 | \
    36		 xargs -r0 rm -f"
    37	fi
    38	
    39	# regenerate man database
    40	if [ -x /usr/bin/mandb ]; then
    41	    # --pidfile /dev/null so it always starts; mandb isn't really a daemon,
    42	    # but we want to start it like one.
    43	    # shellcheck disable=SC2086
    44	    start-stop-daemon --start --pidfile /dev/null \
    45			      --startas /usr/bin/mandb --oknodo --chuid man \
    46			      $iosched_idle \
    47			      -- --no-purge --quiet
    48	fi
    49	
    50	exit 0
