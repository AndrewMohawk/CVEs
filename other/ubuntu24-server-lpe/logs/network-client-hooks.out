     1	#!/bin/sh
     2	
     3	ETHTOOL=/usr/sbin/ethtool
     4	
     5	test -x $ETHTOOL || exit 0
     6	
     7	[ "$IFACE" != "lo" ] || exit 0
     8	
     9	# Find settings with a given prefix and print them as they appeared in
    10	# /etc/network/interfaces, only with the prefix removed.
    11	# This actually prints each name and value on a separate line, but that
    12	# doesn't matter to the shell.
    13	gather_settings () {
    14	    set | sed -n "
    15	/^IF_$1[A-Za-z0-9_]*=/ {
    16	    h;                             # hold line
    17	    s/^IF_$1//; s/=.*//; s/_/-/g;  # get name without prefix
    18	    y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/;  # lower-case
    19	    p;
    20	    g;                             # restore line
    21	    s/^[^=]*=//; s/^'\(.*\)'/\1/;  # get value
    22	    p;
    23	}"
    24	}
    25	
    26	# Gather together the mixed bag of settings applied with -s/--change
    27	SETTINGS="\
    28	${IF_LINK_SPEED:+ speed $IF_LINK_SPEED}\
    29	${IF_LINK_DUPLEX:+ duplex $IF_LINK_DUPLEX}\
    30	"
    31	
    32	# WOL has an optional pass-key
    33	set -- $IF_ETHERNET_WOL
    34	SETTINGS="$SETTINGS${1:+ wol $1}${2:+ sopass $2}"
    35	
    36	# Autonegotiation can be on|off or an advertising mask
    37	case "$IF_ETHERNET_AUTONEG" in
    38	'')	;;
    39	on|off)	SETTINGS="$SETTINGS autoneg $IF_ETHERNET_AUTONEG" ;;
    40	*)	SETTINGS="$SETTINGS autoneg on advertise $IF_ETHERNET_AUTONEG" ;;
    41	esac
    42	
    43	[ -z "$SETTINGS" ] || $ETHTOOL --change "$IFACE" $SETTINGS
    44	
    45	SETTINGS="$(gather_settings ETHERNET_PAUSE_)"
    46	[ -z "$SETTINGS" ] || $ETHTOOL --pause "$IFACE" $SETTINGS
    47	
    48	SETTINGS="$(gather_settings HARDWARE_IRQ_COALESCE_)"
    49	[ -z "$SETTINGS" ] || $ETHTOOL --coalesce "$IFACE" $SETTINGS
    50	
    51	SETTINGS="$(gather_settings HARDWARE_DMA_RING_)"
    52	[ -z "$SETTINGS" ] || $ETHTOOL --set-ring "$IFACE" $SETTINGS
    53	
    54	SETTINGS="$(gather_settings OFFLOAD_)"
    55	[ -z "$SETTINGS" ] || $ETHTOOL --offload "$IFACE" $SETTINGS

### pollinate service and script trust boundary
# /usr/lib/systemd/system/pollinate.service
[Unit]
Description=Pollinate to seed the pseudo random number generator
Before=ssh.service
After=network-online.target
ConditionVirtualization=!container
ConditionPathExists=!/var/cache/pollinate/seeded
Documentation=https://launchpad.net/pollinate

[Service]
User=pollinate
ExecStart=/usr/bin/pollinate
CacheDirectory=pollinate
CacheDirectoryMode=0750
Type=oneshot

[Install]
WantedBy=multi-user.target

# /usr/lib/systemd/system/rsync.service
[Unit]
Description=fast remote file copy program daemon
ConditionPathExists=/etc/rsyncd.conf
After=network.target
Documentation=man:rsync(1) man:rsyncd.conf(5)

[Service]
ExecStart=/usr/bin/rsync --daemon --no-detach
RestartSec=1
Restart=on-failure

# Citing README.md:
#
#   [...] Using ssh is recommended for its security features.
#
#   Alternatively, rsync can run in `daemon' mode, listening on a socket.
#   This is generally used for public file distribution, [...]
#
# So let's assume some extra security is more than welcome here. We do full
# system protection (which makes /usr, /boot, & /etc read-only) and hide
# devices. To override these defaults, it's best to do so in the drop-in
# directory, often done via `systemctl edit rsync.service`. The file needs
# just the bare minimum of the right [heading] and override values.
# See systemd.unit(5) and search for "drop-in" for full details.

ProtectSystem=full
#ProtectHome=on|off|read-only
PrivateDevices=on
NoNewPrivileges=on

[Install]
WantedBy=multi-user.target

# /run/systemd/system/netplan-ovs-cleanup.service
[Unit]
Description=OpenVSwitch configuration for cleanup
DefaultDependencies=no
Wants=ovsdb-server.service
After=ovsdb-server.service
ConditionFileIsExecutable=/usr/bin/ovs-vsctl
Before=network.target
Wants=network.target

[Service]
Type=oneshot
TimeoutStartSec=10s
StartLimitBurst=0
ExecStart=/usr/sbin/netplan apply --only-ovs-cleanup

