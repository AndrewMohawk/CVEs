   167	def check_perms(path, mode=0o755, uid=0, gid=0):
   168	    """ Check that the given file or dir @ path has the given mode set, and is
   169	    owned by the given uid/gid. Symlinks are *not* followed. Raises
   170	    FileNotFoundError if path doesn't exist."""
   171	
   172	    if not os.path.exists(path):
   173	        raise FileNotFoundError
   174	    st = os.stat(path, follow_symlinks=False)
   175	    st_mode = st.st_mode & 0x00FFF
   176	    if st.st_uid == uid and st.st_gid == gid and st_mode == mode:
   177	        return True
   178	
   179	    logger.error("invalid permissions on %s. expected mode=%s, uid=%d, "
   180	                 "gid=%d; got mode=%s, uid=%d, gid=%d", path, oct(mode), uid,
   181	                 gid, oct(st_mode), st.st_uid, st.st_gid)
   182	    return False
   183	
   184	
   185	def scripts_in_path(path, subdir):
   186	    """Given directory names in PATH notation (separated by :), and a
   187	    subdirectory name, return a sorted list of executables
   188	    contained in that subdirectory, such that executables in earlier
   189	    path components override those with the same name in later path
   190	    components."""
   191	    script_list = []
   192	    base_filenames = set()
   193	    for one_path in path.split(":"):
   194	        one_path = os.path.join(one_path, subdir)
   195	        if not os.path.exists(one_path):
   196	            logger.debug("Path %r does not exist; skipping", one_path)
   197	            continue
   198	        base_filenames.update(os.listdir(one_path))
   199	
   200	    for filename in sorted(base_filenames):
   201	        for one_path in path.split(":"):
   202	            pathname = os.path.join(one_path, subdir, filename)
   203	
   204	            if os.path.isfile(pathname):
   205	                try:
   206	                    realpath = pathlib.Path(pathname).resolve()
   207	
   208	                    # Make sure that the file's parent dir has the correct
   209	                    # perms, without following any symlinks
   210	                    if not check_perms(os.path.dirname(pathname),
   211	                                       0o755, 0, 0):
   212	                        continue
   213	
   214	                    # Make sure file has correct perms, after following any
   215	                    # symlink(s)
   216	                    if not check_perms(realpath, 0o755, 0, 0):
   217	                        continue
   218	                except FileNotFoundError:
   219	                    continue
   220	
   221	                script_list.append(pathname)
   222	                break
   223	
   224	    return script_list
   356	    def run_hooks_for_state(self, iface, state):
   357	        """Run all hooks associated with a given state"""
   358	        # No actions to take? Do nothing.
   359	        script_list = self.get_scripts_list(state)
   360	        if not script_list:
   361	            logger.debug('Ignoring notification for interface %r entering '
   362	                         'state %r: no triggers', iface, state)
   363	            return
   364	
   365	        # Collect data
   366	        data = get_interface_data(iface)
   367	        (v4addrs, v6addrs) = parse_address_strings(data.get('Address', ()))
   368	
   369	        # Set script env. variables
   370	        script_env = dict(os.environ)
   371	        script_env.update({
   372	            'ADDR': (data.get('Address', ['']) + [''])[0],
   373	            'ESSID': data.get('ESSID', ''),
   374	            'IP_ADDRS': ' '.join(v4addrs),
   375	            'IP6_ADDRS': ' '.join(v6addrs),
   376	            'IFACE': iface.name,
   377	            'STATE': str(state),
   378	            'AdministrativeState': data.get('AdministrativeState', ''),
   379	            'OperationalState': data.get('OperationalState', ''),
   380	            'json': json.dumps(data, sort_keys=True),
   381	        })
   382	
   383	        # run all valid scripts in the list
   384	        logger.debug('Running triggers for interface %r entering state %r '
   385	                     'with environment %r', iface, state, script_env)
   386	        for script in script_list:
   387	            logger.info('Invoking %r for interface %s', script, iface.name)
   388	            ret = subprocess.Popen(script, env=script_env).wait()
