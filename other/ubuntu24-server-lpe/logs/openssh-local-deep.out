-- agent-launch helper --
     1	#!/bin/sh
     2	# helper script for launching ssh-agent, used by systemd unit
     3	set -e
     4	
     5	options="$(getopt -o '' -l help -- "$@")" || exit 1
     6	eval set -- "$options"
     7	
     8	if [ ! -d "$XDG_RUNTIME_DIR" ]; then
     9	    # shellcheck disable=SC2016
    10	    echo 'This needs $XDG_RUNTIME_DIR to be set' >&2
    11	    exit 1
    12	fi
    13	
    14	while :; do
    15	    case $1 in
    16	        --help)
    17	            echo 'Usage:' >&2
    18	            echo "  $0 start [-- ssh-agent options]" >&2
    19	            echo "  $0 stop"
    20	            exit 0
    21	            ;;
    22	        --)
    23	            shift
    24	            break
    25	            ;;
    26	        *)
    27	            echo "Unexpected argument: $1" >&2
    28	            exit 1
    29	            ;;
    30	    esac
    31	done
    32	
    33	if [ "$1" = start ]; then
    34	    shift
    35	    if [ -z "$SSH_AUTH_SOCK" ] && grep -s -q '^use-ssh-agent$' /etc/X11/Xsession.options; then
    36	        S="$XDG_RUNTIME_DIR/openssh_agent"
    37	        dbus-update-activation-environment --verbose --systemd SSH_AUTH_SOCK="$S" SSH_AGENT_LAUNCHER=openssh
    38	        exec ssh-agent -D -a "$S" "$@"
    39	    fi
    40	elif [ "$1" = stop ]; then
    41	    if [ "$SSH_AGENT_LAUNCHER" = openssh ]; then
    42	        dbus-update-activation-environment --systemd  SSH_AUTH_SOCK=
    43	    fi
    44	else
    45	    echo "Unknown command $1" >&2
    46	    exit 1
    47	fi

