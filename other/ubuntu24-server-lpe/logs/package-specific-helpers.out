### hdparm-default-proof
     1	ACTION=="add", SUBSYSTEM=="block", KERNEL=="[sh]d[a-z]", RUN+="/lib/udev/hdparm"
     2	
     3	#!/bin/sh
     4	
     5	set -e
     6	
     7	[ -n "$DEVNAME" ] || exit 1
     8	
     9	. /lib/hdparm/hdparm-functions
    10	
    11	if [ -e /proc/cmdline ]; then #linux only - future proofing against BSD and Hurd :)
    12	        if grep -wq nohdparm /proc/cmdline ; then
    13	                exit 0
    14	        fi
    15	fi
    16	
    17	raidstat=OK
    18	if [ -e /proc/mdstat ]; then
    19	        if egrep -iq "resync|repair|recover|check" /proc/mdstat; then
    20	                raidstat=RESYNC
    21	        fi
    22	elif [ -e /proc/rd/status ]; then
    23	        raidstat=`cat /proc/rd/status`
    24	fi
    25	
    26	if ! [ "$raidstat" = 'OK' ]; then
    27	        exit 1
    28	fi
    29	
    30	die() { echo "$*" 1>&2 ; exit 1; }
    31	OPTIONS=$(hdparm_options $DEVNAME) || die "hdparm_options failed with: $OPTIONS"
    32	apmopts=''
    33	if [ -n "$OPTIONS" ]; then
    34	        for opt in $OPTIONS; do
    35	                case $opt in
    36	                        (*'-B'*|*'-S'*|*'force_spindown_time'*)
    37	                                apmopts='true'
    38	                        ;;
    39	                esac
    40	        done
    41	        if [ "$apmopts" = true ]; then
    42	                /usr/lib/pm-utils/power.d/95hdparm-apm resume
    43	        fi
    44	        # strip -S (spindown) and -B (apm), force_spindown_time and -q
    45	        # apm options are handled by /usr/lib/pm-utils/power.d/95hdparm-apm
    46	        OPTIONS=$(echo $OPTIONS | perl -pe 's/((-S|-B|force_spindown_time)[\d]{1,3})|(-q\s?)//g')
    47	        if [ -n "$OPTIONS" ]; then
    48	                /sbin/hdparm -q $OPTIONS $DEVNAME 2>/dev/null
    49	        fi
    50	fi
    51	
    52	exit 0
    53	hdparm_is_on_battery() {
    54	    on_ac_power 2>/dev/null
    55	    [ $? -eq 1 ]
    56	}
    57	
    58	hdparm_set_option()
    59	{
    60	  local NEW_OPT= NEW_DEF=
    61	  if test -n "$DISC"; then
    62	    for i in $OPTIONS; do
    63	      if test x${i%${i#??}} != x${1%${1#??}}; then
    64	        NEW_OPT="$NEW_OPT $i"
    65	      else
    66	        NEW_OPT=${NEW_OPT%-q}
    67	      fi
    68	    done
    69	    OPTIONS="$NEW_OPT $OPT_QUIET $1"
    70	  else
    71	    for i in $DEFAULT; do
    72	      if test x${i%${i#??}} != x${1%${1#??}}; then
    73	        NEW_DEF="$NEW_DEF $i"
    74	      else
    75	        NEW_DEF=${NEW_DEF%-q}
    76	      fi
    77	    done
    78	    DEFAULT="$NEW_DEF $DEF_QUIET $1"
    79	  fi
    80	}
    81	
    82	hdparm_eval_value()
    83	{
    84	  case $1 in
    85	    off|0)
    86	      hdparm_set_option "$2"0
    87	       ;;
    88	    on|1)
    89	      hdparm_set_option "$2"1
    90	      ;;
    91	    *)
    92	      log_failure_msg "Unknown Value for $2: $1"
    93	      exit 1
    94	      ;;
    95	  esac
    96	}
    97	
    98	# It isn't safe to set an APM policy by default on Firewire or USB devices.
    99	# See https://bugs.launchpad.net/bugs/515023.
   100	hdparm_try_apm()
   101	{
   102	    # set our default global apm policy here.
   103	    if [ -z "$ID_PATH" ]; then
   104	        local ID_PATH="$(udevadm info -n "$1" -q property 2>/dev/null | sed -n 's/^ID_PATH=//p')" || true
   105	    fi
   106	    case $ID_PATH in
   107	        pci-*-ieee1394-*|pci-*-usb-*)
   108	            return 1
   109	            ;;
   110	    esac
   111	
   112	    # Only activate APM on disks that support it.
   113	    if [ -z "$ID_ATA_FEATURE_SET_APM" ]; then
   114	        local ID_ATA_FEATURE_SET_APM="$(udevadm info -n "$1" -q property 2>/dev/null | sed -n 's/^ID_ATA_FEATURE_SET_APM=//p')" || true
   115	    fi
   116	    if [ "$ID_ATA_FEATURE_SET_APM" = "1" ]; then
   117	        return 0
   118	    fi
   119	    return 1
   120	}
   121	
   122	# parse /etc/hdparm.conf and spit out a list of options for the specified
   123	# disk, taking into account global settings in /etc/hdparm.conf, current AC
   124	# power status, and (as a fallback) the default apm settings on Ubuntu.
   125	# arguments: device_name
   126	# returns 0 on success, 1 on failure.
   127	# options to be passed to hdparm are returned on stdout.
   128	hdparm_options()
   129	{
   130	    local WANTED_DISK="$1"
   131	
   132	    local DISC= DEFAULT= DEF_QUIET= COMMAND_LINE=
   133	    # if the below is guaranteed to spawn a subshell, then this next line is
   134	    # unnecessary
   135	    local OPTIONS OPT_QUIET KEY SEP VALUE
   136	
   137	    egrep -v '^[[:space:]]*(#|$)' /etc/hdparm.conf |
   138	    {
   139	        # set our default global apm policy here.
   140	        if hdparm_try_apm "$WANTED_DISK"; then
   141	            if hdparm_is_on_battery; then
   142	                hdparm_set_option -B128
   143	        # set a spindown time of 3 minutes by default so the disk isn't
   144	        # constantly power cycling on a busy machine if spindown is
   145	        # enabled
   146	        hdparm_set_option -S36
   147	            else
   148	                hdparm_set_option -B254
   149	            fi
   150	        fi
   151	
   152	        while read KEY SEP VALUE; do
   153	            case $SEP in
   154	                '{')
   155	                    case $KEY in
   156	                        command_line)
   157	                            unset DISC
   158	                            unset OPTIONS
   159	                            unset OPT_QUIET
   160	                            COMMAND_LINE=1
   161	                            ;;
   162	                        *)
   163	                            if [ -h "$KEY" ]
   164	                            then
   165	                                DISC=$(readlink -m "$KEY")
   166	                                DISC=${DISC%%[[:digit:]]*}
   167	                            else
   168	                                DISC=$KEY
   169	                            fi
   170	                            OPTIONS=$DEFAULT
   171	                            OPT_QUIET=$DEF_QUIET
   172	                            ;;
   173	                    esac
   174	                    ;;
   175	                =)
   176	                    case $KEY in
   177	                         read_ahead_sect)
   178	                             hdparm_set_option -a$VALUE
   179	                            ;;
   180	                        lookahead)
   181	                            hdparm_eval_value $VALUE -A
   182	                            ;;
   183	                        bus)
   184	                            hdparm_eval_value $VALUE -b
   185	                            ;;
   186	                        apm)
   187	                            if ! hdparm_is_on_battery; then
   188	                                hdparm_set_option -B$VALUE
   189	                            fi
   190	                            ;;
   191	                        apm_battery)
   192	                            if hdparm_is_on_battery; then
   193	                                hdparm_set_option -B$VALUE
   194	                            fi
   195	                            ;;
   196	                        io32_support)
   197	                            hdparm_set_option -c$VALUE
   198	                            ;;
   199	                        dma)
   200	                            hdparm_eval_value $VALUE -d
   201	                            ;;
   202	                        defect_mana)
   203	                            hdparm_eval_value $VALUE -D
   204	                            ;;
   205	                        cd_speed)
   206	                            hdparm_set_option -E$VALUE
   207	                            ;;
   208	                        mult_sect_io)
   209	                            hdparm_set_option -m$VALUE
   210	                            ;;
   211	                        prefetch_sect)
   212	                            hdparm_set_option -P$VALUE
   213	                            ;;
   214	                        read_only)
   215	                            hdparm_eval_value $VALUE -r
   216	                            ;;
   217	                        write_read_verify)
   218	                            hdparm_eval_value $VALUE -R
   219	                            ;;
   220	                        spindown_time)
   221	                            hdparm_set_option -S$VALUE
   222	                            ;;
   223	                        force_spindown_time)
   224	                            hdparm_set_option force_spindown_time$VALUE
   225	                            ;;
   226	                        poweron_standby)
   227	                            hdparm_eval_value $VALUE -s
   228	                            ;;
   229	                        interrupt_unmask)
   230	                            hdparm_eval_value $VALUE -u
   231	                            ;;
   232	                        write_cache)
   233	                            hdparm_eval_value $VALUE -W
   234	                            ;;
   235	                        transfer_mode)
   236	                            hdparm_set_option -X$VALUE
   237	                            ;;
   238	                        acoustic_management)
   239	                            hdparm_set_option -M$VALUE
   240	                            ;;
   241	                        keep_settings_over_reset)
   242	                            hdparm_eval_value $VALUE -k
   243	                            ;;
   244	                        keep_features_over_reset)
   245	                            hdparm_eval_value $VALUE -K
   246	                            ;;
   247	                        chipset_pio_mode)
   248	                            hdparm_set_option -p$VALUE
   249	                            ;;
   250	                        security_unlock)
   251	                            hdparm_set_option --security-unlock $VALUE
   252	                            ;;
   253	                        security_pass)
   254	                            hdparm_set_option --security-set-pass $VALUE
   255	                            ;;
   256	                        security_disable)
   257	                            hdparm_set_option --security-disable $VALUE
   258	                            ;;
   259	                        user-master)
   260	                            hdparm_set_option --user-master $VALUE
   261	                            ;;
   262	                        security_mode)
   263	                            hdparm_set_option --security-mode $VALUE
   264	                            ;;
   265	                        ROOTFS)
   266	                            ;;
   267	                        *)
   268	                            echo "Unknown option $KEY"
   269	                            exit 1
   270	                            ;;
   271	                    esac
   272	                    ;;
   273	                "")
   274	                    case $KEY in
   275	                        '}')
   276	                            if [ -z "$DISC" ] && [ -z "$COMMAND_LINE" ]; then
   277	                                echo "No disk enabled. Exiting" >&2
   278	                                return 1
   279	                            fi
   280	                            if [ -n "$OPTIONS" ] && [ "$DISC" = "$WANTED_DISK" ]
   281	                            then
   282	                                echo $OPTIONS
   283	                                return 0
   284	                            fi
   285	                            COMMAND_LINE=
   286	                            ;;
   287	                        quiet)
   288	                            if [ -n "$DISC" ]; then
   289	                                OPT_QUIET=-q
   290	                            else
   291	                                DEF_QUIET=-q
   292	                            fi
   293	                            ;;
   294	                        standby)
   295	                            hdparm_set_option -y
   296	                            ;;
   297	                        sleep)
   298	                            hdparm_set_option -Y
   299	                            ;;
   300	                        disable_seagate)
   301	                            hdparm_set_option -Z
   302	                            ;;
   303	                        security_freeze)
   304	                            hdparm_set_option --security-freeze
   305	                            ;;
   306	                        *)
   307	                            if [ -z "$COMMAND_LINE" ]; then
   308	                                echo "unknown option $KEY" >&2
   309	                                return 1
   310	                            fi
   311	                            ;;
   312	                    esac
   313	                    ;;
   314	                *)
   315	                    if [ -z "$COMMAND_LINE" ]; then
   316	                        echo "unknown separator $SEP" >&2
   317	                        return 1
   318	                    fi
   319	                    ;;
   320	            esac
   321	        done
   322	        # parsed the whole file and didn't find the disk,
   323	        # so try the default instead.
   324	        if [ -n "$DEFAULT" ]; then
   325	            echo $DEFAULT
   326	            return 0
   327	        fi
   328	    }
   329	}
   330	## This is the default configuration for hdparm for Debian.
   331	## Any line that begins with a comment is ignored - add as many as you
   332	## like.  Note that an in-line comment is not supported.  If a line
   333	## consists of whitespace only (tabs, spaces, carriage return), it will be
   334	## ignored, so you can space control fields as you like.  ANYTHING ELSE
   335	## IS PARSED!!  This means that lines with stray characters or lines that
   336	## use non # comment characters will be interpreted by the helper scripts (
   337	## /lib/udev/hdparm, /usr/lib/pm-utils/power.d/95hdparm-apm ).
   338	## This has probably minor, but potentially serious, side effects for your
   339	## hard drives, so please follow the guidelines.  Patches to improve
   340	## flexibilty welcome.  Please read /usr/share/doc/hdparm/README.Debian for
