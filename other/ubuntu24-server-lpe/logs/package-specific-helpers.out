    24	#!/bin/sh
    25	
    26	# This hook copies busybox binary into the initramfs directory
    27	# and creates all necessary links to it.
    28	# It should be placed last into the hooks directory, in order to
    29	# not overwrite commands which are provided by other means.
    30	
    31	set -e
    32	
    33	case "${1:-}" in
    34	  prereqs)  echo ""; exit 0;;
    35	esac
    36	
    37	BB_BIN=/usr/lib/initramfs-tools/bin/busybox
    38	
    39	[ n = "$BUSYBOX" ] && exit 0
    40	
    41	[ -r /usr/share/initramfs-tools/hook-functions ] || exit 0
    42	. /usr/share/initramfs-tools/hook-functions
    43	
    44	if [ -f $DESTDIR/bin/sh ] && cmp -s $DESTDIR/bin/sh $BB_BIN ; then
    45	  # initramfs copies busybox into /bin/sh, undo this
    46	  rm -f $DESTDIR/bin/sh
    47	fi
    48	rm -f $DESTDIR/bin/busybox	# for compatibility with old initramfs
    49	copy_exec $BB_BIN /bin/busybox
    50	
    51	for alias in $($BB_BIN --list-long); do
    52	  alias="${alias#/}"
    53	  case "$alias" in
    54	    # strip leading /usr, we don't use it
    55	    usr/*) alias="${alias#usr/}" ;;
    56	    */*) ;;
    57	    *) alias="bin/$alias" ;;  # make it into /bin
    58	  esac
    59	
    60	  # Busybox is configured to prefer its own applets, so remove
    61	  # duplication from klibc.
    62	  name="${alias##*/}"
    63	  if [ -e "$DESTDIR/$alias" ] && cmp -s "/usr/lib/klibc/bin/$name" "$DESTDIR/$alias"; then
    64	    rm -f "$DESTDIR/$alias"
    65	    [ "${verbose}" = "y" ] && echo "Preferring busybox $alias over klibc" || true
    66	  fi
    67	
    68	  [ -e "$DESTDIR/$alias" ] || \
    69	    ln "$DESTDIR/bin/busybox" "$DESTDIR/$alias"
    70	done
    71	
    72	# Casper wants to have access to https, let busybox invoke openssl to
    73	# achieve that.
    74	# TODO: maybe have another variable like BUSYBOX_OPENSSL to include
    75	# openssl if wanted? maybe like cloud-initramfs wants it?
    76	if [ "$CASPER_GENERATE_UUID" ]; then
    77	    mkdir -p $DESTDIR/etc/ssl/certs $DESTDIR/usr/lib/ssl/
    78	    copy_exec /usr/bin/openssl
    79	    copy_file config /etc/ssl/openssl.cnf
    80	    update-ca-certificates --fresh --etccertsdir $DESTDIR/etc/ssl/certs --hooksdir /no-hooks
    81	    # Only use by-hash certs
    82	    rm -f $DESTDIR/etc/ssl/certs/ca-certificates.crt
    83	    for cert in $DESTDIR/etc/ssl/certs/* ; do
    84	        target=$(readlink $cert)
    85	        case $target in
    86	            /*)
    87	                copy_file cert $target
    88	                ;;
    89	        esac
    90	    done
    91	    ln -s /etc/ssl/certs $DESTDIR/usr/lib/ssl/certs
    92	    ln -s /etc/ssl/openssl.cnf $DESTDIR/usr/lib/ssl/openssl.cnf
    93	fi
    94	#!/bin/sh
    95	
    96	prereqs()
    97	{
    98		if [ "${BUSYBOX}" = "n" ] || [ -z "${BUSYBOXDIR}" ]; then
    99			echo ''
   100		else
   101			# Ensure busybox installs all its commands before
   102			# checking what we should provide
   103			echo zz-busybox
   104		fi
   105	}
   106	
   107	case $1 in
   108	# get pre-requisites
   109	prereqs)
   110		prereqs
   111		exit 0
   112		;;
   113	esac
   114	
   115	for src in /usr/lib/klibc/bin/*; do
   116		command="$(basename "$src")"
   117		case "$command" in
   118		gzip | kinit | zcat)
   119			# Don't install; these will not be needed
   120			;;
   121		*)
   122			# Don't install commands that already exist in /bin or /sbin
   123			if ! [ -e "${DESTDIR}/sbin/$command" ] \
   124			   && ! [ -e "${DESTDIR}/bin/$command" ]; then
   125				cp -pL "$src" "${DESTDIR}/bin"
   126			fi
   127			;;
   128		esac
   129	done
   130	cp -pL /usr/lib/klibc-*.so "${DESTDIR}/lib"

