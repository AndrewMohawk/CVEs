active
active
     1	# SCSI-ID mappings for sg3_utils
     2	
     3	ACTION=="remove", GOTO="sg3_utils_id_end"
     4	
     5	SUBSYSTEM=="block", GOTO="block_dev"
     6	
     7	# SCSI devices other than "block"
     8	# This code used to live in 60-persistent-storage-tape.rules.
     9	
    10	# type 8 devices are "Medium Changers"
    11	SUBSYSTEM=="scsi_generic", KERNEL=="sg*[0-9]", ATTRS{type}=="8", \
    12	  GOTO="scsi_inquiry"
    13	SUBSYSTEM=="scsi_changer", KERNEL=="sch*[0-9]", ATTRS{type}=="8", \
    14	  ENV{.INQUIRY_DEV}="$root/bsg/$id", GOTO="scsi_inquiry"
    15	
    16	# tapes need to be accessed through their bsg device
    17	KERNEL=="st*[0-9]|nst*[0-9]", SUBSYSTEMS=="scsi", KERNELS=="[0-9]*:*[0-9]", \
    18	  ENV{.INQUIRY_DEV}="$root/bsg/$id", GOTO="scsi_inquiry"
    19	
    20	GOTO="sg3_utils_id_end"
    21	
    22	LABEL="block_dev"
    23	
    24	# Import values for partitions
    25	ENV{DEVTYPE}=="partition", IMPORT{parent}="ID_SCSI", IMPORT{parent}="SCSI_*"
    26	ENV{DEVTYPE}=="partition", ENV{ID_SCSI}=="1", GOTO="compat"
    27	
    28	# Handle non-SCSI devices that implement SCSI inquiry
    29	KERNEL=="cciss*", ENV{DEVTYPE}=="disk", GOTO="sg_inquiry"
    30	
    31	# Ignore everything else except sd/sr
    32	KERNEL!="sd*[!0-9]|sr*", GOTO="sg3_utils_id_end"
    33	
    34	# SCSI INQUIRY values
    35	# If the 'inquiry' sysfs attribute is present the kernel will already
    36	# have scanned for VPD pages, so if the vpd page attribute is not
    37	# present it is not supported (or deemed unsafe to access).
    38	# Hence we can skip the call to sg_inq and avoid I/O altogether.
    39	# Set 'ID_SCSI_INQUIRY=0' in an earlier udev rule if the kernel
    40	# fails to scan VPD pages correctly; the rules will then fall
    41	# back to calling sg_vpd directly.
    42	LABEL="scsi_inquiry"
    43	ENV{ID_SCSI_INQUIRY}=="0", GOTO="sg_inquiry"
    44	
    45	# As of 2018/4.15, the kernel doesn't provide VPD pages for "SPC" devices
    46	# (SCSI version 0x03, ANSI INCITS 301-1997) in sysfs.
    47	# It's usually safe to try though (no counter-example is known),
    48	# and for scsi_id compatibility, we have to try.
    49	SUBSYSTEMS=="scsi", ATTRS{scsi_level}=="4", GOTO="sg_inquiry"
    50	
    51	# "inquiry" is an attribute of the scsi_device in sysfs,
    52	# we obtain it by using $id after an ATTRS match.
    53	SUBSYSTEMS=="scsi", ATTRS{inquiry}=="*", KERNELS=="[0-9]*:*[0-9]", \
    54	  ENV{.SYSFS_PATH}="$sys/class/scsi_device/$id/device"
    55	ENV{.SYSFS_PATH}=="", GOTO="sg_inquiry"
    56	
    57	IMPORT{program}="/usr/bin/sg_inq --export --inhex=$env{.SYSFS_PATH}/inquiry --raw", \
    58	  ENV{ID_SCSI}="1", ENV{ID_SCSI_INQUIRY}="1"
    59	# If inquiry sysfs attribute reading it failed, fallback to sg
    60	ENV{ID_SCSI}!="1", GOTO="sg_inquiry"
    61	# Read VPD pages 80 (sn) and 83 (di)
    62	IMPORT{program}="/usr/bin/sg_inq --export --inhex=$env{.SYSFS_PATH}/vpd_pg80 --raw"
    63	IMPORT{program}="/usr/bin/sg_inq --export --inhex=$env{.SYSFS_PATH}/vpd_pg83 --raw"
    64	GOTO="compat"
    65	
    66	LABEL="sg_inquiry"
    67	# Handle devices that have no inquiry attributes in sysfs
    68	ENV{.INQUIRY_DEV}=="", ENV{.INQUIRY_DEV}="$tempnode"
    69	
    70	IMPORT{program}="/usr/bin/sg_inq --export $env{.INQUIRY_DEV}", ENV{ID_SCSI}="1"
    71	# Give up if this fails, too
    72	ENV{ID_SCSI}!="1", GOTO="sg3_utils_id_end"
    73	IMPORT{program}="/usr/bin/sg_inq --export --page=sn $env{.INQUIRY_DEV}"
    74	IMPORT{program}="/usr/bin/sg_inq --export --page=di $env{.INQUIRY_DEV}"
    75	
    76	LABEL="compat"
    77	
