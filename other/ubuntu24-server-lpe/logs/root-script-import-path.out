#!/bin/sh
/usr/lib/apt/apt.systemd.daily: POSIX shell script, ASCII text executable
11:# which can be used with systemd OnCalendar overrides to
107:    stamp=$(date --date="$(date -r "$stamp_file" --iso-8601)" +%s 2>/dev/null)
