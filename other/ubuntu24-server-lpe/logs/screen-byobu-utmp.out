== libutempter host and tty-name control probe ==
uid=1001 gid=1001 slave=/dev/pts/0 line=pts/0 mode=0o620 owner=1001:5
case=plain host=b'sbu-host' add_rc=1 who_lines=1
  who: attacker pts/0        May 16 17:39 (sbu-host)
case=space host=b'sbu host with space' add_rc=1 who_lines=1
  who: attacker pts/0        May 16 17:39 (sbu host with space)
case=path-text-host host=b'../tmp/sbu-root-canary' add_rc=1 who_lines=1
  who: attacker pts/0        May 16 17:39 (../tmp/sbu-root-canary)
case=newline host=b'sbu-line\nfeed' add_rc=0 who_lines=0
case=control host=b'sbu-ctrl-\x01-byte' add_rc=0 who_lines=0
after_remove_who=''

