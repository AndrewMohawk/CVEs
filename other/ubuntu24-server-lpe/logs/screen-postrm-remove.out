### postinst
     1	#!/bin/sh
     2	set -e
     3	
     4	. /usr/share/debconf/confmodule
     5	
     6	if [ "$1" = configure ]; then
     7	  if ! test -d /run/screen; then
     8	    install -g utmp -m 0775 -d /run/screen
     9	  fi
    10	  perms="`stat -c%a /usr/bin/screen`"
    11	  override=/etc/tmpfiles.d/screen-cleanup.conf
    12	  if [ $perms -eq 4755 ]; then
    13	    chmod 0755 /run/screen
    14	    if [ ! -f $override ]; then
    15	       echo "# This file is generated by $0 upon package configuration" > $override
    16	       echo 'd /run/screen 0755 root utmp' >> $override
    17	    fi
    18	  elif [ $perms -eq 755 ]; then
    19	    chmod 1777 /run/screen
    20	    if [ ! -f $override ]; then
    21	       echo "# This file is generated by $0 upon package configuration" > $override
    22	       echo 'd /run/screen 1777 root utmp' >> $override
    23	    fi
    24	  fi
    25	
    26	  # LP #1462692
    27	  servicedir=/lib/systemd/system
    28	  servicefile=$servicedir/screen-cleanup.service
    29	  mkdir -p $servicedir
    30	  if [ ! -e $servicefile ]; then
    31	      ln -s /dev/null $servicefile
    32	  fi
    33	fi
    34	
    35	# Automatically added by dh_installtmpfiles/13.14.1ubuntu5
    36	if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    37		if [ -x "$(command -v systemd-tmpfiles)" ]; then
    38			systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create screen-cleanup.conf || true
    39		fi
    40	fi
    41	# End automatically added section
    42	# Automatically added by dh_installinit/13.14.1ubuntu5
    43	if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    44		if [ -x "/etc/init.d/screen-cleanup" ]; then
    45			update-rc.d screen-cleanup defaults >/dev/null || exit 1
    46		fi
    47	fi
    48	# End automatically added section
    49	
### postrm
     1	#!/bin/sh
     2	set -e
     3	
     4	if [ "$1" = purge ] || [ "$1" = remove ]; then
     5	  rm -rf /run/screen
     6	fi
     7	
     8	if [ "$1" = purge ]; then
     9	  rm -vf /etc/tmpfiles.d/screen-cleanup.conf
    10	
    11	  # LP #1462692
    12	  rm -f /lib/systemd/system/screen-cleanup.service
    13	  rmdir -p --ignore-fail-on-non-empty /lib/systemd/system
    14	fi
    15	
    16	# Automatically added by dh_installinit/13.14.1ubuntu5
    17	if [ "$1" = "remove" ] && [ -x "/etc/init.d/screen-cleanup" ] ; then
    18		chmod -x "/etc/init.d/screen-cleanup" >/dev/null || true
    19	fi
    20	if [ -z "${DPKG_ROOT:-}" ] && [ "$1" = "purge" ] ; then
    21		update-rc.d screen-cleanup remove >/dev/null
    22	fi
    23	# End automatically added section
