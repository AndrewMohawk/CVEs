$ runuser -u selfauth -- env XDG_RUNTIME_DIR=/run/user/1002 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1002/bus systemctl --user stop snapd.session-agent.service snapd.session-agent.socket
rc=0

