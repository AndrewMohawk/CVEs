## session-agent service-control remains uid1002 user scope

## root client asks session agent to daemon-reload user manager
stdin={"action":"daemon-reload"}
$ snap debug api --session-agent-uid=1002 -X POST -H Content-Type:\ application/json /v1/service-control
{
  "result": null,
  "type": "sync"
}
rc=0

## root client asks session agent to start snap-prefixed user service
stdin={"action":"start","services":["snap.snapd-session-agent-probe.service"]}
$ snap debug api --session-agent-uid=1002 -X POST -H Content-Type:\ application/json /v1/service-control
{
  "result": null,
  "type": "sync"
}
rc=0

