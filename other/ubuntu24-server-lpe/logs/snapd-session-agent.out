$ runuser -u selfauth -- env XDG_RUNTIME_DIR=/run/user/1002 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1002/bus snap debug api --session-agent-uid=1002 /v1/session-info
{
  "result": {
    "version": "2.74.1+ubuntu24.04.4"
  },
  "type": "sync"
}
rc=0

