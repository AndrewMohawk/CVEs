## relevant root-handling snippets
### /usr/bin/vm-support
   323	# This executable may run with root privileges, so hardcode a PATH where
   324	# unprivileged users cannot write.
   325	export PATH=/bin:/sbin:/usr/bin:/usr/sbin
   326	
   327	TARFILE=vm-`date +%Y-%m-%d`.$$.tar.gz
   328	VER=0.98
   329	
   330	# Parse args
   331	for option in $@
   332	do
   333	   case $option in
   334	   "-h")
   335	      usage
   336	      ;;
   337	   "-u")
   338	      update=1
   339	      ;;
   340	   "-x")
   341	      transfer=1
   342	      ;;
   343	   *)
   344	      usage
   345	      ;;
   346	   esac
   347	done
   348	
   349	#	Start message
   350	
   351	UpdateState $VMSUPPORT_BEGINNING
   352	
   353	banner "VMware UNIX Support Script $VER"
   354	
   355	#	Check for root privledge
   356	
   357	if [ `whoami` != 'root' ]; then
   358	   error "Please re-run this program as root. "
   359	fi
   360	
   361	# Source /etc/profile.  If we can't find it, it's the users problem to get
   362	# their paths straight.
   363	if [ -f /etc/profile ]; then
   364		. /etc/profile
   365	fi
   366	
   367	# Protect against non-default values of $IFS (Not all scripts in /etc/profile.d/
   368	# are good citizens).
   369	if [ `uname` != 'SunOS' ]; then
   370	   unset IFS 2>/dev/null
   371	fi
   372	
   373	# Create a temporary directory to place the files to archive.
   374	#
   375	# o mktemp creates a new directory, with a random name, and gives it
   376	#   permissions 700 so only the current user (and root) can access the
   377	#   contents of the directory. This prevents a rogue user from:
   378	#   1) Guessing the name of the directory.
   379	#   2) Performing a symlink attack inside the directory.
   380	#   3) Reading data inside the directory, that only the current user (and root)
   381	#      are supposed to access.
   382	# o The directory is created inside /tmp, so only the current user (and root)
   383	#   can delete the directory. This prevents a rogue user from wholesale
   384	#   replacing the directory after we have created it, with a directory that has
   385	#   more lenient permissions.
   386	OUTPUT_DIR="`mktemp -d /tmp/vm-support.XXXXXX`"
   442	banner "Creating tar archive..."
   443	# Set umask to make diagnostic information unreadable to other users to avoid
   444	# possible information leakage.
   445	(umask 0077 && tar $TAR_OPTS $TARFILE $OUTPUT_DIR)
   446	if [ $? -ne 0 ]; then
   447		banner "The tar process did not successfully complete!" \
   448		       "If tar reports that a file changed while reading, please attempt " \
   449		       "to rerun this script."
   450	fi
   451	
   452	# Clean up temporary files
   453	trap - HUP INT QUIT TERM ABRT; cleanup
   454	
   455	if [ $transfer -eq 1 ]; then
   456	   banner "Transferring support data to the host..."
   457	   vmware-xferlogs enc $TARFILE 2>/dev/null
   458	
### /usr/bin/finalrd
    18	# /run may be mounted noexec,nosuid => fix it
    19	# it should be a more normal/default filesystem post-pivot
    20	# systemd-shutdownd pivot does not currently remount /run with these
    21	# options
    22	mount -o remount,exec /run
    23	
    24	### SHUTDOWN SUPPORT ###
    25	# our shutdown sequence is to be controled by systemd-shutdown which
    26	# will unmount all the things, and run our hooks
    27	
    28	for bin in /bin/sh /lib/systemd/systemd-shutdown
    29	do
    30	    rm -f /run/finalrd-libs.conf
    31	    touch /run/finalrd-libs.conf
    32	    for lib in `LD_TRACE_LOADED_OBJECTS=1 $bin | grep -Eow "/.* "`
    33	    do
    34	        if [ "$lib" = '=>' ]
    35	        then
    36	            continue
    37	        fi
    38	        if grep -q $lib /run/finalrd-libs.conf
    39	        then
    40	            continue
    41	        fi
    42	        echo "d $(dirname $DESTDIR$lib)" >> /run/finalrd-libs.conf
    43	        if [ -L $lib ]
    44	        then
    45	            target=$(realpath -e $lib)
    46	            echo "C $DESTDIR$target - - - - $target" >> /run/finalrd-libs.conf
    47	            echo "L $DESTDIR$lib - - - - $(readlink $lib)" >> /run/finalrd-libs.conf
    48	        else
    49	            echo "C $DESTDIR$lib - - - - $lib" >> /run/finalrd-libs.conf
    50	        fi
    51	    done
    52	done
    53	systemd-tmpfiles --create /usr/lib/finalrd/finalrd-static.conf /run/finalrd-libs.conf
    54	
    55	### HOOKS SUPPORT ###
    56	# Without initramfs-tools, hooks are not supported
    57	[ -e /usr/share/initramfs-tools/hook-functions ] || exit 0
    58	. /usr/share/initramfs-tools/hook-functions
    59	
    60	for d in /usr/share/finalrd /etc/finalrd /run/finalrd
    61	do
    62	    if [ -d $d ]
    63	    then
    64		run-parts -v --regex='^.*\.finalrd$' --arg=setup -- $d || :
    65		find $d -executable -name '*.finalrd' -exec cp -- "{}" $DESTDIR/lib/systemd/system-shutdown \;
    66	    fi
    67	done
    68	
    69	ldconfig -r $DESTDIR
### /etc/update-motd.d/50-motd-news
    32	# Source the local configuration
    33	[ -r /etc/default/motd-news ] && . /etc/default/motd-news
    34	
    35	# Exit immediately, unless we're enabled
    36	# This makes this script very easy to disable in /etc/default/motd-news configuration
    37	[ "$ENABLED" = "1" ] || exit 0
    38	
    39	# Ensure sane defaults
    40	[ -n "$URLS" ] || URLS="https://motd.ubuntu.com"
    41	[ -n "$WAIT" ] || WAIT=5
    42	[ -n "$CACHE" ] || CACHE="/var/cache/motd-news"
    43	[ "$1" = "--force" ] && FORCED=1
    71	# Generate our temp files, clean up when done
    72	NEWS=$(mktemp) || exit 1
    73	ERR=$(mktemp) || exit 1
    74	CLOUD=$(mktemp) || exit 1
    75	trap "rm -f $NEWS $ERR $CLOUD" HUP INT QUIT ILL TRAP KILL BUS TERM
    76	
    77	# Construct a user agent, similar to Firefox/Chrome/Safari/IE to
    78	# ensure a proper, tailored, accurate message of the day
    79	
    80	# wget browser version, for debug purposes
    81	wget_ver="$(dpkg -l wget | awk '$1 == "ii" { print($3); exit(0); }')"
    82	
    83	# Distribution version, for messages releated to this Ubuntu release
    84	. /etc/lsb-release
    85	lsb=$(echo "$DISTRIB_DESCRIPTION" | sed -e "s/ /\//g")
    86	codename="$DISTRIB_CODENAME"
    87	
    88	# Kernel version and CPU type, for messages related to a particular revision or hardware
    89	platform="$(uname -o)/$(uname -r)/$(uname -m)"
    90	arch="$(uname -m)"
    91	cpu="$(grep -m1 "^model name" /proc/cpuinfo | sed -e "s/.*: //" -e "s:\s\+:/:g")"
    92	cloud_id="unknown"
    93	if [ -x /usr/bin/cloud-id ]; then
    94	    /usr/bin/cloud-id > "$CLOUD" 2>/dev/null
    95	    if [ "$?" -eq "0" ]; then
    96	        # sanitize it a bit, just in case
    97	        cloud_id=$(cut -c -40 "${CLOUD}" | tr -c -d '[:alnum:]')
    98	        if [ -z "${cloud_id}" ]; then
    99	            cloud_id="unknown"
   100	        fi
   101	    fi
   102	fi
   103	
   104	# Piece together the user agent
   105	USER_AGENT="wget/$wget_ver $lsb $platform $cpu cloud_id/$cloud_id"
   106	
   107	# Loop over any configured URLs
   108	for u in $URLS; do
   109		# Ensure https:// protocol, for security reasons
   110		case $u in
   111			https://*)
   112				true
   113			;;
   114			https://motd.ubuntu.com)
   115				u="$u/$codename/$arch"
   116			;;
   117			*)
   118				continue
   119			;;
   120		esac
   121		# If we're forced, set the wait to much higher (1 minute)
   122		[ "$FORCED" = "1" ] && WAIT=60
   123		# Fetch and print the news motd
   124		result=0
   125		not_found_is_ok=0
   126		wget --timeout "$WAIT" -U "$USER_AGENT" -O- --content-on-error "$u" >"$NEWS" 2>"$ERR" || result=$?
   127		# from wget's manpage: 8   Server issued an error response.
   128		if [ $result -eq 8 ]; then
   129			if grep -q "ERROR 404" "$ERR"; then
   130				# The server's 404 document is the generic, non cloud-specific, motd-news
   131				# content present in the index.txt file
   132				not_found_is_ok=1
   133			fi
   134		fi
   135		if [ $result -eq 0 ] || [ $not_found_is_ok -eq 1 ]; then
   136			echo
   137			# At most, 10 lines of text, remove control characters, print at most 80 characters per line
   138			safe_print "$NEWS"
   139			# Try to update the cache
   140			safe_print "$NEWS" 2>/dev/null >$CACHE || true
   141		else
   142			: > "$CACHE"
   143	 	fi
   144	done
   145	rm -f "$NEWS" "$ERR" "$CLOUD"
### /usr/lib/update-notifier/update-motd-updates-available
    15	stamp="/var/lib/update-notifier/updates-available"
    16	
    17	# get list dir
    18	StateDir="/var/lib/apt/"
    19	ListDir="lists/"
    20	eval "$(apt-config shell StateDir Dir::State)"
    21	eval "$(apt-config shell ListDir Dir::State::Lists)"
    22	
    23	# get dpkg status file
    24	DpkgStatus="/var/lib/dpkg/status"
    25	eval "$(apt-config shell DpkgStatus Dir::State::status)"
    26	
    27	# get sources.list file
    28	EtcDir="etc/apt/"
    29	SourceList="sources.list"
    30	eval "$(apt-config shell EtcDir Dir::Etc)"
    31	eval "$(apt-config shell SourceList Dir::Etc::sourcelist)"
    32	
    33	# let the actual update be asynchronous to avoid stalling apt-get
    34	cleanup() { rm -f "$tmpfile"; }
    35	
    36	# check if we have a list file or sources.list that needs checking
    37	if [ -e "$stamp" ]; then
    38	    if [ "$(find "/$StateDir/$ListDir" "/$EtcDir/$SourceList" "/$DpkgStatus" -type f -newer "$stamp" -print -quit)" ]; then
    39	        NEED_UPDATE_CHECK=yes
    40	    fi
    41	else
    42	    if [ "$(find "/$StateDir/$ListDir" "/$EtcDir/$SourceList" -type f -print -quit)" ]; then
    43	        NEED_UPDATE_CHECK=yes
    44	    fi
    45	fi
    46	
    47	tmpfile=""
    48	trap cleanup EXIT
    49	tmpfile=$(mktemp -p $(dirname "$stamp"))
    50	
    51	# should we hide esm-related information in the output
    52	no_esm_file="/var/lib/update-notifier/hide-esm-in-motd"
    53	if [ -e "$no_esm_file" ]; then
    54	    NO_ESM_MESSAGES="--no-esm-messages"
    55	fi
    56	
    57	# output something for update-motd
    58	if [ "$NEED_UPDATE_CHECK" = "yes" ]; then
    59	    {
    60	
    61	        echo ""
    62	        /usr/lib/update-notifier/apt-check --human-readable "$NO_ESM_MESSAGES"
    63	        echo ""
    64	    } > "$tmpfile"
    65	    mv "$tmpfile" "$stamp"
    66	    chmod +r "$stamp"
### /usr/lib/ubuntu-release-upgrader/release-upgrade-motd
    23	stamp=/var/lib/ubuntu-release-upgrader/release-upgrade-available
    24	if [ -f "$stamp" ]; then
    25		# Stamp exists, see if it's expired
    26		now=$(date +%s)
    27	        lastrun=$(stat -c %Y "$stamp") 2>/dev/null || lastrun=0
    28	        expiration=$(expr $lastrun + 86400)
    29	        if [ $now -ge $expiration ]; then
    30			# Older than 1 day old, so update in the background
    31			/usr/lib/ubuntu-release-upgrader/check-new-release -q > "$stamp" &
    32		elif [ -s "$stamp" ]; then
