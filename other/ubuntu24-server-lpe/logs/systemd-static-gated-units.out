     5	DefaultDependencies=no
     6	ConditionKernelCommandLine=!plymouth.enable=0
     7	ConditionKernelCommandLine=!nosplash
     8	ConditionKernelCommandLine=splash
     9	ConditionVirtualization=!container
    10	
