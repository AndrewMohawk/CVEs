      readonly b UpdateTriggered = false;
      readonly b UpgradePrepared = false;
      readonly b UpgradeTriggered = false;
      @org.qtproject.QtDBus.QtTypeName("QVariantMap")
      readonly a{sv} PreparedUpgrade;
      readonly s TriggerAction = 'unset';
  };
