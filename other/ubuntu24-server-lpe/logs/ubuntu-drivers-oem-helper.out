--- /etc/apt/apt.conf.d/99update-notifier
     1	DPkg::Post-Invoke {"if [ -d /var/lib/update-notifier ]; then touch /var/lib/update-notifier/dpkg-run-stamp; fi; /usr/lib/update-notifier/update-motd-updates-available 2>/dev/null || true";};
     2	APT::Update::Post-Invoke-Success {"/usr/lib/update-notifier/update-motd-updates-available 2>/dev/null || true";};
--- /etc/update-motd.d/90-updates-available
     1	#!/bin/sh
     2	
     3	stamp="/var/lib/update-notifier/updates-available"
     4	
     5	[ ! -r "$stamp" ] || cat "$stamp"
     6	
     7	find $stamp -newermt 'now-7 days' 2> /dev/null | grep -q -m 1 '.' || /usr/share/update-notifier/notify-updates-outdated
--- /etc/update-motd.d/91-release-upgrade
     1	#!/bin/sh
     2	
     3	# if the current release is under development there won't be a new one
     4	[ -r /etc/lsb-release ] && . /etc/lsb-release
     5	if [ -z "$DISTRIB_DESCRIPTION" ] && command -v lsb_release > /dev/null; then
     6	    DISTRIB_DESCRIPTION=$(lsb_release -s -d)
     7	fi
     8	
     9	if [ "$(echo "$DISTRIB_DESCRIPTION" | cut -d' ' -f4)" = "(development" ]; then
    10	    exit 0
    11	fi
    12	
    13	# if it is non-root user, skip
    14	if [ $(id -u) -ne 0 ]; then
    15	    exit 0
    16	fi
    17	
    18	if [ -x /usr/lib/ubuntu-release-upgrader/release-upgrade-motd ]; then
    19	    exec /usr/lib/ubuntu-release-upgrader/release-upgrade-motd
    20	fi
--- /etc/update-motd.d/95-hwe-eol
     1	#!/bin/sh
     2	
     3	# this stamp is created and updated by /usr/lib/update-notifier/update-motd-hwe-eol
     4	stamp="/var/lib/update-notifier/hwe-eol"
     5	
     6	# do not try to refresh this more than once per day
     7	[ -z "$(find "$stamp" -newermt 'now-1 days' 2> /dev/null)" ] && exit 0
     8	
     9	if [ -x /usr/lib/update-notifier/update-motd-hwe-eol ]; then
    10	    exec /usr/lib/update-notifier/update-motd-hwe-eol
    11	fi
--- /etc/update-motd.d/98-fsck-at-reboot
     1	#!/bin/sh
     2	
     3	if [ -x /usr/lib/update-notifier/update-motd-fsck-at-reboot ]; then
     4	    exec /usr/lib/update-notifier/update-motd-fsck-at-reboot
     5	fi
--- /etc/update-motd.d/98-reboot-required
     1	#!/bin/sh
     2	
     3	if [ -x /usr/lib/update-notifier/update-motd-reboot-required ]; then
     4	    exec /usr/lib/update-notifier/update-motd-reboot-required
     5	fi
