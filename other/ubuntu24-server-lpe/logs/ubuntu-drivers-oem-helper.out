== helper source ==
     1	#!/usr/bin/python3
     2	
     3	import fnmatch
     4	import os
     5	import sys
     6	
     7	import apt
     8	import UbuntuDrivers.detect
     9	from gi.repository import GLib
    10	
    11	import apt_pkg
    12	
    13	STAMP_FILE = os.path.join(
    14	    GLib.get_user_runtime_dir(), "ubuntu-drivers-oem.package-list"
    15	)
    16	
    17	
    18	def any_oem_metapackages_installed(cache):
    19	    installed_oem_packages = (
    20	        pkg
    21	        for pkg in cache.packages
    22	        if fnmatch.fnmatch(pkg.name, "oem-*-meta") and pkg.current_ver
    23	    )
    24	
    25	    # Empty if there are no installed OEM packages
    26	    return any((True for _ in installed_oem_packages))
    27	
    28	
    29	def write_oem_metapackage_list(cache, filename):
    30	    packages = UbuntuDrivers.detect.system_device_specific_metapackages(
    31	        apt_cache=cache
    32	    )
    33	
    34	    if not packages:
    35	        return
    36	
    37	    with open(STAMP_FILE, "w") as f:
    38	        f.write("\n".join(packages))
    39	
    40	
    41	if __name__ == "__main__":
    42	    if os.path.exists(STAMP_FILE):
    43	        sys.exit(0)
    44	
    45	    try:
    46	        cache = apt_pkg.Cache()
    47	    except apt_pkg.Error:  # broken things in sources.list, or corrupted list files
    48	        print(
    49	            "ERROR: Can't look into APT cache. Check your sources.list file(s), run `apt update` and try again",
    50	            file=sys.stderr,
    51	        )
    52	        sys.exit(0)
    53	
    54	    if any_oem_metapackages_installed(cache):
    55	        sys.exit(0)
    56	
    57	    write_oem_metapackage_list(cache, STAMP_FILE)

