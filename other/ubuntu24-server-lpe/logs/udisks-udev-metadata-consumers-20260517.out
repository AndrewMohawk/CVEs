## maintenance/generator units under this slice
### /usr/lib/systemd/system/e2scrub_all.service
     1	[Unit]
     2	Description=Online ext4 Metadata Check for All Filesystems
     3	ConditionACPower=true
     4	ConditionCapability=CAP_SYS_ADMIN
     5	ConditionCapability=CAP_SYS_RAWIO
     6	Documentation=man:e2scrub_all(8)
     7	
     8	[Service]
     9	Type=oneshot
    10	Environment=SERVICE_MODE=1
    11	ExecStart=/sbin/e2scrub_all
    12	SyslogIdentifier=e2scrub_all
### /usr/lib/systemd/system/e2scrub_all.timer
     1	[Unit]
     2	Description=Periodic ext4 Online Metadata Check for All Filesystems
     3	
     4	[Timer]
     5	# Run on Sunday at 3:10am, to avoid running afoul of DST changes
     6	OnCalendar=Sun *-*-* 03:10:00
     7	RandomizedDelaySec=60
     8	Persistent=true
     9	
    10	[Install]
    11	WantedBy=timers.target
### /usr/lib/systemd/system/fstrim.service
     1	[Unit]
     2	Description=Discard unused blocks on filesystems from /etc/fstab
     3	Documentation=man:fstrim(8)
     4	ConditionVirtualization=!container
     5	
     6	[Service]
     7	Type=oneshot
     8	ExecStart=/sbin/fstrim --listed-in /etc/fstab:/proc/self/mountinfo --verbose --quiet-unsupported
     9	PrivateDevices=no
    10	PrivateNetwork=yes
    11	PrivateUsers=no
    12	ProtectKernelTunables=yes
    13	ProtectKernelModules=yes
    14	ProtectControlGroups=yes
    15	MemoryDenyWriteExecute=yes
    16	SystemCallFilter=@default @file-system @basic-io @system-service
### /usr/lib/systemd/system/fstrim.timer
     1	[Unit]
     2	Description=Discard unused filesystem blocks once a week
     3	Documentation=man:fstrim
     4	ConditionVirtualization=!container
     5	ConditionPathExists=!/etc/initrd-release
     6	
     7	[Timer]
     8	OnCalendar=weekly
     9	AccuracySec=1h
    10	Persistent=true
    11	RandomizedDelaySec=100min
    12	
    13	[Install]
    14	WantedBy=timers.target
### /usr/lib/systemd/system/xfs_scrub_all.service
     1	# SPDX-License-Identifier: GPL-2.0-or-later
     2	#
