     9	Documentation=man:xfs_scrub_all(8)
    10	After=paths.target multi-user.target network.target network-online.target systemd-networkd.service NetworkManager.service connman.service
    11	
    12	[Service]
    13	Type=oneshot
    14	Environment=SERVICE_MODE=1
    15	ExecStart=/usr/sbin/xfs_scrub_all
    16	SyslogIdentifier=xfs_scrub_all
### /usr/lib/systemd/system/xfs_scrub_all.timer
     1	# SPDX-License-Identifier: GPL-2.0-or-later
     2	#
     3	# Copyright (C) 2018-2024 Oracle.  All Rights Reserved.
     4	# Author: Darrick J. Wong <djwong@kernel.org>
     5	
     6	[Unit]
     7	Description=Periodic XFS Online Metadata Check for All Filesystems
     8	
     9	[Timer]
    10	# Run on Sunday at 3:10am, to avoid running afoul of DST changes
    11	OnCalendar=Sun *-*-* 03:10:00
    12	RandomizedDelaySec=60
    13	Persistent=true
    14	
    15	[Install]
    16	WantedBy=timers.target
### /usr/lib/systemd/system/xfs_scrub@.service
     1	# SPDX-License-Identifier: GPL-2.0-or-later
     2	#
     3	# Copyright (C) 2018-2024 Oracle.  All Rights Reserved.
     4	# Author: Darrick J. Wong <djwong@kernel.org>
     5	
     6	[Unit]
     7	Description=Online XFS Metadata Check for %f
     8	OnFailure=xfs_scrub_fail@%i.service
     9	Documentation=man:xfs_scrub(8)
    10	
    11	[Service]
    12	Type=oneshot
