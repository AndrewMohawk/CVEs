### unminimize
/usr/bin/unminimize
--- /var/lib/dpkg/info/unminimize.postinst
     1	#!/bin/sh
     2	
     3	set -e
     4	
     5	case "$1" in
     6	    configure)
     7	        # ensure the file exists and its content to ensure we're removing the right file
     8	        if [ -f "/usr/local/sbin/unminimize" ] &&
     9	          grep -qi "This system has been minimized by removing packages" "/usr/local/sbin/unminimize"; then
    10	            rm -f /usr/local/sbin/unminimize
    11	        fi
    12	    ;;
    13	
    14	    upgrade|abort-upgrade|abort-remove|abort-deconfigure)
    15	    ;;
    16	
    17	    *)
    18	        echo "postinst called with unknown argument \`$1'" >&2
    19	        exit 1
    20	    ;;
    21	esac
    22	
    23	
    24	
    25	exit 0
