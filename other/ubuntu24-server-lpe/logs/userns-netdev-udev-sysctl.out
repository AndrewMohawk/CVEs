## default sysctl config touching net device prefixes

## default udev net rules
    50	# use the /sys/subsystem/ path for this. Kernel "bus" and "class" names
    51	# should be treated as one namespace, like udev handles it. This is mostly
    52	# just an identification string for systemd, so whether the path actually is
    53	# accessible or not does not matter as long as it is unique and in the
    54	# filesystem namespace.
    55	
    56	SUBSYSTEM=="net", KERNEL!="lo", TAG+="systemd", ENV{SYSTEMD_ALIAS}+="/sys/subsystem/net/devices/$name"
    57	SUBSYSTEM=="bluetooth", TAG+="systemd", ENV{SYSTEMD_ALIAS}+="/sys/subsystem/bluetooth/devices/%k", \
    58	  ENV{SYSTEMD_WANTS}+="bluetooth.target", ENV{SYSTEMD_USER_WANTS}+="bluetooth.target"
    59	
    60	ENV{ID_SMARTCARD_READER}=="?*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="smartcard.target", ENV{SYSTEMD_USER_WANTS}+="smartcard.target"
    61	SUBSYSTEM=="sound", KERNEL=="controlC*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="sound.target", ENV{SYSTEMD_USER_WANTS}+="sound.target"
    62	
    63	SUBSYSTEM=="printer", TAG+="systemd", ENV{SYSTEMD_WANTS}+="printer.target", ENV{SYSTEMD_USER_WANTS}+="printer.target"
    64	SUBSYSTEM=="usb", KERNEL=="lp*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="printer.target", ENV{SYSTEMD_USER_WANTS}+="printer.target"
    65	SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:0701??:*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="printer.target", ENV{SYSTEMD_USER_WANTS}+="printer.target"
    66	
    67	SUBSYSTEM=="udc", TAG+="systemd", ENV{SYSTEMD_WANTS}+="usb-gadget.target"
    68	
    69	# Apply sysctl variables to network devices (and only to those) as they appear.
    70	ACTION=="add", SUBSYSTEM=="net", KERNEL!="lo", RUN+="/usr/lib/systemd/systemd-sysctl --prefix=/net/ipv4/conf/$name --prefix=/net/ipv4/neigh/$name --prefix=/net/ipv6/conf/$name --prefix=/net/ipv6/neigh/$name"
    71	
    72	# Pull in backlight save/restore for all backlight devices and
    73	# keyboard backlights
    74	SUBSYSTEM=="backlight", TAG+="systemd", IMPORT{builtin}="path_id", ENV{SYSTEMD_WANTS}+="systemd-backlight@backlight:$name.service"
    75	SUBSYSTEM=="leds", KERNEL=="*kbd_backlight*", TAG+="systemd", IMPORT{builtin}="path_id", ENV{SYSTEMD_WANTS}+="systemd-backlight@leds:$name.service"
    76	
     1	# run before 80-networking.rules to run before ifupdown
     2	SUBSYSTEM=="net", ACTION=="add", RUN+="/usr/lib/open-iscsi/net-interface-handler start"
     3	SUBSYSTEM=="net", ACTION=="remove", RUN+="/usr/lib/open-iscsi/net-interface-handler stop"
     1	# do not edit this file, it will be overwritten on update
     2	
     3	SUBSYSTEM!="net", GOTO="net_setup_link_end"
     4	
     5	IMPORT{builtin}="path_id"
     6	
     7	ACTION=="remove", GOTO="net_setup_link_end"
     8	
     9	IMPORT{builtin}="net_setup_link"
    10	
    11	NAME=="", ENV{ID_NET_NAME}!="", NAME="$env{ID_NET_NAME}"
    12	
    13	LABEL="net_setup_link_end"
     1	# do not edit this file, it will be overwritten on update
     2	
     3	ACTION=="remove", GOTO="net_dhcp_end"
     4	SUBSYSTEM!="net", GOTO="net_dhcp_end"
     5	
     6	# Network interfaces requiring DHCPOFFER messages to be broadcast
     7	# must set ID_NET_DHCP_BROADCAST to "1". This property will be
     8	# checked by the networkd DHCP4 client to set the DHCP option
     9	
    10	# s390 ccwgroup interfaces in layer3 mode need broadcast DHCPOFFER
    11	# using the link driver to detect this condition
    12	ENV{ID_NET_DRIVER}=="qeth_l3", ENV{ID_NET_DHCP_BROADCAST}="1"
    13	
    14	LABEL="net_dhcp_end"

